+static struct mi_emv_packet *mi_emv_pack(const struct MiEmvConfig *cfg, ktime_t deadline)
+{
+	const u32 *mv = cfg->mvInfo;
+	struct mi_emv_packet *packet;
+	u32 count, used, take, pos, i;
+	u32 *tx;
+
+	if (!cfg->mv_info_size || cfg->mv_info_size > MI_EMV_MAX_SIZE)
+		return ERR_PTR(-EINVAL);
+	/* An explicit disable or idle marker sends no DSI command on 406. */
+	if (!cfg->emv_enable_state || ((mv[0] & 0xffff) >= 40000 && !(mv[0] & 0xf0000)))
+		return NULL;
+	if (cfg->mv_info_size < 18 || mv[13] > cfg->mv_info_size - 18)
+		return ERR_PTR(-EINVAL);
+	count = mv[13];
+	/* Seven header words, at most one continuation for every 255 grid
+	 * words (including a boundary before the footer), and two footer words.
+	 */
+	used = 7 + count + (count + 6) / (MI_EMV_PACKAGE_WORDS - 1) + 2;
+	packet = kmalloc(struct_size(packet, data, used), GFP_KERNEL);
+	if (!packet)
+		return ERR_PTR(-ENOMEM);
+	refcount_set(&packet->refs, 1);
+	packet->deadline = deadline;
+	packet->serial = atomic64_inc_return_relaxed(&mi_emv_serial);
+	tx = packet->data;
+	tx[0] = 0x0854564e;
+	tx[1] = 0x4154454d;
+	tx[2] = (mv[3] << 16) | (mv[4] & 0xffff);
+	tx[3] = 0x10000801;
+	tx[4] = (mv[7] << 16) | (mv[8] & 0xffff);
+	tx[5] = (mv[9] << 16) | (mv[10] & 0xffff);
+	tx[6] = (mv[11] << 16) | (mv[12] & 0xffff);
+
+	for (i = 0, pos = 7; i < count; i += take) {
+		if (pos % MI_EMV_PACKAGE_WORDS == 0)
+			tx[pos++] = 0x0954564e;
+		take = min(count - i, MI_EMV_PACKAGE_WORDS - pos % MI_EMV_PACKAGE_WORDS);
+		memcpy(&tx[pos], &mv[14 + i], take * sizeof(*tx));
+		pos += take;
+	}
+	if (pos % MI_EMV_PACKAGE_WORDS == 0)
+		tx[pos++] = 0x0954564e;
+	tx[pos++] = (mv[14 + count] << 16) | (mv[15 + count] & 0xffff);
+	tx[pos++] = (mv[16 + count] << 16) | (mv[17 + count] & 0xffff);
+	packet->bytes = pos * sizeof(*tx);
+	return packet;
+}
 
