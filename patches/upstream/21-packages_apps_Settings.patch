+
+package com.android.settings.notification;
+
+import android.content.Context;
+import android.media.audiofx.AudioEffect;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+import java.util.UUID;
+
+/** Preference for the Dolby DAP effect managed by AudioService. */
+public class DolbyAtmosPreferenceController extends TogglePreferenceController {
+    // Keep this key in sync with DolbyAtmosController in AudioService.
+    private static final String ENABLED_SETTING = "dolby_atmos_enabled";
+    private static final UUID DAP_UUID =
+            UUID.fromString("9d4921da-8225-4f29-aefa-39537a04bcaa");
+
+    public DolbyAtmosPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        final AudioEffect.Descriptor[] effects = AudioEffect.queryEffects();
+        if (effects != null) {
+            for (AudioEffect.Descriptor effect : effects) {
+                if (DAP_UUID.equals(effect.uuid)) {
+                    return AVAILABLE;
+                }
+            }
+        }
+        return UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(), ENABLED_SETTING, 0) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean checked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(), ENABLED_SETTING,
+                checked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_sound;
+    }
+}
