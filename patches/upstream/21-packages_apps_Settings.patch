+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.sound;
+
+import android.content.Context;
+import android.os.Build;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Shows the sound effects page on Athens. */
+public final class AthensSoundEffectsPreferenceController extends BasePreferenceController {
+    public AthensSoundEffectsPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    public static boolean isAthensDevice() {
+        return "athens".equals(Build.DEVICE);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return isAthensDevice() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
diff --git a/src/com/android/settings/sound/AthensSoundEffectsSettings.java b/src/com/android/settings/sound/AthensSoundEffectsSettings.java
new file mode 100644
index 0000000000000000000000000000000000000000..f8429c08b08771c77ae4b83e91a6cabdf0d85629
--- /dev/null
+++ b/src/com/android/settings/sound/AthensSoundEffectsSettings.java
@@ -0,0 +1,290 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.sound;
+
+import android.app.settings.SettingsEnums;
+import android.content.ContentResolver;
+import android.os.Bundle;
+import android.provider.Settings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.dashboard.DashboardFragment;
+import com.android.settingslib.widget.MainSwitchPreference;
+import com.android.settingslib.widget.SliderPreference;
+
+import java.text.NumberFormat;
+import java.util.Arrays;
+import java.util.StringJoiner;
+
+/** Settings for the Athens audio effects managed by AudioService. */
+public final class AthensSoundEffectsSettings extends DashboardFragment {
+    private static final String TAG = "AthensSoundEffectsSettings";
+
+    // Keep these settings in sync with AudioService.
+    private static final String ENABLED_SETTING = "athens_audio_effect_enabled";
+    private static final String LEGACY_ENABLED_SETTING = "dolby_atmos_enabled";
+    private static final String SPEAKER_MODE_SETTING = "athens_audio_effect";
+    private static final String[] MODE_SETTINGS = {
+        SPEAKER_MODE_SETTING, "athens_audio_effect_wired", "athens_audio_effect_bluetooth"
+    };
+    private static final String PRESET_SETTING = "athens_audio_preset";
+    private static final String EQ_SETTING = "athens_audio_eq";
+    private static final String GAME_AUDIO_SETTING = "athens_bose_game_audio";
+
+    private static final String EQ_CUSTOM_SETTING = "athens_audio_eq_custom";
+    private static final String EQ_GENRE_SETTING = "athens_audio_eq_genre";
+    private static final int CLASSIC_MODE = 0;
+    private static final int LEGACY_MODE = 2;
+    private static final int CUSTOM_PRESET = 3;
+    private static final int CUSTOM_GENRE = 0;
+    private static final int MAX_GAIN = 24;
+    private static final int[] FREQUENCIES = {141, 234, 469, 844, 1300, 2200, 3700, 5800, 9000,
+            13800};
+
+    // Factory genre curves, expressed in quarter-dB units.
+    private static final int[][] FACTORY_GAINS = {
+        {16, 4, -8, -1, 0, -8, 0, -8, 2, 16},  // Rock
+        {0, 0, 0, -4, -4, -12, -2, 0, 0, 0},  // Jazz
+        {-8, -2, -20, -4, 0, 0, -2, -12, -2, 0},  // Pop
+        {0, 0, 0, 0, 2, 12, 4, 24, 8, 24},  // Classical
+        {12, 0, -12, -2, -2, -12, -2, 0, 0, 8},  // Hip-hop
+        {8, 8, -24, -8, 12, 4, 0, 4, 0, 8},  // Blues
+        {12, 4, -4, 0, -2, -12, -2, 0, 0, 0},  // Electronic
+        {8, 0, 0, -5, -4, -16, 0, 0, 0, 0},  // Metal
+    };
+
+    private final ListPreference[] mModes = new ListPreference[MODE_SETTINGS.length];
+    private final SliderPreference[] mSliders = new SliderPreference[FREQUENCIES.length];
+    private ContentResolver mResolver;
+    private NumberFormat mNumberFormat;
+    private MainSwitchPreference mEnabled;
+    private SwitchPreferenceCompat mGameAudio;
+    private ListPreference mPreset;
+    private PreferenceCategory mEqualizer;
+    private ListPreference mGenre;
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        if (!AthensSoundEffectsPreferenceController.isAthensDevice()) {
+            finishFragment();
+            return;
+        }
+        super.onCreatePreferences(savedInstanceState, rootKey);
+        mResolver = requireContext().getContentResolver();
+        mNumberFormat = NumberFormat.getNumberInstance(
+                getResources().getConfiguration().getLocales().get(0));
+        mNumberFormat.setMaximumFractionDigits(2);
+
+        mEnabled = findPreference(ENABLED_SETTING);
+        mGameAudio = findPreference(GAME_AUDIO_SETTING);
+        mPreset = findPreference(PRESET_SETTING);
+        mEqualizer = findPreference("athens_audio_equalizer_group");
+        mGenre = findPreference(EQ_GENRE_SETTING);
+        final Preference reset = findPreference("athens_audio_equalizer_reset");
+
+        mEnabled.setOnPreferenceChangeListener((preference, value) ->
+                Settings.Secure.putInt(mResolver, ENABLED_SETTING, (boolean) value ? 1 : 0));
+        mGameAudio.setOnPreferenceChangeListener((preference, value) ->
+                Settings.Secure.putInt(mResolver, GAME_AUDIO_SETTING, (boolean) value ? 1 : 0));
+        for (int index = 0; index < MODE_SETTINGS.length; index++) {
+            final String key = MODE_SETTINGS[index];
+            final ListPreference mode = findPreference(key);
+            mode.setOnPreferenceChangeListener((preference, value) -> {
+                final String selection = (String) value;
+                if (!Settings.Secure.putInt(mResolver, key, Integer.parseInt(selection))) {
+                    return false;
+                }
+                if (SPEAKER_MODE_SETTING.equals(key)) {
+                    updateSpeakerTuningVisibility(selection, mPreset.getValue());
+                }
+                return true;
+            });
+            mModes[index] = mode;
+        }
+        mPreset.setOnPreferenceChangeListener((preference, value) -> {
+            final int preset = Integer.parseInt((String) value);
+            if (!Settings.Secure.putInt(mResolver, PRESET_SETTING, preset)) {
+                return false;
+            }
+            updateSpeakerTuningVisibility(mModes[0].getValue(), (String) value);
+            return true;
+        });
+        mGenre.setOnPreferenceChangeListener((preference, value) ->
+                selectGenre(Integer.parseInt((String) value)));
+        reset.setOnPreferenceClickListener(preference ->
+                saveEqualizer(CUSTOM_GENRE, new int[FREQUENCIES.length]));
+        for (int band = 0; band < FREQUENCIES.length; band++) {
+            addSlider(band);
+        }
+        refreshSettings();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        if (mEnabled != null) {
+            refreshSettings();
+        }
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.athens_sound_effects_settings;
+    }
+
+    @Override
+    protected String getLogTag() {
+        return TAG;
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SOUND;
+    }
+
+    private void addSlider(int band) {
+        final SliderPreference slider = new SliderPreference(getPreferenceManager().getContext());
+        final int frequency = FREQUENCIES[band];
+        final boolean isKhz = frequency >= 1_000;
+        slider.setKey("athens_audio_eq_band_" + band);
+        slider.setTitle(getString(isKhz ? R.string.athens_audio_effects_khz
+                        : R.string.athens_audio_effects_hz,
+                mNumberFormat.format(isKhz ? frequency / 1_000.0 : frequency)));
+        slider.setOrder(band + 1);
+        slider.setPersistent(false);
+        slider.setMin(-MAX_GAIN);
+        slider.setMax(MAX_GAIN);
+        slider.setSliderIncrement(1);
+        slider.setLabelFormater(value -> formatGain(Math.round(value)));
+        slider.setOnPreferenceChangeListener((preference, value) -> {
+            final int[] gains = readGains(EQ_SETTING);
+            int gain = (int) value;
+            // Snap manual edits to half-dB steps. A loaded factory curve can use quarter dB.
+            if (gain % 2 != 0) {
+                gain += gain > gains[band] ? 1 : -1;
+            }
+            gains[band] = gain;
+            if (!saveEqualizer(CUSTOM_GENRE, gains)) {
+                return false;
+            }
+            // Reject the raw slider value if it differs from the already applied snapped value.
+            return gain == (int) value;
+        });
+        mSliders[band] = slider;
+        mEqualizer.addPreference(slider);
+    }
+
+    private void refreshSettings() {
+        final int legacyEnabled = Settings.Secure.getInt(mResolver, LEGACY_ENABLED_SETTING, 1);
+        mEnabled.setChecked(Settings.Secure.getInt(mResolver, ENABLED_SETTING, legacyEnabled)
+                != 0);
+        mGameAudio.setChecked(Settings.Secure.getInt(mResolver, GAME_AUDIO_SETTING, 0) != 0);
+        final int defaultMode = Settings.Secure.getInt(mResolver, LEGACY_ENABLED_SETTING, 0) == 1
+                ? LEGACY_MODE : CLASSIC_MODE;
+        for (ListPreference mode : mModes) {
+            mode.setValue(readSelection(mode, defaultMode));
+        }
+        mPreset.setValue(readSelection(mPreset, 0));
+        updateSpeakerTuningVisibility(mModes[0].getValue(), mPreset.getValue());
+        refreshEqualizer();
+    }
+
+    private void updateSpeakerTuningVisibility(String mode, String preset) {
+        final boolean bose = !Integer.toString(LEGACY_MODE).equals(mode);
+        mPreset.setVisible(bose);
+        mEqualizer.setVisible(bose && mPreset.findIndexOfValue(preset) == CUSTOM_PRESET);
+    }
+
+    private String readSelection(ListPreference preference, int fallback) {
+        final String value = Integer.toString(
+                Settings.Secure.getInt(mResolver, preference.getKey(), fallback));
+        return preference.findIndexOfValue(value) >= 0 ? value : "0";
+    }
+
+    private void refreshEqualizer() {
+        final int[] gains = readGains(EQ_SETTING);
+        mGenre.setValue(Integer.toString(getAppliedGenre(gains)));
+        for (int band = 0; band < gains.length; band++) {
+            mSliders[band].setValue(gains[band]);
+            mSliders[band].setSummary(formatGain(gains[band]));
+        }
+    }
+
+    private int getAppliedGenre(int[] gains) {
+        final int genre = Settings.Secure.getInt(mResolver, EQ_GENRE_SETTING, CUSTOM_GENRE);
+        if (genre > 0 && genre <= FACTORY_GAINS.length
+                && Arrays.equals(FACTORY_GAINS[genre - 1], gains)) {
+            return genre;
+        }
+        return CUSTOM_GENRE;
+    }
+
+    private boolean selectGenre(int genre) {
+        final int[] current = readGains(EQ_SETTING);
+        if (genre != CUSTOM_GENRE && getAppliedGenre(current) == CUSTOM_GENRE
+                && !Settings.Secure.putString(mResolver, EQ_CUSTOM_SETTING, encodeGains(current))) {
+            return false;
+        }
+        final int[] gains = genre == CUSTOM_GENRE
+                ? readGains(EQ_CUSTOM_SETTING) : FACTORY_GAINS[genre - 1];
+        return saveEqualizer(genre, gains);
+    }
+
+    private int[] readGains(String key) {
+        final int[] gains = new int[FREQUENCIES.length];
+        final String setting = Settings.Secure.getString(mResolver, key);
+        if (setting == null) {
+            return gains;
+        }
+        final String[] values = setting.split(",", -1);
+        if (values.length != gains.length) {
+            return gains;
+        }
+        try {
+            for (int band = 0; band < gains.length; band++) {
+                final int gain = Integer.parseInt(values[band]);
+                if (gain < -MAX_GAIN || gain > MAX_GAIN) {
+                    return new int[gains.length];
+                }
+                gains[band] = gain;
+            }
+        } catch (NumberFormatException ignored) {
+            return new int[gains.length];
+        }
+        return gains;
+    }
+
+    private boolean saveEqualizer(int genre, int[] gains) {
+        final String value = encodeGains(gains);
+        if (!Settings.Secure.putString(mResolver, EQ_SETTING, value)) {
+            return false;
+        }
+        if (genre == CUSTOM_GENRE) {
+            Settings.Secure.putString(mResolver, EQ_CUSTOM_SETTING, value);
+        }
+        Settings.Secure.putInt(mResolver, EQ_GENRE_SETTING, genre);
+        refreshEqualizer();
+        return true;
+    }
+
+    private static String encodeGains(int[] gains) {
+        final StringJoiner value = new StringJoiner(",");
+        for (int gain : gains) {
+            value.add(Integer.toString(gain));
+        }
+        return value.toString();
+    }
+
+    private String formatGain(int gain) {
+        return getString(R.string.athens_audio_effects_db,
+                (gain > 0 ? "+" : "") + mNumberFormat.format(gain / 4.0));
+    }
+}
