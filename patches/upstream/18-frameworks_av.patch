+                                    ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT) {
+                        bestWidth = width;
+                        bestHeight = height;
+                        break;
+                    }
+                }
+                if (bestWidth == width && bestHeight == height) {
+                    break;
+                }
+            }
+        }
+    }
