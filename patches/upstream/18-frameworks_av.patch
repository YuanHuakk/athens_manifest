+void AudioFlinger::onAthensBoseGameGain(uid_t uid, const AudioStreamOut& output, float gain,
+        bool changed) {
+    const int32_t activeUid = mAthensBoseGameUid.load();
+    if (activeUid < 0 || uid != static_cast<uid_t>(activeUid) || !std::isfinite(gain)) {
+        return;
+    }
+    const sp<DeviceHalInterface> device = output.hwDev();
+    if (device == nullptr) {
+        return;
+    }
+
+    uint64_t generation;
+    {
+        std::lock_guard lock(mAthensBoseGameMutex);
+        if (mAthensBoseGameUid.load() != activeUid) {
+            return;
+        }
+        auto [it, firstGain] = mAthensBoseGameGains.try_emplace(device);
+        auto& update = it->second;
+        if (!firstGain && (!changed || update.gain == gain)) {
+            if (!update.retryAfter || std::chrono::steady_clock::now() < *update.retryAfter) {
+                return;
+            }
+            gain = update.gain;
+        }
+        update.gain = gain;
+        update.retryAfter.reset();
+        if (update.queued) {
+            return;
+        }
+        update.queued = true;
+        generation = mAthensBoseGameGeneration;
+    }
+
+    // The HAL transaction can block. Keep only the latest pending gain per output module.
+    getAsyncCallbackThread().add("AthensBoseGameGain",
+            [weak = wp<AudioFlinger>::fromExisting(this), device, generation] {
+                if (const auto flinger = weak.promote()) {
+                    flinger->sendAthensBoseGameGain(device, generation);
+                }
+            });
+}
+
+void AudioFlinger::sendAthensBoseGameGain(const sp<DeviceHalInterface>& device,
+        uint64_t generation) {
+    // Order the gain write against the stock enable/disable command sent under the same lock.
+    audio_utils::lock_guard hardwareLock(hardwareMutex());
+    float gain;
+    {
+        std::lock_guard lock(mAthensBoseGameMutex);
+        if (generation != mAthensBoseGameGeneration) {
+            return;
+        }
+        const auto update = mAthensBoseGameGains.find(device);
+        if (update == mAthensBoseGameGains.end()) {
+            return;
+        }
+        gain = update->second.gain;
+        update->second.queued = false;
+    }
+    const status_t result = device->setParameters(
+            String8::format("misound_game_effect_volume=%f", gain));
+    ALOGV("Athens Bose game track gain: %f, status: %d", gain, result);
+    if (result != NO_ERROR) {
+        std::lock_guard lock(mAthensBoseGameMutex);
+        const auto update = mAthensBoseGameGains.find(device);
+        if (update != mAthensBoseGameGains.end() && !update->second.queued) {
+            update->second.retryAfter = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+        }
+    }
+}
+
+void AudioFlinger::resetAthensBoseGameGain() {
+    std::lock_guard lock(mAthensBoseGameMutex);
+    mAthensBoseGameUid.store(-1);
+    ++mAthensBoseGameGeneration;
+    mAthensBoseGameGains.clear();
+}
