+    // Xiaomi's system-only reprocessing camera exposes additional RAW/JPEG
+    // outputs in vendor maps. Prefer an exact vendor match over rounding down,
+    // which would allocate an undersized JPEG buffer for high-resolution shots.
+    bool isJpeg = format == HAL_PIXEL_FORMAT_BLOB &&
+            (dataSpace == HAL_DATASPACE_V0_JFIF || dataSpace == HAL_DATASPACE_JFIF);
+    if ((bestWidth != width || bestHeight != height) && !maxResolution &&
+            (format == HAL_PIXEL_FORMAT_RAW16 || isJpeg)) {
+        auto capabilities = info.find(ANDROID_REQUEST_AVAILABLE_CAPABILITIES);
+        bool isSystemCamera = false;
+        for (size_t i = 0; i < capabilities.count; ++i) {
+            if (capabilities.data.u8[i] ==
+                    ANDROID_REQUEST_AVAILABLE_CAPABILITIES_SYSTEM_CAMERA) {
+                isSystemCamera = true;
+                break;
+            }
+        }
+
+        auto cache = VendorTagDescriptorCache::getGlobalVendorTagCache();
+        sp<VendorTagDescriptor> vendorTags;
+        if (isSystemCamera && cache != nullptr) {
+            cache->getVendorTagDescriptor(info.getVendorId(), &vendorTags);
+        }
+        if (vendorTags != nullptr) {
+            for (const char* name : {"xiaomi.scaler.availableStreamConfigurations",
+                    "xiaomi.scaler.availableSuperResolutionStreamConfigurations"}) {
+                uint32_t tag;
+                if (CameraMetadata::getTagFromName(name, vendorTags.get(), &tag) != OK) {
+                    continue;
+                }
+                auto configs = info.find(tag);
+                if (configs.type != TYPE_INT32 || configs.count % 4 != 0) {
+                    continue;
+                }
+                for (size_t i = 0; i < configs.count; i += 4) {
+                    if (configs.data.i32[i] == format && configs.data.i32[i + 1] == width &&
