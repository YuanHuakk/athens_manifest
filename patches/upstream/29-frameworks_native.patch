+namespace vulkan::athens {
+namespace {
+
+constexpr uint32_t kOpenChannel = 31605;
+constexpr uint32_t kPublishFrame = 31606;
+constexpr int kWidth = 60;
+constexpr int kHeight = 27;
+
+} // namespace
+
+using android::GraphicBuffer;
+using android::IBinder;
+using android::ISurfaceComposer;
+using android::Parcel;
+using android::Surface;
+using android::base::unique_fd;
+using android::sp;
+using android::status_t;
+
+AthensMotionVectorChannel::AthensMotionVectorChannel(sp<IBinder> composer, sp<Surface> game,
+                                                     sp<IBinder> gameHandle, sp<Surface> vectors,
+                                                     int64_t generation, int32_t gameLayerId,
+                                                     bool supportsBufferIdentity)
+      : mComposer(std::move(composer)),
+        mGame(std::move(game)),
+        mGameHandle(std::move(gameHandle)),
+        mVectors(std::move(vectors)),
+        mGeneration(generation),
+        mGameLayerId(gameLayerId),
+        mSupportsBufferIdentity(supportsBufferIdentity) {}
+
+AthensMotionVectorChannel::~AthensMotionVectorChannel() {
+    if (mVectors) native_window_api_disconnect(mVectors.get(), NATIVE_WINDOW_API_EGL);
+}
+
+std::optional<AthensMotionVectorChannel> AthensMotionVectorChannel::open(VkSwapchainKHR swapchain) {
+    auto game = vulkan::driver::FindActiveAthensPlatformSurface(swapchain);
+    if (!game) return std::nullopt;
+    auto gameHandle = game->getSurfaceControlHandle();
+    if (!gameHandle) return std::nullopt;
+
+    auto composer = android::defaultServiceManager()->checkService(android::String16(u"SurfaceFlinger"));
+    if (!composer) return std::nullopt;
+    Parcel request, reply;
+    if (request.writeInterfaceToken(ISurfaceComposer::descriptor) != android::OK ||
+        request.writeStrongBinder(gameHandle) != android::OK ||
+        composer->transact(kOpenChannel, request, &reply) != android::OK ||
+        reply.readExceptionCode() != 0) {
+        return std::nullopt;
+    }
+
+    int32_t status, layerId;
+    int64_t generation;
+    sp<IBinder> producerBinder;
+    if (reply.readInt32(&status) != android::OK || status != android::OK ||
+        reply.readInt64(&generation) != android::OK || generation <= 0 ||
+        reply.readInt32(&layerId) != android::OK || layerId <= 0 ||
+        reply.readStrongBinder(&producerBinder) != android::OK || !producerBinder) {
+        return std::nullopt;
+    }
+    auto producer = android::interface_cast<android::IGraphicBufferProducer>(producerBinder);
+    if (!producer) return std::nullopt;
+    auto vectors = sp<Surface>::make(producer, /*controlledByApp=*/false);
+    if (native_window_api_connect(vectors.get(), NATIVE_WINDOW_API_EGL) != android::OK ||
+        native_window_set_buffers_dimensions(vectors.get(), kWidth, kHeight) != android::OK ||
+        native_window_set_buffers_format(vectors.get(), HAL_PIXEL_FORMAT_RGBA_1010102) != android::OK ||
+        native_window_set_usage(vectors.get(), GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_SW_READ_OFTEN) !=
+                android::OK) {
+        native_window_api_disconnect(vectors.get(), NATIVE_WINDOW_API_EGL);
+        return std::nullopt;
+    }
+    int32_t version = 1;
+    if (reply.dataAvail() >= sizeof(version)) version = reply.readInt32();
+    return AthensMotionVectorChannel(std::move(composer), std::move(game), std::move(gameHandle),
+                                     std::move(vectors), generation, layerId, version >= 2);
+}
+
+AuthorizedPresentTarget AthensMotionVectorChannel::presentTarget() const {
+    return AuthorizedPresentTarget(mGame, mGameHandle, mGameLayerId, mGeneration);
+}
+
+bool AthensMotionVectorChannel::isRevoked() const {
+    // Surface caches window queries. Ask the producer so a revoked session returns its error.
+    int width;
+    const status_t status =
+            mVectors->getIGraphicBufferProducer()->query(NATIVE_WINDOW_WIDTH, &width);
+    return status == android::PERMISSION_DENIED || status == android::NO_INIT ||
+            status == android::DEAD_OBJECT;
+}
+
+std::optional<AthensMotionVectorChannel::Slot> AthensMotionVectorChannel::dequeue() {
+    ANativeWindowBuffer* buffer = nullptr;
+    int fd = -1;
+    auto* window = static_cast<ANativeWindow*>(mVectors.get());
+    if (window->dequeueBuffer(window, &buffer, &fd) != android::OK || buffer == nullptr) {
+        unique_fd unused(fd);
+        return std::nullopt;
+    }
+    auto graphicBuffer = GraphicBuffer::from(buffer);
+    if (!graphicBuffer || graphicBuffer->getWidth() != kWidth || graphicBuffer->getHeight() != kHeight ||
+        graphicBuffer->getPixelFormat() != HAL_PIXEL_FORMAT_RGBA_1010102) {
+        window->cancelBuffer(window, buffer, fd);
+        return std::nullopt;
+    }
+    return Slot{std::move(graphicBuffer), unique_fd(fd)};
+}
+
+status_t AthensMotionVectorChannel::cancel(Slot& slot, unique_fd gpuCompletion) {
+    if (!slot.buffer) return android::BAD_VALUE;
+    auto* window = static_cast<ANativeWindow*>(mVectors.get());
+    unique_fd fence = gpuCompletion.ok() ? std::move(gpuCompletion) : std::move(slot.previousRead);
+    const status_t status = window->cancelBuffer(window, slot.buffer->getNativeBuffer(),
+                                                 fence.release());
+    if (status == android::OK) slot.buffer.clear();
+    return status;
+}
+
+status_t AthensMotionVectorChannel::publish(Slot& slot,
+                                           const AthensVulkanFrameWitness::Pair& pair,
+                                           const PresentMetadata& present,
+                                           MotionVectorLayout layout) {
+    constexpr auto kMaxFrameNumber = uint64_t{std::numeric_limits<int64_t>::max()};
+    const auto gameFrameNumber = pair.nativeFrameNumber;
+    if (!slot.buffer || slot.buffer->getId() != pair.vector.bufferId ||
+        present.generation != mGeneration || present.layerId != mGameLayerId ||
+        present.layerHandle != mGameHandle || !present.acquireFence.ok() ||
+        present.swapchain != pair.color.swapchain || present.image != pair.color.image ||
+        present.imageIndex != pair.color.imageIndex || gameFrameNumber == 0 ||
+        gameFrameNumber > kMaxFrameNumber || present.nextFrameNumber != gameFrameNumber + 1) {
+        return android::BAD_VALUE;
+    }
+    unique_fd fd(fcntl(present.acquireFence.get(), F_DUPFD_CLOEXEC, 0));
+    if (!fd.ok()) return android::NO_MEMORY;
+    const auto gpuCompletion = sp<android::Fence>::make(fd.release());
+    android::SurfaceQueueBufferOutput output{};
+    const status_t queued = mVectors->queueBuffer(slot.buffer, gpuCompletion, &output);
+    if (queued != android::OK) return queued;
+    slot.buffer.clear();
+    slot.previousRead.reset();
+    if (output.nextFrameNumber <= 1 || output.nextFrameNumber - 1 > kMaxFrameNumber) {
+        return android::BAD_VALUE;
+    }
+
+    Parcel request, reply;
+    if (request.writeInterfaceToken(ISurfaceComposer::descriptor) != android::OK ||
+        request.writeInt64(mGeneration) != android::OK ||
+        request.writeStrongBinder(mGameHandle) != android::OK ||
+        request.writeInt64(static_cast<int64_t>(gameFrameNumber)) != android::OK ||
+        request.writeInt64(static_cast<int64_t>(output.nextFrameNumber - 1)) != android::OK ||
+        request.writeInt32(static_cast<int32_t>(layout)) != android::OK) {
+        return android::BAD_VALUE;
+    }
+    if (mSupportsBufferIdentity) {
+        const auto endpoint = android::IInterface::asBinder(
+                android::TransactionCompletedListener::getIInstance());
+        if (!endpoint || !present.gameBufferId ||
+            request.writeUint64(present.gameBufferId) != android::OK ||
+            request.writeStrongBinder(endpoint) != android::OK) return android::BAD_VALUE;
+    }
+    const status_t sent = mComposer->transact(kPublishFrame, request, &reply);
+    if (sent != android::OK) return sent;
+    int32_t response;
+    return reply.readExceptionCode() == 0 && reply.readInt32(&response) == android::OK
+            ? response : android::FAILED_TRANSACTION;
+}
+
+} // namespace vulkan::athens
