+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <android-base/unique_fd.h>
+#include <gui/Surface.h>
+
+#include <cstdint>
+#include <optional>
+
+#include "AthensMotionVectorImage.h"
+#include "AthensVulkanPresentCapture.h"
+
+namespace vulkan::athens {
+
+// The caller owns the Vulkan recording and must retire it before canceling a written slot.
+class AthensMotionVectorChannel {
+public:
+    struct Slot {
+        android::sp<android::GraphicBuffer> buffer;
+        android::base::unique_fd previousRead;
+    };
+
+    static std::optional<AthensMotionVectorChannel> open(VkSwapchainKHR swapchain);
+
+    AthensMotionVectorChannel(AthensMotionVectorChannel&&) = default;
+    ~AthensMotionVectorChannel();
+
+    AuthorizedPresentTarget presentTarget() const;
+    bool isRevoked() const;
+
+    std::optional<Slot> dequeue();
+    android::status_t cancel(Slot& slot, android::base::unique_fd gpuCompletion);
+    android::status_t publish(Slot& slot, const AthensVulkanFrameWitness::Pair& pair,
+                              const PresentMetadata& present, MotionVectorLayout layout);
+
+private:
+    AthensMotionVectorChannel(android::sp<android::IBinder> composer,
+                             android::sp<android::Surface> game,
+                             android::sp<android::IBinder> gameHandle,
+                             android::sp<android::Surface> vectors, int64_t generation,
+                             int32_t gameLayerId, bool supportsBufferIdentity);
+
+    android::sp<android::IBinder> mComposer;
+    android::sp<android::Surface> mGame;
+    android::sp<android::IBinder> mGameHandle;
+    android::sp<android::Surface> mVectors;
+    int64_t mGeneration;
+    int32_t mGameLayerId;
+    bool mSupportsBufferIdentity;
+};
+
+} // namespace vulkan::athens
