+
+bool encodeBuffer(GraphicBuffer& buffer, Fence& acquireFence, uint32_t scaleWidth,
+                  uint32_t scaleHeight, bool xHigh10, athens::MotionVectorPayload& payload) {
+    const uint32_t width = buffer.getWidth();
+    const uint32_t height = buffer.getHeight();
+    if (width == 0 || width > athens::kMaxMotionVectorDimension || height == 0 ||
+        height > athens::kMaxMotionVectorDimension || buffer.getLayerCount() != 1 ||
+        (buffer.getUsage() & GraphicBuffer::USAGE_PROTECTED) != 0 || !buffer.handle) {
+        return false;
+    }
+
+    athens::MotionVectorFormat format;
+    switch (buffer.getPixelFormat()) {
+        case PIXEL_FORMAT_RGBA_8888:
+            if (xHigh10) return false;
+            format = athens::MotionVectorFormat::Rgba8888;
+            break;
+        case PIXEL_FORMAT_RGBA_1010102:
+            format = xHigh10 ? athens::MotionVectorFormat::Rgba1010102XHigh
+                             : athens::MotionVectorFormat::Rgba1010102;
+            break;
+        default:
+            return false;
+    }
+
+    auto& mapper = GraphicBufferMapper::get();
+    ui::Compression compression;
+    uint64_t allocationSize = 0;
+    uint64_t protectedContent = 0;
+    std::vector<ui::PlaneLayout> planes;
+    if (mapper.getCompression(buffer.handle, &compression) != OK ||
+        compression != ui::Compression::NONE ||
+        mapper.getProtectedContent(buffer.handle, &protectedContent) != OK ||
+        protectedContent != 0 || mapper.getAllocationSize(buffer.handle, &allocationSize) != OK ||
+        mapper.getPlaneLayouts(buffer.handle, &planes) != OK || planes.size() != 1) {
+        return false;
+    }
+
+    const auto& plane = planes.front();
+    if (plane.offsetInBytes != 0 || plane.sampleIncrementInBits != 32 ||
+        plane.widthInSamples < width || plane.heightInSamples < height ||
+        plane.strideInBytes <= 0 || plane.totalSizeInBytes <= 0 ||
+        static_cast<uint64_t>(plane.totalSizeInBytes) > allocationSize ||
+        static_cast<uint64_t>(plane.totalSizeInBytes) > std::numeric_limits<size_t>::max() ||
+        static_cast<uint64_t>(plane.strideInBytes) > std::numeric_limits<size_t>::max()) {
+        return false;
+    }
+    if (acquireFence.wait(kFenceWaitMs) != OK) return false;
+
+    void* pixels = nullptr;
+    if (buffer.lock(GraphicBuffer::USAGE_SW_READ_OFTEN, &pixels) != OK) return false;
+    const bool encoded = pixels &&
+            athens::encodeMotionVectors({{static_cast<const std::byte*>(pixels),
+                                          static_cast<size_t>(plane.totalSizeInBytes)},
+                                         width,
+                                         height,
+                                         static_cast<size_t>(plane.strideInBytes),
+                                         format},
+                                        scaleWidth, scaleHeight, payload);
+    return buffer.unlock() == OK && encoded;
+}
+
+} // namespace
+
+AthensMotionVector::~AthensMotionVector() {
+    {
+        std::lock_guard lock(mMutex);
+        mStopping = true;
+    }
+    mWake.notify_one();
+    if (mThread.joinable()) mThread.join();
+}
+
+void AthensMotionVector::activate(SessionId session, uint32_t scaleWidth, uint32_t scaleHeight) {
+    if (session == 0 || scaleWidth == 0 || scaleWidth > athens::kMaxMotionVectorDimension ||
+        scaleHeight == 0 || scaleHeight > athens::kMaxMotionVectorDimension) {
+        return;
+    }
+
+    std::optional<Frame> dropped;
+    {
+        std::lock_guard lock(mMutex);
+        if (mSession && mSession->id == session) return;
+        dropped.swap(mPending);
+        mSession = Session{session, scaleWidth, scaleHeight};
+        mLastSubmitted.reset();
+        mResetRequested = mOutputDirty;
+        ++mGeneration;
+        if (!mThread.joinable()) mThread = std::thread([this] { run(); });
+    }
+    mWake.notify_one();
+}
+
+void AthensMotionVector::submit(SessionId session, const sp<GraphicBuffer>& buffer,
+                                const sp<Fence>& acquireFence, std::shared_ptr<const void> lease,
+                                bool xHigh10) {
+    if (!buffer || !acquireFence || !acquireFence->isValid() || !lease) return;
+
+    std::optional<Frame> dropped;
+    {
+        std::lock_guard lock(mMutex);
+        if (!mSession || mSession->id != session) return;
+        dropped.swap(mPending);
+        mPending = Frame{buffer, acquireFence, std::move(lease), Clock::now(), *mSession, xHigh10};
+    }
+    mWake.notify_one();
+}
+
+void AthensMotionVector::idle(SessionId session) {
+    discard(session, false);
+}
+
+void AthensMotionVector::deactivate(SessionId session) {
+    discard(session, true);
+}
+
+void AthensMotionVector::discard(SessionId session, bool deactivate) {
+    std::optional<Frame> dropped;
+    {
+        std::lock_guard lock(mMutex);
+        if (!mSession || mSession->id != session) return;
+        if (deactivate) {
+            mSession.reset();
+            mLastSubmitted.reset();
+        }
+        dropped.swap(mPending);
+        if (mResetRequested && !dropped && !deactivate) return;
+        mResetRequested = true;
+        ++mGeneration;
+    }
+    mWake.notify_one();
+}
+
+bool AthensMotionVector::hasRecentSuccessfulSubmission(SessionId session, int64_t maxAgeNs) const {
+    std::lock_guard lock(mMutex);
+    return maxAgeNs >= 0 && mSession && mSession->id == session && mLastSubmitted &&
+            Clock::now() - *mLastSubmitted <= std::chrono::nanoseconds(maxAgeNs);
+}
+
+void AthensMotionVector::run() {
+    sp<IBinder> service;
+    Clock::time_point retryAt{};
+    Clock::time_point idleAt{};
+    int resetAttempts = 0;
+    uint64_t generation = 0;
+    std::unique_lock lock(mMutex);
+    while (!mStopping) {
+        if (generation != mGeneration) {
+            generation = mGeneration;
+            resetAttempts = 0;
+        }
+        const auto now = Clock::now();
+        const bool resetDue = mOutputDirty && (mResetRequested || now >= idleAt);
+        if (resetDue && resetAttempts >= kMaxResetAttempts && mPending) {
+            std::optional<Frame> dropped;
+            dropped.swap(mPending);
+            resetAttempts = 0;
+            lock.unlock();
+            dropped.reset();
+            lock.lock();
+            continue;
+        }
+        const bool reset = resetDue && resetAttempts < kMaxResetAttempts;
+        if (!reset && !mPending) {
+            if (mOutputDirty && !resetDue) {
+                mWake.wait_until(lock, idleAt);
+            } else {
+                mWake.wait(lock);
+            }
+            continue;
+        }
+        if (now < retryAt) {
+            mWake.wait_until(lock, retryAt);
+            continue;
+        }
+        if (reset) {
+            lock.unlock();
+            const bool sent = ensureHwcService(service) &&
+                    athens::sendMotionVectorPacket(service, athens::idleMotionVectorPayload());
+            if (!sent) service.clear();
+            lock.lock();
+            if (sent) {
+                mOutputDirty = false;
+                mResetRequested = false;
+                // An idle packet clears the hardware output. Health measures the age of
+                // the last acknowledged active packet, even across a short idle gap.
+                resetAttempts = 0;
+            } else {
+                ++resetAttempts;
+                retryAt = Clock::now() + kRetryDelay;
+            }
+            continue;
+        }
+
+        auto frame = std::move(*mPending);
+        mPending.reset();
+        lock.unlock();
+        athens::MotionVectorPayload payload;
+        const bool encoded = Clock::now() - frame.queuedAt <= kMaxFrameAge &&
+                encodeBuffer(*frame.buffer, *frame.acquireFence, frame.session.scaleWidth,
+                             frame.session.scaleHeight, frame.xHigh10, payload);
+        frame.lease.reset();
+        frame.buffer.clear();
+        frame.acquireFence.clear();
+        const bool ready = encoded && ensureHwcService(service);
+        lock.lock();
+        if (!encoded || mStopping || generation != mGeneration ||
+            Clock::now() - frame.queuedAt > kMaxFrameAge) {
+            continue;
+        }
+
+        if (!ready) {
+            mLastSubmitted.reset();
+            retryAt = Clock::now() + kRetryDelay;
+            continue;
+        }
+
+        mOutputDirty = true;
+        mResetRequested = false;
+        idleAt = Clock::now() + kIdleDelay;
+        lock.unlock();
+        const bool sent = athens::sendMotionVectorPacket(service, payload);
+        if (!sent) service.clear();
+        lock.lock();
+        if (sent && generation == mGeneration) {
+            mLastSubmitted = Clock::now();
+        } else if (!sent) {
+            mLastSubmitted.reset();
+            retryAt = Clock::now() + kRetryDelay;
+        }
+    }
+}
+
+} // namespace android
