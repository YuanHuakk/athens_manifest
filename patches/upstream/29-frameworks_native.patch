+
+#include <binder/IServiceManager.h>
+#include <binder/Parcel.h>
+#include <binder/Status.h>
+#include <utils/String16.h>
+
+#include <string>
+
+namespace android::athens {
+namespace {
+
+const String16 kServiceName(
+        u"vendor.xiaomi.hardware.display.mihwcextension.IMiHwcExtension/default");
+const String16 kDescriptor(u"vendor.xiaomi.hardware.display.mihwcextension.IMiHwcExtension");
+constexpr int32_t kInterfaceVersion = 2;
+constexpr char kInterfaceHash[] = "20be543ce280cfc2041b1bca548314b178bdff7c";
+constexpr uint32_t kSendMotionVectors = IBinder::FIRST_CALL_TRANSACTION + 8;
+constexpr int32_t kPrimaryDisplay = 0;
+
+bool transact(const sp<IBinder>& service, uint32_t code, Parcel& data, Parcel& reply) {
+    binder::Status status;
+    return service->transact(code, data, &reply) == OK && status.readFromParcel(reply) == OK &&
+            status.isOk();
+}
+
+} // namespace
+
+sp<IBinder> findMotionVectorService() {
+    const auto service = defaultServiceManager()->checkService(kServiceName);
+    if (!service || !service->isBinderAlive()) return nullptr;
+
+    Parcel versionData;
+    Parcel versionReply;
+    versionData.markForBinder(service);
+    int32_t version = 0;
+    if (versionData.writeInterfaceToken(kDescriptor) != OK ||
+        !transact(service, IBinder::LAST_CALL_TRANSACTION, versionData, versionReply) ||
+        versionReply.readInt32(&version) != OK || version != kInterfaceVersion) {
+        return nullptr;
+    }
+
+    Parcel hashData;
+    Parcel hashReply;
+    hashData.markForBinder(service);
+    std::string hash;
+    if (hashData.writeInterfaceToken(kDescriptor) != OK ||
+        !transact(service, IBinder::LAST_CALL_TRANSACTION - 1, hashData, hashReply) ||
+        hashReply.readUtf8FromUtf16(&hash) != OK || hash != kInterfaceHash) {
+        return nullptr;
+    }
+    return service;
+}
+
+bool sendMotionVectorPacket(const sp<IBinder>& service, const MotionVectorPayload& payload) {
+    if (!service) return false;
+    Parcel data;
+    Parcel reply;
+    data.markForBinder(service);
+    // Stable AIDL V2 sendMVInfo(int display, float[] vectors).
+    return data.writeInterfaceToken(kDescriptor) == OK && data.writeInt32(kPrimaryDisplay) == OK &&
+            data.writeInt32(static_cast<int32_t>(payload.size())) == OK &&
+            data.write(payload.data(), payload.size() * sizeof(float)) == OK &&
+            transact(service, kSendMotionVectors, data, reply);
+}
+
+} // namespace android::athens
