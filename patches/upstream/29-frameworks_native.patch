+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "AthensMotionVectorImage.h"
+
+#include <linux/sync_file.h>
+#include <sys/ioctl.h>
+
+#include <bit>
+#include <cerrno>
+#include <cstdint>
+#include <utility>
+
+namespace vulkan::athens {
+namespace {
+
+constexpr VkFormat kNativeFormat = VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+constexpr VkFormat kStockSourceFormat = VK_FORMAT_A2R10G10B10_UNORM_PACK32;
+constexpr auto kHardwareBufferType =
+    VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID;
+constexpr auto kSyncFdType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+constexpr uint32_t kMaxSourceDimension = 4096;
+constexpr VkImageSubresourceRange kColorSubresource = {
+    .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+    .baseMipLevel = 0,
+    .levelCount = 1,
+    .baseArrayLayer = 0,
+    .layerCount = 1,
+};
+
+bool hasDispatch(const AthensMotionVectorImage::Dispatch& d,
+                 AthensMotionVectorImage::CompletionMode mode) {
+    if (!d.getFormatProperties || !d.getHardwareBufferProperties ||
+        !d.createImage || !d.destroyImage || !d.allocateMemory ||
+        !d.freeMemory || !d.bindImageMemory || !d.cmdPipelineBarrier ||
+        !d.cmdBlitImage) {
+        return false;
+    }
+    if (mode == AthensMotionVectorImage::CompletionMode::PresentSyncFd)
+        return true;
+    return mode == AthensMotionVectorImage::CompletionMode::Owned &&
+           d.getExternalSemaphoreProperties && d.createSemaphore &&
+           d.destroySemaphore && d.getSemaphoreFd && d.createFence &&
+           d.destroyFence && d.getFenceStatus;
+}
+
+bool supportsBlitSource(VkPhysicalDevice device,
+                        PFN_vkGetPhysicalDeviceFormatProperties getProperties,
+                        VkFormat format) {
+    VkFormatProperties properties{};
+    getProperties(device, format, &properties);
+    return (properties.optimalTilingFeatures &
+            VK_FORMAT_FEATURE_BLIT_SRC_BIT) != 0;
+}
+
+bool usableSourceLayout(VkImageLayout layout) {
+    return layout == VK_IMAGE_LAYOUT_GENERAL ||
+           layout == VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL ||
+           layout == VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL ||
+           layout == VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+}
+
+VkResult checkSyncFd(int fd) {
+    if (fd < 0)
+        return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+    sync_file_info info{};
+    int result;
+    do {
+        result = ioctl(fd, SYNC_IOC_FILE_INFO, &info);
+    } while (result < 0 && errno == EINTR);
+    if (result < 0 || info.status < 0)
+        return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+    return info.status == 1 ? VK_SUCCESS : VK_NOT_READY;
+}
+
+}  // namespace
+
+AthensMotionVectorImage::AthensMotionVectorImage(VkDevice device,
+                                                 const Dispatch& dispatch,
+                                                 AHardwareBuffer* buffer,
+                                                 CompletionMode mode)
+    : mDevice(device),
+      mDispatch(dispatch),
+      mBuffer(buffer),
+      mCompletionMode(mode) {
+    AHardwareBuffer_acquire(mBuffer);
+}
+
+VkResult AthensMotionVectorImage::import(
+    VkPhysicalDevice physicalDevice,
+    VkDevice device,
+    const Dispatch& dispatch,
+    AHardwareBuffer* buffer,
+    std::unique_ptr<AthensMotionVectorImage>& output,
+    CompletionMode mode) {
+    if (!physicalDevice || !device || !buffer || output ||
+        !hasDispatch(dispatch, mode)) {
+        return VK_ERROR_INITIALIZATION_FAILED;
+    }
+
+    AHardwareBuffer_Desc descriptor{};
+    AHardwareBuffer_describe(buffer, &descriptor);
+    const uint64_t cpuRead =
+        descriptor.usage & AHARDWAREBUFFER_USAGE_CPU_READ_MASK;
+    if (descriptor.format != AHARDWAREBUFFER_FORMAT_R10G10B10A2_UNORM ||
+        descriptor.width != kWidth || descriptor.height != kHeight ||
+        descriptor.layers != 1 ||
+        (cpuRead != AHARDWAREBUFFER_USAGE_CPU_READ_RARELY &&
+         cpuRead != AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN) ||
+        (descriptor.usage & AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT) == 0 ||
+        (descriptor.usage & AHARDWAREBUFFER_USAGE_PROTECTED_CONTENT) != 0) {
+        return VK_ERROR_FORMAT_NOT_SUPPORTED;
+    }
+
+    if (mode == CompletionMode::Owned) {
+        const VkPhysicalDeviceExternalSemaphoreInfo semaphoreInfo = {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_SEMAPHORE_INFO,
+            .pNext = nullptr,
+            .handleType = kSyncFdType,
+        };
+        VkExternalSemaphoreProperties semaphoreProperties{};
+        semaphoreProperties.sType =
+            VK_STRUCTURE_TYPE_EXTERNAL_SEMAPHORE_PROPERTIES;
+        dispatch.getExternalSemaphoreProperties(physicalDevice, &semaphoreInfo,
+                                                &semaphoreProperties);
+        if ((semaphoreProperties.compatibleHandleTypes & kSyncFdType) == 0 ||
+            (semaphoreProperties.externalSemaphoreFeatures &
+             VK_EXTERNAL_SEMAPHORE_FEATURE_EXPORTABLE_BIT) == 0) {
+            return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+        }
+    }
+
+    const bool nativeSource = supportsBlitSource(
+        physicalDevice, dispatch.getFormatProperties, kNativeFormat);
+    const bool stockSource = supportsBlitSource(
+        physicalDevice, dispatch.getFormatProperties, kStockSourceFormat);
+    if (!nativeSource && !stockSource)
+        return VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+    VkAndroidHardwareBufferFormatPropertiesANDROID formatProperties{};
+    formatProperties.sType =
+        VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_FORMAT_PROPERTIES_ANDROID;
+    VkAndroidHardwareBufferPropertiesANDROID bufferProperties{};
+    bufferProperties.sType =
+        VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID;
+    bufferProperties.pNext = &formatProperties;
+    VkResult result =
+        dispatch.getHardwareBufferProperties(device, buffer, &bufferProperties);
+    if (result != VK_SUCCESS)
+        return result;
+    if (formatProperties.format != kNativeFormat ||
+        (formatProperties.formatFeatures & VK_FORMAT_FEATURE_BLIT_DST_BIT) ==
+            0 ||
+        bufferProperties.memoryTypeBits == 0 ||
+        bufferProperties.allocationSize == 0) {
+        return VK_ERROR_FORMAT_NOT_SUPPORTED;
+    }
+
+    auto image = std::unique_ptr<AthensMotionVectorImage>(
+        new AthensMotionVectorImage(device, dispatch, buffer, mode));
+    image->mNativeSourceSupported = nativeSource;
+    image->mStockSourceSupported = stockSource;
+    const VkExternalMemoryImageCreateInfo externalInfo = {
+        .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+        .pNext = nullptr,
+        .handleTypes = kHardwareBufferType,
+    };
+    const VkImageCreateInfo createInfo = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .pNext = &externalInfo,
+        .flags = 0,
+        .imageType = VK_IMAGE_TYPE_2D,
+        .format = kNativeFormat,
+        .extent = {kWidth, kHeight, 1},
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT,
+        .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                 VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .queueFamilyIndexCount = 0,
+        .pQueueFamilyIndices = nullptr,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    result = dispatch.createImage(device, &createInfo, nullptr, &image->mImage);
+    if (result != VK_SUCCESS)
+        return result;
+
+    const VkImportAndroidHardwareBufferInfoANDROID importInfo = {
+        .sType = VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID,
+        .pNext = nullptr,
+        .buffer = buffer,
+    };
+    const VkMemoryDedicatedAllocateInfo dedicatedInfo = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+        .pNext = &importInfo,
+        .image = image->mImage,
+        .buffer = VK_NULL_HANDLE,
+    };
+    const VkMemoryAllocateInfo allocation = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .pNext = &dedicatedInfo,
+        .allocationSize = bufferProperties.allocationSize,
+        .memoryTypeIndex = static_cast<uint32_t>(
+            std::countr_zero(bufferProperties.memoryTypeBits)),
+    };
+    result =
+        dispatch.allocateMemory(device, &allocation, nullptr, &image->mMemory);
+    if (result != VK_SUCCESS)
+        return result;
+    result = dispatch.bindImageMemory(device, image->mImage, image->mMemory, 0);
+    if (result != VK_SUCCESS)
+        return result;
+    output = std::move(image);
+    return VK_SUCCESS;
+}
+
+AthensMotionVectorImage::~AthensMotionVectorImage() {
+    const VkResult result =
+        mState == State::Submitted ? tryRetire() : VK_SUCCESS;
+    // A pending or failed fence cannot prove that the GPU is finished. If an
+    // owner abandons such a job, the lower device and imported memory retain
+    // these handles.
+    if (result == VK_SUCCESS || result == VK_ERROR_DEVICE_LOST) {
+        destroySubmission();
+        if (mImage)
+            mDispatch.destroyImage(mDevice, mImage, nullptr);
+        if (mMemory)
+            mDispatch.freeMemory(mDevice, mMemory, nullptr);
+    }
+    AHardwareBuffer_release(mBuffer);
+}
+
+VkResult AthensMotionVectorImage::record(VkCommandBuffer cmd,
+                                         uint32_t queueFamily,
+                                         const Source& source,
+                                         DestinationRelease release,
+                                         Submission& output) {
+    if (mDeviceLost)
+        return VK_ERROR_DEVICE_LOST;
+    if (mState != State::Idle)
+        return VK_NOT_READY;
+    if (!cmd || !source.image || source.image == mImage ||
+        queueFamily >= VK_QUEUE_FAMILY_FOREIGN_EXT ||
+        (source.queueFamily != queueFamily &&
+         source.queueFamily != VK_QUEUE_FAMILY_IGNORED) ||
+        source.extent.width == 0 || source.extent.width > kMaxSourceDimension ||
+        source.extent.height == 0 ||
+        source.extent.height > kMaxSourceDimension ||
+        (source.usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) == 0 ||
+        (source.flags & (VK_IMAGE_CREATE_PROTECTED_BIT |
+                         VK_IMAGE_CREATE_SPARSE_BINDING_BIT)) != 0 ||
+        source.tiling != VK_IMAGE_TILING_OPTIMAL ||
+        source.samples != VK_SAMPLE_COUNT_1_BIT || source.beforeStages == 0 ||
+        source.afterStages == 0 || !usableSourceLayout(source.layout)) {
+        return VK_ERROR_VALIDATION_FAILED_EXT;
+    }
+
+    MotionVectorLayout layout;
+    if (source.format == kNativeFormat && mNativeSourceSupported) {
+        layout = MotionVectorLayout::XLow10YMiddle10;
+    } else if (source.format == kStockSourceFormat && mStockSourceSupported) {
+        layout = MotionVectorLayout::XHigh10YMiddle10;
+    } else {
+        return VK_ERROR_FORMAT_NOT_SUPPORTED;
+    }
+
+    switch (release.kind) {
+        case DestinationRelease::Kind::SyncFd: {
+            const VkResult status = checkSyncFd(release.syncFd);
+            if (status != VK_SUCCESS)
+                return status;
+            break;
+        }
+        case DestinationRelease::Kind::Unused:
+            if (mEverSubmitted || release.syncFd != -1)
+                return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+            break;
+        case DestinationRelease::Kind::DequeuedWithoutFence:
+            if (release.syncFd != -1)
+                return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+            break;
+        default:
+            return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+    }
+
+    if (mCompletionMode == CompletionMode::Owned) {
+        const VkExportSemaphoreCreateInfo exportInfo = {
+            .sType = VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO,
+            .pNext = nullptr,
+            .handleTypes = kSyncFdType,
+        };
+        const VkSemaphoreCreateInfo semaphoreInfo = {
+            .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
+            .pNext = &exportInfo,
+            .flags = 0,
+        };
+        VkResult result = mDispatch.createSemaphore(mDevice, &semaphoreInfo,
+                                                    nullptr, &mSemaphore);
+        if (result != VK_SUCCESS)
+            return result;
+        const VkFenceCreateInfo fenceInfo = {
+            .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+            .pNext = nullptr,
+            .flags = 0,
+        };
+        result = mDispatch.createFence(mDevice, &fenceInfo, nullptr, &mFence);
+        if (result != VK_SUCCESS) {
+            destroySubmission();
+            return result;
+        }
+    }
+
+    const VkImageMemoryBarrier before[] = {
+        {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = source.beforeAccess,
+            .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+            .oldLayout = source.layout,
+            .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = source.image,
+            .subresourceRange = kColorSubresource,
+        },
+        {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = 0,
+            .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,  // This blit overwrites the
+                                                     // whole image.
+            .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_FOREIGN_EXT,
+            .dstQueueFamilyIndex = queueFamily,
+            .image = mImage,
+            .subresourceRange = kColorSubresource,
+        },
+    };
+    mDispatch.cmdPipelineBarrier(cmd, source.beforeStages,
+                                 VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr,
+                                 0, nullptr, 2, before);
+    const VkImageSubresourceLayers color = {
+        .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+        .mipLevel = 0,
+        .baseArrayLayer = 0,
+        .layerCount = 1,
+    };
+    const VkImageBlit blit = {
+        .srcSubresource = color,
+        .srcOffsets = {{0, 0, 0},
+                       {static_cast<int32_t>(source.extent.width),
+                        static_cast<int32_t>(source.extent.height), 1}},
+        .dstSubresource = color,
+        .dstOffsets = {{0, 0, 0}, {kWidth, kHeight, 1}},
+    };
+    mDispatch.cmdBlitImage(
+        cmd, source.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, mImage,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_NEAREST);
+
+    const VkImageMemoryBarrier after[] = {
+        {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+            .dstAccessMask = source.afterAccess,
+            .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+            .newLayout = source.layout,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+            .image = source.image,
+            .subresourceRange = kColorSubresource,
+        },
+        {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dstAccessMask = 0,
+            .oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+            .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+            .srcQueueFamilyIndex = queueFamily,
+            .dstQueueFamilyIndex = VK_QUEUE_FAMILY_FOREIGN_EXT,
+            .image = mImage,
+            .subresourceRange = kColorSubresource,
+        },
+    };
+    mDispatch.cmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                 source.afterStages, 0, 0, nullptr, 0, nullptr,
+                                 2, after);
+    mState = State::Recorded;
+    output = {mSemaphore, mFence, layout};
+    return VK_SUCCESS;
+}
+
+VkResult AthensMotionVectorImage::markSubmitted(VkResult submitResult) {
+    if (mState != State::Recorded)
+        return VK_ERROR_VALIDATION_FAILED_EXT;
+    if (submitResult == VK_SUCCESS) {
+        mState = State::Submitted;
+        mEverSubmitted = true;
+    } else if (submitResult == VK_ERROR_DEVICE_LOST) {
+        mDeviceLost = true;
+        destroySubmission();
+    }
+    return submitResult;
+}
+
+VkResult AthensMotionVectorImage::exportSyncFd(
+    android::base::unique_fd& output) {
+    if (mDeviceLost)
+        return VK_ERROR_DEVICE_LOST;
+    if (mCompletionMode != CompletionMode::Owned ||
+        mState != State::Submitted || mExported || output.ok()) {
+        return VK_ERROR_VALIDATION_FAILED_EXT;
+    }
+    const VkSemaphoreGetFdInfoKHR info = {
+        .sType = VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR,
+        .pNext = nullptr,
+        .semaphore = mSemaphore,
+        .handleType = kSyncFdType,
+    };
+    int fd = -1;
+    const VkResult result = mDispatch.getSemaphoreFd(mDevice, &info, &fd);
+    if (result != VK_SUCCESS)
+        return result;
+    // The SYNC_FD export consumes the semaphore signal even when it returns -1.
+    mExported = true;
+    if (fd < 0)
+        return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+    output.reset(fd);
+    return VK_SUCCESS;
+}
+
+VkResult AthensMotionVectorImage::attachPresentSyncFd(
+    android::base::unique_fd completion) {
+    if (mDeviceLost)
+        return VK_ERROR_DEVICE_LOST;
+    if (mCompletionMode != CompletionMode::PresentSyncFd ||
+        mState != State::Submitted || mPresentSyncFd.ok()) {
+        return VK_ERROR_VALIDATION_FAILED_EXT;
+    }
+    const VkResult result = checkSyncFd(completion.get());
+    if (result != VK_SUCCESS && result != VK_NOT_READY)
+        return result;
+    mPresentSyncFd = std::move(completion);
+    return VK_SUCCESS;
+}
+
+VkResult AthensMotionVectorImage::fenceDiscardedWrite(VkQueue queue) {
+    if (mCompletionMode != CompletionMode::PresentSyncFd || mState != State::Submitted ||
+        !queue || !mDispatch.queueSubmit || !mDispatch.createFence || !mDispatch.destroyFence ||
+        !mDispatch.getFenceStatus) return VK_ERROR_INITIALIZATION_FAILED;
+    if (mFence || mPresentSyncFd.ok()) return VK_SUCCESS;
+    const VkFenceCreateInfo info{.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+    VkFence fence = VK_NULL_HANDLE;
+    VkResult result = mDispatch.createFence(mDevice, &info, nullptr, &fence);
+    if (result != VK_SUCCESS) return result;
+    result = mDispatch.queueSubmit(queue, 0, nullptr, fence);
+    if (result == VK_SUCCESS) {
+        mFence = fence;
+    } else {
+        mDispatch.destroyFence(mDevice, fence, nullptr);
+        if (result == VK_ERROR_DEVICE_LOST) mDeviceLost = true;
+    }
+    return result;
+}
+
+VkResult AthensMotionVectorImage::tryRetire() {
+    if (mDeviceLost)
+        return VK_ERROR_DEVICE_LOST;
+    if (mState == State::Idle)
+        return VK_SUCCESS;
+    if (mState == State::Recorded)
+        return VK_NOT_READY;
+    const VkResult result =
+        mFence != VK_NULL_HANDLE
+            ? mDispatch.getFenceStatus(mDevice, mFence)
+            : (mPresentSyncFd.ok() ? checkSyncFd(mPresentSyncFd.get())
+                                   : VK_NOT_READY);
+    if (result == VK_SUCCESS || result == VK_ERROR_DEVICE_LOST) {
+        mDeviceLost = result == VK_ERROR_DEVICE_LOST;
+        destroySubmission();
+    }
+    return result;
+}
+
+void AthensMotionVectorImage::cancelRecording() {
+    if (mState == State::Recorded)
+        destroySubmission();
+}
+
+void AthensMotionVectorImage::retireAfterDeviceIdle() {
+    if (mState == State::Submitted)
+        destroySubmission();
+}
+
+void AthensMotionVectorImage::destroySubmission() {
+    if (mSemaphore)
+        mDispatch.destroySemaphore(mDevice, mSemaphore, nullptr);
+    if (mFence)
+        mDispatch.destroyFence(mDevice, mFence, nullptr);
+    mSemaphore = VK_NULL_HANDLE;
+    mFence = VK_NULL_HANDLE;
+    mPresentSyncFd.reset();
+    mExported = false;
+    mState = State::Idle;
+}
+
+}  // namespace vulkan::athens
