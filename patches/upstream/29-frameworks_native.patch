diff --git a/vulkan/libvulkan/AthensMiVkRenderEvidence.cpp b/vulkan/libvulkan/AthensMiVkRenderEvidence.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7845d7e697451499f501e655d6cb85970ded7689
--- /dev/null
+++ b/vulkan/libvulkan/AthensMiVkRenderEvidence.cpp
@@ -0,0 +1,970 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "AthensMiVkRenderEvidence.h"
+
+#include <log/log.h>
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <mutex>
+#include <type_traits>
+
+namespace vulkan::athens {
+namespace {
+
+constexpr size_t kAttachmentLimit = 8;
+constexpr size_t kRenderedLimit = 24;
+constexpr VkFormat kVectorFormat = VK_FORMAT_A2R10G10B10_UNORM_PACK32;
+
+// Fixed-size tables allocate no memory on a Vulkan call. Live handle reuse
+// replaces old metadata; object generations also protect dependent views and
+// framebuffers.
+template <typename Handle, typename Value, size_t Size>
+struct Table {
+    struct Entry {
+        Handle handle{};
+        Value value{};
+        bool tombstone = false;
+    };
+    static_assert((Size & (Size - 1)) == 0);
+    std::array<Entry, Size> entries{};
+
+    static size_t index(Handle handle) {
+        uint64_t bits;
+        if constexpr (std::is_pointer_v<Handle>) {
+            bits = reinterpret_cast<uintptr_t>(handle);
+        } else {
+            bits = handle;
+        }
+        bits ^= bits >> 33;
+        // A shift-based mix avoids intentional overflow under libvulkan's
+        // integer sanitizer.
+        bits ^= bits >> 11;
+        bits ^= bits >> 4;
+        return static_cast<size_t>(bits) & (Size - 1);
+    }
+
+    Value* find(Handle handle) {
+        if (!handle)
+            return nullptr;
+        const size_t start = index(handle);
+        for (size_t offset = 0; offset < Size; ++offset) {
+            Entry& entry = entries[(start + offset) & (Size - 1)];
+            if (entry.handle == handle)
+                return &entry.value;
+            if (!entry.handle && !entry.tombstone)
+                return nullptr;
+        }
+        return nullptr;
+    }
+
+    void put(Handle handle, const Value& value) {
+        if (!handle)
+            return;
+        Entry* firstVacancy = nullptr;
+        const size_t start = index(handle);
+        for (size_t offset = 0; offset < Size; ++offset) {
+            Entry& entry = entries[(start + offset) & (Size - 1)];
+            if (entry.handle == handle) {
+                entry.value = value;
+                return;
+            }
+            if (!entry.handle && !firstVacancy)
+                firstVacancy = &entry;
+            if (!entry.handle && !entry.tombstone)
+                break;
+        }
+        if (firstVacancy)
+            *firstVacancy = {handle, value, false};
+    }
+
+    void erase(Handle handle) {
+        if (!handle)
+            return;
+        const size_t start = index(handle);
+        for (size_t offset = 0; offset < Size; ++offset) {
+            Entry& entry = entries[(start + offset) & (Size - 1)];
+            if (entry.handle == handle) {
+                entry = {};
+                entry.tombstone = true;
+                return;
+            }
+            if (!entry.handle && !entry.tombstone)
+                return;
+        }
+    }
+
+    void clear() {
+        for (auto& entry : entries)
+            entry = {};
+    }
+};
+
+struct Image {
+    uint64_t generation;
+    VkImageCreateInfo info;
+};
+struct View {
+    uint64_t generation;
+    uint64_t imageGeneration;
+    VkImage image;
+    VkFormat format;
+};
+struct Attachment {
+    VkFormat format;
+    VkSampleCountFlagBits samples;
+    VkAttachmentLoadOp load;
+    VkAttachmentStoreOp store;
+    VkImageLayout colorLayout;
+    VkImageLayout finalLayout;
+};
+
+// A framebuffer may outlive its creation render pass and may be used with a
+// different compatible pass. Keep the creation data for the color/depth
+// layouts we can verify. Use the active pass for load/store and layout.
+struct SimplePassLayout {
+    uint32_t attachmentCount;
+    uint32_t color;
+    uint32_t depth;
+    std::array<VkFormat, 2> formats{};
+    std::array<VkSampleCountFlagBits, 2> samples{};
+    uint32_t dependencyCount;
+    std::array<std::array<uint32_t, 7>, 4> dependencies{};
+
+    bool operator==(const SimplePassLayout&) const = default;
+};
+
+std::optional<SimplePassLayout> simpleLayoutOf(const VkRenderPassCreateInfo& info) {
+    const auto& subpass = info.pSubpasses[0];
+    SimplePassLayout layout{};
+    if (info.attachmentCount > layout.formats.size() ||
+        info.dependencyCount > layout.dependencies.size() ||
+        (info.dependencyCount && !info.pDependencies) || subpass.colorAttachmentCount != 1 ||
+        subpass.inputAttachmentCount || subpass.preserveAttachmentCount ||
+        (subpass.pResolveAttachments &&
+         subpass.pResolveAttachments[0].attachment != VK_ATTACHMENT_UNUSED)) {
+        return std::nullopt;
+    }
+    layout.attachmentCount = info.attachmentCount;
+    layout.color = subpass.pColorAttachments[0].attachment;
+    layout.depth = subpass.pDepthStencilAttachment ? subpass.pDepthStencilAttachment->attachment
+                                                    : VK_ATTACHMENT_UNUSED;
+    for (uint32_t i = 0; i < info.attachmentCount; ++i) {
+        if (info.pAttachments[i].flags) return std::nullopt;
+        layout.formats[i] = info.pAttachments[i].format;
+        layout.samples[i] = info.pAttachments[i].samples;
+    }
+    layout.dependencyCount = info.dependencyCount;
+    for (uint32_t i = 0; i < info.dependencyCount; ++i) {
+        const auto& d = info.pDependencies[i];
+        layout.dependencies[i] = {d.srcSubpass, d.dstSubpass, d.srcStageMask, d.dstStageMask,
+                                  d.srcAccessMask, d.dstAccessMask, d.dependencyFlags};
+    }
+    return layout;
+}
+
+struct Pass {
+    uint64_t generation;
+    uint32_t count;
+    uint32_t colorCount;
+    uint32_t depthAttachment;
+    bool hasResolve;
+    std::array<Attachment, kAttachmentLimit> attachments;
+    std::optional<SimplePassLayout> layout;
+};
+struct Framebuffer {
+    VkRenderPass pass;
+    uint64_t passGeneration;
+    std::optional<SimplePassLayout> layout;
+    VkExtent2D extent;
+    uint32_t count;
+    std::array<VkImageView, kAttachmentLimit> views;
+    std::array<uint64_t, kAttachmentLimit> viewGenerations;
+};
+struct Pool {
+    uint32_t family;
+    bool protectedPool;
+};
+struct ActivePass {
+    VkFramebuffer framebuffer;
+    VkRenderPass pass;
+    VkRect2D renderArea;
+};
+struct Command {
+    VkCommandPool pool;
+    VkCommandBufferLevel level;
+    uint64_t generation = 0;
+    VkCommandBufferUsageFlags usage = 0;
+    bool open = false;
+    bool valid = false;
+    bool inRenderPass = false;
+    bool sawColorDraw = false;
+    ActivePass active{};
+    std::array<VkImage, kRenderedLimit> rendered{};
+    size_t nextRendered = 0;
+};
+
+// clang-format off
+#define ATHENS_RENDER_PROCS(X) \
+    X(CreateImage)  \
+    X(DestroyImage)  \
+    X(CreateImageView)  \
+    X(DestroyImageView)  \
+    X(CreateRenderPass)  \
+    X(DestroyRenderPass)  \
+    X(CreateFramebuffer)  \
+    X(DestroyFramebuffer)  \
+    X(CreateCommandPool)  \
+    X(ResetCommandPool)  \
+    X(DestroyCommandPool)  \
+    X(AllocateCommandBuffers)  \
+    X(FreeCommandBuffers)  \
+    X(BeginCommandBuffer)  \
+    X(EndCommandBuffer)  \
+    X(ResetCommandBuffer)  \
+    X(CmdBeginRenderPass)  \
+    X(CmdEndRenderPass)  \
+    X(CmdDraw)  \
+    X(CmdDrawIndexed)
+// clang-format on
+
+struct Dispatch {
+#define MEMBER(name) PFN_vk##name name = nullptr;
+    ATHENS_RENDER_PROCS(MEMBER)
+#undef MEMBER
+};
+
+struct Tracker {
+    std::mutex mutex;
+    VkDevice device = VK_NULL_HANDLE;
+    bool usable = false;
+    uint64_t generation = 0;
+    Dispatch dispatch;
+    Table<VkImage, Image, 2048> images;
+    Table<VkImageView, View, 4096> views;
+    Table<VkRenderPass, Pass, 512> passes;
+    Table<VkFramebuffer, Framebuffer, 1024> framebuffers;
+    Table<VkCommandPool, Pool, 64> pools;
+    Table<VkCommandBuffer, Command, 1024> commands;
+
+    uint64_t nextGeneration() {
+        ++generation;
+        return generation;
+    }
+};
+
+Tracker tracker;
+
+// All public metadata and function pointers are protected by the mutex. Never
+// hold it across next(), which can synchronously call into the OEM bridge.
+template <typename Pfn>
+Pfn nextProc(Pfn Dispatch::* member) {
+    std::lock_guard lock(tracker.mutex);
+    return tracker.dispatch.*member;
+}
+
+bool tracks(VkDevice device) {
+    return tracker.usable && tracker.device == device;
+}
+
+struct EndContext {
+    VkCommandBuffer commandBuffer;
+    uint64_t generation;
+};
+thread_local const EndContext* endContext = nullptr;
+
+bool isBaseColorView(const VkImageViewCreateInfo& info) {
+    const auto& range = info.subresourceRange;
+    return !info.pNext && !info.flags &&
+           info.viewType == VK_IMAGE_VIEW_TYPE_2D &&
+           range.aspectMask == VK_IMAGE_ASPECT_COLOR_BIT &&
+           range.baseMipLevel == 0 && range.levelCount == 1 &&
+           range.baseArrayLayer == 0 && range.layerCount == 1 &&
+           info.components.r == VK_COMPONENT_SWIZZLE_IDENTITY &&
+           info.components.g == VK_COMPONENT_SWIZZLE_IDENTITY &&
+           info.components.b == VK_COMPONENT_SWIZZLE_IDENTITY &&
+           info.components.a == VK_COMPONENT_SWIZZLE_IDENTITY;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+CreateImage(VkDevice device,
+            const VkImageCreateInfo* info,
+            const VkAllocationCallbacks* allocator,
+            VkImage* image) {
+    const auto result =
+        nextProc(&Dispatch::CreateImage)(device, info, allocator, image);
+    if (result != VK_SUCCESS || !info || !image)
+        return result;
+    std::lock_guard lock(tracker.mutex);
+    if (!tracks(device))
+        return result;
+    tracker.images.erase(*image);
+    if (info->pNext || info->format != kVectorFormat)
+        return result;
+    Image observed{tracker.nextGeneration(), *info};
+    observed.info.pQueueFamilyIndices = nullptr;
+    tracker.images.put(*image, observed);
+    return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+DestroyImage(VkDevice device,
+             VkImage image,
+             const VkAllocationCallbacks* allocator) {
+    {
+        std::lock_guard lock(tracker.mutex);
+        if (tracks(device))
+            tracker.images.erase(image);
+    }
+    nextProc (&Dispatch::DestroyImage)(device, image, allocator);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+CreateImageView(VkDevice device,
+                const VkImageViewCreateInfo* info,
+                const VkAllocationCallbacks* allocator,
+                VkImageView* view) {
+    const auto result =
+        nextProc(&Dispatch::CreateImageView)(device, info, allocator, view);
+    if (result != VK_SUCCESS || !info || !view)
+        return result;
+    std::lock_guard lock(tracker.mutex);
+    if (!tracks(device))
+        return result;
+    tracker.views.erase(*view);
+    if (isBaseColorView(*info)) {
+        const auto* underlying = tracker.images.find(info->image);
+        tracker.views.put(*view, {tracker.nextGeneration(),
+                                  underlying ? underlying->generation : 0,
+                                  info->image, info->format});
+    }
+    return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+DestroyImageView(VkDevice device,
+                 VkImageView view,
+                 const VkAllocationCallbacks* allocator) {
+    {
+        std::lock_guard lock(tracker.mutex);
+        if (tracks(device))
+            tracker.views.erase(view);
+    }
+    nextProc (&Dispatch::DestroyImageView)(device, view, allocator);
+}
+
+std::optional<Pass> describePass(const VkRenderPassCreateInfo& info) {
+    if (info.pNext || info.flags || !info.pAttachments ||
+        !info.attachmentCount || info.attachmentCount > kAttachmentLimit ||
+        info.subpassCount != 1 || !info.pSubpasses) {
+        return std::nullopt;
+    }
+    const auto& subpass = info.pSubpasses[0];
+    if (subpass.flags ||
+        subpass.pipelineBindPoint != VK_PIPELINE_BIND_POINT_GRAPHICS ||
+        !subpass.pColorAttachments || !subpass.colorAttachmentCount ||
+        subpass.colorAttachmentCount > info.attachmentCount) {
+        return std::nullopt;
+    }
+    Pass pass{};
+    pass.count = info.attachmentCount;
+    pass.depthAttachment = subpass.pDepthStencilAttachment
+                               ? subpass.pDepthStencilAttachment->attachment
+                               : VK_ATTACHMENT_UNUSED;
+    if (pass.depthAttachment != VK_ATTACHMENT_UNUSED &&
+        pass.depthAttachment >= pass.count) {
+        return std::nullopt;
+    }
+    for (uint32_t i = 0; i < pass.count; ++i) {
+        const auto& a = info.pAttachments[i];
+        pass.attachments[i] = {a.format,
+                               a.samples,
+                               a.loadOp,
+                               a.storeOp,
+                               VK_IMAGE_LAYOUT_UNDEFINED,
+                               a.finalLayout};
+    }
+    for (uint32_t i = 0; i < subpass.colorAttachmentCount; ++i) {
+        const auto& color = subpass.pColorAttachments[i];
+        if (subpass.pResolveAttachments &&
+            subpass.pResolveAttachments[i].attachment != VK_ATTACHMENT_UNUSED) {
+            pass.hasResolve = true;
+        }
+        if (color.attachment == VK_ATTACHMENT_UNUSED)
+            continue;
+        if (color.attachment >= pass.count)
+            return std::nullopt;
+        pass.attachments[color.attachment].colorLayout = color.layout;
+        ++pass.colorCount;
+    }
+    pass.layout = simpleLayoutOf(info);
+    return pass;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+CreateRenderPass(VkDevice device,
+                 const VkRenderPassCreateInfo* info,
+                 const VkAllocationCallbacks* allocator,
+                 VkRenderPass* pass) {
+    const auto result =
+        nextProc(&Dispatch::CreateRenderPass)(device, info, allocator, pass);
+    if (result != VK_SUCCESS || !info || !pass)
+        return result;
+    auto observed = describePass(*info);
+    std::lock_guard lock(tracker.mutex);
+    if (!tracks(device))
+        return result;
+    tracker.passes.erase(*pass);
+    if (observed) {
+        observed->generation = tracker.nextGeneration();
+        tracker.passes.put(*pass, *observed);
+    }
+    return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+DestroyRenderPass(VkDevice device,
+                  VkRenderPass pass,
+                  const VkAllocationCallbacks* allocator) {
+    {
+        std::lock_guard lock(tracker.mutex);
+        if (tracks(device))
+            tracker.passes.erase(pass);
+    }
+    nextProc (&Dispatch::DestroyRenderPass)(device, pass, allocator);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+CreateFramebuffer(VkDevice device,
+                  const VkFramebufferCreateInfo* info,
+                  const VkAllocationCallbacks* allocator,
+                  VkFramebuffer* framebuffer) {
+    const auto result = nextProc(&Dispatch::CreateFramebuffer)(
+        device, info, allocator, framebuffer);
+    if (result != VK_SUCCESS || !info || !framebuffer)
+        return result;
+    std::lock_guard lock(tracker.mutex);
+    if (!tracks(device))
+        return result;
+    tracker.framebuffers.erase(*framebuffer);
+    const auto* pass = tracker.passes.find(info->renderPass);
+    if (!pass || info->pNext || info->flags || info->layers != 1 ||
+        info->attachmentCount != pass->count || !info->pAttachments ||
+        !info->width || !info->height) {
+        return result;
+    }
+    Framebuffer observed{};
+    observed.pass = info->renderPass;
+    observed.passGeneration = pass->generation;
+    observed.layout = pass->layout;
+    observed.extent = {info->width, info->height};
+    observed.count = info->attachmentCount;
+    for (uint32_t i = 0; i < observed.count; ++i) {
+        observed.views[i] = info->pAttachments[i];
+        const auto* view = tracker.views.find(observed.views[i]);
+        if (view)
+            observed.viewGenerations[i] = view->generation;
+    }
+    tracker.framebuffers.put(*framebuffer, observed);
+    return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+DestroyFramebuffer(VkDevice device,
+                   VkFramebuffer framebuffer,
+                   const VkAllocationCallbacks* allocator) {
+    {
+        std::lock_guard lock(tracker.mutex);
+        if (tracks(device))
+            tracker.framebuffers.erase(framebuffer);
+    }
+    nextProc (&Dispatch::DestroyFramebuffer)(device, framebuffer, allocator);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+CreateCommandPool(VkDevice device,
+                  const VkCommandPoolCreateInfo* info,
+                  const VkAllocationCallbacks* allocator,
+                  VkCommandPool* pool) {
+    const auto result =
+        nextProc(&Dispatch::CreateCommandPool)(device, info, allocator, pool);
+    if (result != VK_SUCCESS || !info || !pool)
+        return result;
+    std::lock_guard lock(tracker.mutex);
+    if (tracks(device)) {
+        tracker.pools.erase(*pool);
+        if (!info->pNext &&
+            info->queueFamilyIndex < VK_QUEUE_FAMILY_FOREIGN_EXT) {
+            tracker.pools.put(
+                *pool,
+                {info->queueFamilyIndex,
+                 (info->flags & VK_COMMAND_POOL_CREATE_PROTECTED_BIT) != 0});
+        }
+    }
+    return result;
+}
+
+void resetCommand(Command& command) {
+    command = {command.pool, command.level};
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL ResetCommandPool(VkDevice device,
+                                                VkCommandPool pool,
+                                                VkCommandPoolResetFlags flags) {
+    const auto result =
+        nextProc(&Dispatch::ResetCommandPool)(device, pool, flags);
+    if (result == VK_SUCCESS) {
+        std::lock_guard lock(tracker.mutex);
+        if (tracks(device)) {
+            for (auto& e : tracker.commands.entries) {
+                if (e.handle && e.value.pool == pool)
+                    resetCommand(e.value);
+            }
+        }
+    }
+    return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+DestroyCommandPool(VkDevice device,
+                   VkCommandPool pool,
+                   const VkAllocationCallbacks* allocator) {
+    nextProc (&Dispatch::DestroyCommandPool)(device, pool, allocator);
+    {
+        std::lock_guard lock(tracker.mutex);
+        if (tracks(device)) {
+            tracker.pools.erase(pool);
+            for (auto& e : tracker.commands.entries) {
+                if (e.handle && e.value.pool == pool) {
+                    e = {};
+                    e.tombstone = true;
+                }
+            }
+        }
+    }
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+AllocateCommandBuffers(VkDevice device,
+                       const VkCommandBufferAllocateInfo* info,
+                       VkCommandBuffer* buffers) {
+    const auto result =
+        nextProc(&Dispatch::AllocateCommandBuffers)(device, info, buffers);
+    if (result != VK_SUCCESS || !info || !buffers)
+        return result;
+    std::lock_guard lock(tracker.mutex);
+    const auto* pool = tracker.pools.find(info->commandPool);
+    if (!tracks(device) || !pool || pool->protectedPool || info->pNext ||
+        info->level != VK_COMMAND_BUFFER_LEVEL_PRIMARY ||
+        info->commandBufferCount > tracker.commands.entries.size()) {
+        return result;
+    }
+    for (uint32_t i = 0; i < info->commandBufferCount; ++i) {
+        tracker.commands.put(buffers[i], {info->commandPool, info->level});
+    }
+    return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL FreeCommandBuffers(VkDevice device,
+                                              VkCommandPool pool,
+                                              uint32_t count,
+                                              const VkCommandBuffer* buffers) {
+    nextProc (&Dispatch::FreeCommandBuffers)(device, pool, count, buffers);
+    {
+        std::lock_guard lock(tracker.mutex);
+        if (tracks(device) && buffers) {
+            if (count <= tracker.commands.entries.size()) {
+                for (uint32_t i = 0; i < count; ++i)
+                    tracker.commands.erase(buffers[i]);
+            } else {
+                for (auto& e : tracker.commands.entries) {
+                    if (e.handle && e.value.pool == pool)
+                        e.value.valid = false;
+                }
+            }
+        }
+    }
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+BeginCommandBuffer(VkCommandBuffer buffer,
+                   const VkCommandBufferBeginInfo* info) {
+    const auto result = nextProc(&Dispatch::BeginCommandBuffer)(buffer, info);
+    std::lock_guard lock(tracker.mutex);
+    auto* command = tracker.commands.find(buffer);
+    if (!tracker.usable || !command)
+        return result;
+    if (result == VK_SUCCESS) {
+        resetCommand(*command);
+        if (info) command->usage = info->flags;
+        if (info && !info->pNext &&
+            info->flags == VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT) {
+            command->generation = tracker.nextGeneration();
+            command->open = true;
+            command->valid = true;
+        }
+    } else {
+        command->open = false;
+        command->valid = false;
+    }
+    return result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL EndCommandBuffer(VkCommandBuffer buffer) {
+    const auto result = nextProc(&Dispatch::EndCommandBuffer)(buffer);
+    std::lock_guard lock(tracker.mutex);
+    if (auto* command = tracker.commands.find(buffer)) {
+        command->valid =
+            command->valid && !command->inRenderPass && result == VK_SUCCESS;
+        command->open = false;
+    }
+    return result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+ResetCommandBuffer(VkCommandBuffer buffer, VkCommandBufferResetFlags flags) {
+    const auto result = nextProc(&Dispatch::ResetCommandBuffer)(buffer, flags);
+    if (result == VK_SUCCESS) {
+        std::lock_guard lock(tracker.mutex);
+        if (auto* command = tracker.commands.find(buffer))
+            resetCommand(*command);
+    }
+    return result;
+}
+
+VKAPI_ATTR void VKAPI_CALL CmdBeginRenderPass(VkCommandBuffer buffer,
+                                              const VkRenderPassBeginInfo* info,
+                                              VkSubpassContents contents) {
+    nextProc (&Dispatch::CmdBeginRenderPass)(buffer, info, contents);
+    std::lock_guard lock(tracker.mutex);
+    if (auto* command = tracker.commands.find(buffer);
+        command && command->open) {
+        command->inRenderPass = true;
+        command->sawColorDraw = false;
+        command->active = {};
+        if (info && !info->pNext && contents == VK_SUBPASS_CONTENTS_INLINE) {
+            command->active = {info->framebuffer, info->renderPass,
+                               info->renderArea};
+        }
+    }
+}
+
+struct RenderPassState {
+    const Pass* pass;
+    const Framebuffer* framebuffer;
+};
+
+std::optional<RenderPassState> activePass(const Command& command) {
+    const auto* framebuffer =
+        tracker.framebuffers.find(command.active.framebuffer);
+    const auto* pass = tracker.passes.find(command.active.pass);
+    if (!command.valid || !command.open || !command.inRenderPass || !framebuffer || !pass) {
+        return std::nullopt;
+    }
+    if ((framebuffer->pass != command.active.pass ||
+         framebuffer->passGeneration != pass->generation) &&
+        (!framebuffer->layout || framebuffer->layout != pass->layout)) {
+        return std::nullopt;
+    }
+    return RenderPassState{pass, framebuffer};
+}
+
+const View* colorView(const RenderPassState& active, uint32_t i) {
+    const auto& attachment = active.pass->attachments[i];
+    const auto* view = tracker.views.find(active.framebuffer->views[i]);
+    if (!view || view->generation != active.framebuffer->viewGenerations[i] ||
+        view->format != attachment.format ||
+        attachment.colorLayout != VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL ||
+        attachment.store != VK_ATTACHMENT_STORE_OP_STORE) {
+        return nullptr;
+    }
+    return view;
+}
+
+void rememberRendered(Command& command) {
+    const auto active = activePass(command);
+    if (!active)
+        return;
+    for (uint32_t i = 0; i < active->pass->count; ++i) {
+        const auto* view = colorView(*active, i);
+        if (!view ||
+            (active->pass->attachments[i].load != VK_ATTACHMENT_LOAD_OP_CLEAR &&
+             !command.sawColorDraw)) {
+            continue;
+        }
+        const auto existing = std::find(command.rendered.begin(),
+                                        command.rendered.end(), view->image);
+        if (existing != command.rendered.end())
+            continue;
+        // Forgetting an older image only loses positive evidence for it.
+        // Intermediate targets must not invalidate the command recording.
+        command.rendered[command.nextRendered] = view->image;
+        command.nextRendered = (command.nextRendered + 1) % command.rendered.size();
+    }
+}
+
+VKAPI_ATTR void VKAPI_CALL CmdEndRenderPass(VkCommandBuffer buffer) {
+    EndContext current{buffer, 0};
+    {
+        std::lock_guard lock(tracker.mutex);
+        if (const auto* command = tracker.commands.find(buffer);
+            tracker.usable && command && activePass(*command)) {
+            current.generation = command->generation;
+        }
+    }
+    const auto* previous = endContext;
+    endContext = &current;
+    nextProc (&Dispatch::CmdEndRenderPass)(buffer);
+    endContext = previous;
+    std::lock_guard lock(tracker.mutex);
+    if (auto* command = tracker.commands.find(buffer)) {
+        rememberRendered(*command);
+        command->active = {};
+        command->inRenderPass = false;
+    }
+}
+
+void noteColorDraw(VkCommandBuffer buffer) {
+    std::lock_guard lock(tracker.mutex);
+    if (auto* command = tracker.commands.find(buffer);
+        command && command->inRenderPass) {
+        command->sawColorDraw = true;
+    }
+}
+
+VKAPI_ATTR void VKAPI_CALL CmdDraw(VkCommandBuffer buffer,
+                                   uint32_t vertices,
+                                   uint32_t instances,
+                                   uint32_t firstVertex,
+                                   uint32_t firstInstance) {
+    nextProc (&Dispatch::CmdDraw)(buffer, vertices, instances, firstVertex,
+                                  firstInstance);
+    if (vertices && instances)
+        noteColorDraw(buffer);
+}
+
+VKAPI_ATTR void VKAPI_CALL CmdDrawIndexed(VkCommandBuffer buffer,
+                                          uint32_t indices,
+                                          uint32_t instances,
+                                          uint32_t firstIndex,
+                                          int32_t vertexOffset,
+                                          uint32_t firstInstance) {
+    nextProc (&Dispatch::CmdDrawIndexed)(buffer, indices, instances, firstIndex,
+                                         vertexOffset, firstInstance);
+    if (indices && instances)
+        noteColorDraw(buffer);
+}
+
+}  // namespace
+
+PFN_vkVoidFunction WrapRenderEvidenceProc(VkDevice device,
+                                          const char* name,
+                                          PFN_vkVoidFunction next) {
+    if (!device || !name || !next)
+        return next;
+    std::lock_guard lock(tracker.mutex);
+    if (tracker.device && tracker.device != device)
+        return next;
+
+#define HOOK(op)                                               \
+    if (std::strcmp(name, "vk" #op) == 0) {                    \
+        if (!tracker.device) {                                 \
+            tracker.dispatch = {};                             \
+            tracker.device = device;                           \
+            tracker.usable = true;                             \
+        }                                                      \
+        auto& stored = tracker.dispatch.op;                    \
+        const auto typed = reinterpret_cast<PFN_vk##op>(next); \
+        if (typed == op)                                       \
+            return next;                                       \
+        if (stored && stored != typed) {                       \
+            tracker.usable = false;                            \
+            return next;                                       \
+        }                                                      \
+        stored = typed;                                        \
+        return reinterpret_cast<PFN_vkVoidFunction>(op);       \
+    }
+    ATHENS_RENDER_PROCS(HOOK)
+#undef HOOK
+    return next;
+}
+
+void ForgetRenderEvidenceDevice(VkDevice device) {
+    std::lock_guard lock(tracker.mutex);
+    if (tracker.device != device)
+        return;
+    tracker.usable = false;
+    tracker.device = VK_NULL_HANDLE;
+    tracker.images.clear();
+    tracker.views.clear();
+    tracker.passes.clear();
+    tracker.framebuffers.clear();
+    tracker.pools.clear();
+    tracker.commands.clear();
+}
+
+std::optional<RenderEvidence> GetRenderEvidence(VkDevice device,
+                                                VkImage image,
+                                                VkCommandBuffer buffer,
+                                                uint32_t width,
+                                                uint32_t height) {
+    if (!endContext || endContext->commandBuffer != buffer || endContext->generation == 0 || !image) {
+        static std::once_flag logged;
+        std::call_once(logged, [&] {
+            std::lock_guard lock(tracker.mutex);
+            const auto* command = tracker.commands.find(buffer);
+            const auto* fb = command ? tracker.framebuffers.find(command->active.framebuffer) : nullptr;
+            const auto* pass = command ? tracker.passes.find(command->active.pass) : nullptr;
+            ALOGI("Athens MiVK render context: wrapped=%d matchingBuffer=%d device=%d "
+                  "command=%d usage=%#x open=%d valid=%d inPass=%d pass=%d framebuffer=%d image=%d "
+                  "samePass=%d sameGeneration=%d creationLayout=%d activeLayout=%d layoutMatch=%d",
+                  endContext != nullptr, endContext && endContext->commandBuffer == buffer,
+                  tracks(device), command != nullptr, command ? command->usage : 0,
+                  command && command->open, command && command->valid, command && command->inRenderPass,
+                  pass != nullptr, fb != nullptr, tracker.images.find(image) != nullptr,
+                  fb && fb->pass == command->active.pass, fb && pass && fb->passGeneration == pass->generation,
+                  fb && fb->layout, pass && pass->layout, fb && pass && fb->layout && fb->layout == pass->layout);
+        });
+        return std::nullopt;
+    }
+    std::lock_guard lock(tracker.mutex);
+    if (!tracks(device))
+        return std::nullopt;
+    const auto* command = tracker.commands.find(buffer);
+    if (!command || command->generation != endContext->generation)
+        return std::nullopt;
+    const auto active = activePass(*command);
+    const auto* underlying = tracker.images.find(image);
+    const auto* pool = tracker.pools.find(command->pool);
+    if (!active || !underlying || !pool || active->pass->count != 2 ||
+        active->pass->colorCount != 1 || active->pass->hasResolve || !width ||
+        !height || width > 4096 || height > 4096 ||
+        width != active->framebuffer->extent.width ||
+        height != active->framebuffer->extent.height ||
+        command->active.renderArea.offset.x != 0 ||
+        command->active.renderArea.offset.y != 0 ||
+        width != command->active.renderArea.extent.width ||
+        height != command->active.renderArea.extent.height) {
+        static std::once_flag logged;
+        std::call_once(logged, [&] {
+            ALOGI("Athens MiVK render pass: tracked=%d image=%d pool=%d attachments=%u "
+                  "colors=%u resolve=%d source=%ux%u framebuffer=%ux%u area=%d,%d %ux%u",
+                  active.has_value(), underlying != nullptr, pool != nullptr,
+                  active ? active->pass->count : 0, active ? active->pass->colorCount : 0,
+                  active && active->pass->hasResolve, width, height,
+                  active ? active->framebuffer->extent.width : 0,
+                  active ? active->framebuffer->extent.height : 0,
+                  command->active.renderArea.offset.x, command->active.renderArea.offset.y,
+                  command->active.renderArea.extent.width, command->active.renderArea.extent.height);
+        });
+        return std::nullopt;
+    }
+
+    const auto& info = underlying->info;
+    if (info.flags & (VK_IMAGE_CREATE_PROTECTED_BIT |
+                      VK_IMAGE_CREATE_SPARSE_BINDING_BIT) ||
+        info.imageType != VK_IMAGE_TYPE_2D || info.format != kVectorFormat ||
+        info.extent.width < width || info.extent.height < height ||
+        info.extent.depth != 1 || info.arrayLayers != 1 ||
+        info.mipLevels != 1 || info.samples != VK_SAMPLE_COUNT_1_BIT ||
+        info.tiling != VK_IMAGE_TILING_OPTIMAL ||
+        info.sharingMode != VK_SHARING_MODE_EXCLUSIVE ||
+        (info.usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                       VK_IMAGE_USAGE_TRANSFER_SRC_BIT)) !=
+            (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+             VK_IMAGE_USAGE_TRANSFER_SRC_BIT)) {
+        static std::once_flag logged;
+        std::call_once(logged, [&] {
+            ALOGI("Athens MiVK source image: format=%d usage=%#x flags=%#x extent=%ux%ux%u "
+                  "mips=%u layers=%u samples=%u tiling=%d sharing=%d", info.format, info.usage,
+                  info.flags, info.extent.width, info.extent.height, info.extent.depth,
+                  info.mipLevels, info.arrayLayers, info.samples, info.tiling, info.sharingMode);
+        });
+        return std::nullopt;
+    }
+    for (uint32_t i = 0; i < 2; ++i) {
+        const auto& attachment = active->pass->attachments[i];
+        const auto* view = colorView(*active, i);
+        if (view && view->image == image &&
+            view->imageGeneration == underlying->generation &&
+            attachment.format == kVectorFormat &&
+            attachment.samples == VK_SAMPLE_COUNT_1_BIT &&
+            attachment.finalLayout ==
+                VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL &&
+            active->pass->depthAttachment == 1 - i &&
+            active->pass->attachments[1 - i].format ==
+                VK_FORMAT_D24_UNORM_S8_UINT &&
+            (attachment.load == VK_ATTACHMENT_LOAD_OP_CLEAR ||
+             command->sawColorDraw)) {
+            return RenderEvidence{
+                .source = {.image = image,
+                           .format = info.format,
+                           .extent = {width, height},
+                           .usage = info.usage,
+                           .flags = info.flags,
+                           .tiling = info.tiling,
+                           .samples = info.samples,
+                           .layout = attachment.finalLayout,
+                           .queueFamily = pool->family,
+                           .beforeStages =
+                               VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                           .beforeAccess = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+                           .afterStages =
+                               VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                           .afterAccess = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT},
+                .recording = {device, buffer, command->generation,
+                              command->level, command->usage},
+                .queueFamily = pool->family,
+            };
+        }
+    }
+    static std::once_flag logged;
+    std::call_once(logged, [&] {
+        for (uint32_t i = 0; i < 2; ++i) {
+            const auto& a = active->pass->attachments[i];
+            const auto* view = tracker.views.find(active->framebuffer->views[i]);
+            ALOGI("Athens MiVK attachment %u: format=%d source=%d samples=%u load=%d store=%d "
+                  "colorLayout=%d finalLayout=%d depthIndex=%u drew=%d", i, a.format,
+                  view && view->image == image, a.samples, a.load, a.store, a.colorLayout,
+                  a.finalLayout, active->pass->depthAttachment, command->sawColorDraw);
+        }
+    });
+    return std::nullopt;
+}
+
+bool DidRenderImage(VkCommandBuffer buffer, VkImage image) {
+    if (!image)
+        return false;
+    std::lock_guard lock(tracker.mutex);
+    const auto* command = tracker.commands.find(buffer);
+    return tracker.usable && command && command->valid && !command->open &&
+           std::find(command->rendered.begin(), command->rendered.end(),
+                     image) != command->rendered.end();
+}
+
+std::optional<AthensVulkanFrameWitness::Recording> GetClosedRecording(VkCommandBuffer buffer) {
+    std::lock_guard lock(tracker.mutex);
+    const auto* command = tracker.commands.find(buffer);
+    if (!tracker.usable || !command || !command->valid || command->open ||
+        command->level != VK_COMMAND_BUFFER_LEVEL_PRIMARY) {
+        return std::nullopt;
+    }
+    return AthensVulkanFrameWitness::Recording{tracker.device, buffer, command->generation,
+                                               command->level, command->usage};
+}
+
+bool StillRecording(VkCommandBuffer buffer) {
+    std::lock_guard lock(tracker.mutex);
+    const auto* command = tracker.commands.find(buffer);
+    return tracker.usable && command && command->open && command->valid;
+}
+
+bool IsRecordingGeneration(VkCommandBuffer buffer, uint64_t generation) {
+    if (!generation)
+        return false;
+    std::lock_guard lock(tracker.mutex);
+    const auto* command = tracker.commands.find(buffer);
+    return command && command->generation == generation;
+}
+
+}  // namespace vulkan::athens
