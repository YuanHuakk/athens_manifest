+void HWComposer::setAthensMotionVectorPresentDeadline(PhysicalDisplayId displayId,
+                                                       std::optional<nsecs_t> deadline) {
+    if (auto display = mDisplayData.find(displayId); display != mDisplayData.end()) {
+        display->second.athensMotionVectorPresentDeadline = deadline;
+    }
+}
+
+void HWComposer::waitForAthensMotionVectorPresent(DisplayData& displayData) {
+    constexpr nsecs_t kMaxWaitNs = 2'000'000;
+    constexpr nsecs_t kPostRetireGapNs = 500'000;
+    const auto deadline = std::exchange(displayData.athensMotionVectorPresentDeadline, std::nullopt);
+    const auto& fence = displayData.lastPresentFence;
+    if (!deadline || !fence || !fence->isValid()) return;
+
+    const nsecs_t now = systemTime();
+    const nsecs_t stop = std::min(*deadline, now + kMaxWaitNs);
+    if (now >= stop) return;
+
+    auto signalTime = fence->getSignalTime();
+    if (signalTime == Fence::SIGNAL_TIME_PENDING) {
+        const nsecs_t remaining = stop - systemTime();
+        if (remaining <= 0) return;
+        SFTRACE_NAME("Athens EMV wait for previous present");
+        pollfd fd{.fd = fence->get(), .events = POLLIN, .revents = 0};
+        const timespec timeout{.tv_sec = 0, .tv_nsec = static_cast<long>(remaining)};
+        if (ppoll(&fd, 1, &timeout, nullptr) <= 0 || !(fd.revents & POLLIN)) return;
+        signalTime = fence->getSignalTime();
+    }
+    if (!Fence::isValidTimestamp(signalTime)) return;
+
+    // The 406 connector retire fence closely precedes post-kickoff. Allow its
+    // queued worker time to take the old packet before this atomic property write.
+    const nsecs_t remaining = std::min(stop, signalTime + kPostRetireGapNs) - systemTime();
+    if (remaining > 0) {
+        SFTRACE_NAME("Athens EMV retire gap");
+        std::this_thread::sleep_for(std::chrono::nanoseconds(remaining));
+    }
+}
