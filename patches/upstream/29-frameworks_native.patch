+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <optional>
+
+#include <android-base/unique_fd.h>
+#include <binder/IBinder.h>
+#include <gui/Surface.h>
+
+#include "AthensVulkanFrameWitness.h"
+
+namespace vulkan::athens {
+
+class AthensMotionVectorProducer;
+class AthensMotionVectorChannel;
+
+// Only the authenticated producer creates a target after SurfaceFlinger binds the supplied
+// game layer handle to the active UID, PID, task and session. The Surface must be retained from
+// a trusted typed platform handoff, independently of the application's ANativeWindow pointer.
+class AuthorizedPresentTarget {
+private:
+    friend class AthensMotionVectorProducer;
+    friend class AthensMotionVectorChannel;
+    friend class ScopedPresentCapture;
+
+    AuthorizedPresentTarget(const android::sp<android::Surface>& surface,
+                            const android::sp<android::IBinder>& layerHandle,
+                            int32_t layerId, int64_t generation)
+          : mSurface(surface),
+            mLayerHandle(layerHandle),
+            mLayerId(layerId),
+            mGeneration(generation) {}
+
+    const android::sp<android::Surface> mSurface;
+    const android::sp<android::IBinder> mLayerHandle;
+    const int32_t mLayerId;
+    const int64_t mGeneration;
+};
+
+struct PresentMetadata {
+    VkQueue queue;
+    VkSwapchainKHR swapchain;
+    VkImage image;
+    uint32_t imageIndex;
+    VkSemaphore waitSemaphore;
+    uint64_t nextFrameNumber;
+    uint64_t gameBufferId;
+    android::base::unique_fd acquireFence;
+    android::sp<android::IBinder> layerHandle;
+    int32_t layerId;
+    int64_t generation;
+
+    [[nodiscard]] AthensVulkanFrameWitness::Enqueue enqueue() const {
+        return {VK_SUCCESS, android::OK, nextFrameNumber, acquireFence.get()};
+    }
+};
+
+// Install immediately around one downstream vkQueuePresentKHR on the calling thread. WSI may
+// populate one result. Claiming and completing capture never calls the producer or SurfaceFlinger.
+class ScopedPresentCapture {
+public:
+    ScopedPresentCapture(const AuthorizedPresentTarget& target, VkQueue queue,
+                         VkSwapchainKHR swapchain, uint32_t imageIndex, VkSemaphore waitSemaphore);
+    ~ScopedPresentCapture();
+
+    ScopedPresentCapture(const ScopedPresentCapture&) = delete;
+    ScopedPresentCapture& operator=(const ScopedPresentCapture&) = delete;
+
+    [[nodiscard]] std::optional<PresentMetadata> take();
+
+    // WSI implementation. The caller has already verified an active single, non-shared swapchain.
+    static ScopedPresentCapture* claim(ANativeWindow* window, VkQueue queue, VkSwapchainKHR swapchain,
+                                       uint32_t imageIndex, VkSemaphore waitSemaphore);
+    android::Surface& surface() const { return *mTarget.mSurface; }
+    void complete(VkImage image, uint64_t nextFrameNumber, uint64_t gameBufferId,
+                  android::base::unique_fd acquireFence);
+
+private:
+    static thread_local ScopedPresentCapture* sCurrent;
+
+    const AuthorizedPresentTarget mTarget;
+    const VkQueue mQueue;
+    const VkSwapchainKHR mSwapchain;
+    const uint32_t mImageIndex;
+    const VkSemaphore mWaitSemaphore;
+    ScopedPresentCapture* const mPrevious;
+    bool mClaimed = false;
+    std::optional<PresentMetadata> mPresent;
+};
+
+} // namespace vulkan::athens
+
+namespace vulkan::driver {
+
+// The swapchain handle must be live and externally synchronized by the Vulkan caller.
+android::sp<android::Surface> FindActiveAthensPlatformSurface(VkSwapchainKHR swapchain);
+VkImage FindAcquiredAthensPresentImage(VkSwapchainKHR swapchain, uint32_t imageIndex);
+
+} // namespace vulkan::driver
