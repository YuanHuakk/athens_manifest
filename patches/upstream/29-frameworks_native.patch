+TEST_F(FpsReporterTest, reportsEachTaskToAllItsListeners) {
+    constexpr int32_t kTaskId = 12;
+    constexpr int32_t kOtherTaskId = 13;
+    LayerMetadata taskMetadata;
+    taskMetadata.setInt32(gui::METADATA_TASK_ID, kTaskId);
+    LayerMetadata otherTaskMetadata;
+    otherTaskMetadata.setInt32(gui::METADATA_TASK_ID, kOtherTaskId);
+    createRootLayer(1, taskMetadata);
+    createLayer(11, 1);
+    createRootLayer(2, otherTaskMetadata);
+    createLayer(21, 2);
+
+    frontend::LayerHierarchyBuilder hierarchyBuilder;
+    hierarchyBuilder.update(mLifecycleManager);
+
+    constexpr float kTaskFps = 44.f;
+    constexpr float kOtherTaskFps = 53.f;
+    EXPECT_CALL(mFrameTimeline, computeFps(UnorderedElementsAre(1, 11))).WillOnce(Return(kTaskFps));
+    EXPECT_CALL(mFrameTimeline, computeFps(UnorderedElementsAre(2, 21)))
+            .WillOnce(Return(kOtherTaskFps));
+
+    const auto secondListener = sp<TestableFpsListener>::make();
+    const auto otherTaskListener = sp<TestableFpsListener>::make();
+    mFpsReporter->addListener(mFpsListener, kTaskId);
+    mFpsReporter->addListener(secondListener, kTaskId);
+    mFpsReporter->addListener(otherTaskListener, kOtherTaskId);
+    mClock->advanceTime(600ms);
+    mFpsReporter->dispatchLayerFps(hierarchyBuilder.getHierarchy());
+
+    EXPECT_EQ(kTaskFps, mFpsListener->lastReportedFps);
+    EXPECT_EQ(kTaskFps, secondListener->lastReportedFps);
+    EXPECT_EQ(kOtherTaskFps, otherTaskListener->lastReportedFps);
+}
