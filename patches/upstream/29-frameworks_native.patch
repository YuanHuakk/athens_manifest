@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include "AthensMotionVectorImage.h"
+#include "AthensVulkanFrameWitness.h"
+
+#include <optional>
+
+namespace vulkan::athens {
+
+struct RenderEvidence {
+    AthensMotionVectorImage::Source source;
+    AthensVulkanFrameWitness::Recording recording;
+    uint32_t queueFamily;
+};
+
+// Install only for the device selected by the Athens MiVK layer.
+PFN_vkVoidFunction WrapRenderEvidenceProc(VkDevice device,
+                                          const char* name,
+                                          PFN_vkVoidFunction next);
+void ForgetRenderEvidenceDevice(VkDevice device);
+
+// Valid only in the same thread during the OEM PostCmdEndRenderPass callback.
+std::optional<RenderEvidence> GetRenderEvidence(VkDevice device,
+                                                VkImage image,
+                                                VkCommandBuffer commandBuffer,
+                                                uint32_t width,
+                                                uint32_t height);
+bool DidRenderImage(VkCommandBuffer commandBuffer, VkImage image);
+std::optional<AthensVulkanFrameWitness::Recording> GetClosedRecording(VkCommandBuffer commandBuffer);
+bool StillRecording(VkCommandBuffer commandBuffer);
+// A successful end keeps the generation alive. Reset/free/pool teardown remove
+// it.
+bool IsRecordingGeneration(VkCommandBuffer commandBuffer, uint64_t generation);
+
+}  // namespace vulkan::athens
diff --git a/vulkan/libvulkan/AthensMiVkRuntime.cpp b/vulkan/libvulkan/AthensMiVkRuntime.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..265799f3e51bfd20ddca2cdbc7e8309bdd6d29ce
--- /dev/null
+++ b/vulkan/libvulkan/AthensMiVkRuntime.cpp
@@ -0,0 +1,896 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#include "AthensMiVkRuntime.h"
+
+#include <fcntl.h>
+#include <inttypes.h>
+#include <log/log.h>
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <mutex>
+#include <string_view>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "AthensMiVkRenderEvidence.h"
+#include "AthensMotionVectorChannel.h"
+#include "driver.h"
+
+namespace vulkan::athens {
+namespace {
+
+using Clock = std::chrono::steady_clock;
+using Witness = AthensVulkanFrameWitness;
+using android::base::unique_fd;
+constexpr auto kChannelCheckInterval = std::chrono::milliseconds(500);
+constexpr size_t kMaxInFlightWrites = 2;
+
+template <typename Proc, typename Provider, typename Handle>
+Proc lookup(Provider provider, Handle handle, const char* name) {
+    return provider ? reinterpret_cast<Proc>(provider(handle, name)) : nullptr;
+}
+
+void GetLowerFormatProperties(VkPhysicalDevice device,
+                              VkFormat format,
+                              VkFormatProperties* out) {
+    const auto& dispatch = driver::GetData(device).driver;
+    VkFormatProperties2 properties{};
+    properties.sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2;
+    if (dispatch.GetPhysicalDeviceFormatProperties2) {
+        dispatch.GetPhysicalDeviceFormatProperties2(device, format,
+                                                    &properties);
+    } else if (dispatch.GetPhysicalDeviceFormatProperties2KHR) {
+        dispatch.GetPhysicalDeviceFormatProperties2KHR(device, format,
+                                                       &properties);
+    }
+    *out = properties.formatProperties;
+}
+
+AthensMotionVectorImage::Dispatch GetLowerImageDispatch(VkDevice device) {
+    const auto get = driver::GetData(device).driver.GetDeviceProcAddr;
+    return {
+        .getFormatProperties = GetLowerFormatProperties,
+        .getHardwareBufferProperties =
+            lookup<PFN_vkGetAndroidHardwareBufferPropertiesANDROID>(
+                get, device, "vkGetAndroidHardwareBufferPropertiesANDROID"),
+        .createImage = lookup<PFN_vkCreateImage>(get, device, "vkCreateImage"),
+        .destroyImage =
+            lookup<PFN_vkDestroyImage>(get, device, "vkDestroyImage"),
+        .allocateMemory =
+            lookup<PFN_vkAllocateMemory>(get, device, "vkAllocateMemory"),
+        .freeMemory = lookup<PFN_vkFreeMemory>(get, device, "vkFreeMemory"),
+        .bindImageMemory =
+            lookup<PFN_vkBindImageMemory>(get, device, "vkBindImageMemory"),
+        .cmdPipelineBarrier = lookup<PFN_vkCmdPipelineBarrier>(
+            get, device, "vkCmdPipelineBarrier"),
+        .cmdBlitImage =
+            lookup<PFN_vkCmdBlitImage>(get, device, "vkCmdBlitImage"),
+        .createFence = lookup<PFN_vkCreateFence>(get, device, "vkCreateFence"),
+        .destroyFence = lookup<PFN_vkDestroyFence>(get, device, "vkDestroyFence"),
+        .getFenceStatus = lookup<PFN_vkGetFenceStatus>(get, device, "vkGetFenceStatus"),
+        .queueSubmit = lookup<PFN_vkQueueSubmit>(get, device, "vkQueueSubmit"),
+    };
+}
+
+struct Job {
+    Witness::VectorSlot slot;
+    Witness::Recording recording;
+    Witness::ColorFrame color;
+    AthensMotionVectorChannel::Slot buffer;
+    std::unique_ptr<AthensMotionVectorImage> image;
+    MotionVectorLayout layout;
+    uint64_t surfaceGeneration;
+    VkQueue submittedQueue = VK_NULL_HANDLE;
+    bool discard = false;
+};
+
+struct PublishedWrite {
+    uint64_t bufferId;
+    std::unique_ptr<AthensMotionVectorImage> image;
+};
+
+class Producer {
+   public:
+    PFN_vkVoidFunction wrap(VkDevice device,
+                            const char* name,
+                            PFN_vkVoidFunction next);
+
+    template <typename Proc>
+    Proc next(VkDevice device, const char* name) {
+        std::lock_guard lock(mMutex);
+        const auto dev = mNext.find(device);
+        if (dev == mNext.end())
+            return nullptr;
+        const auto proc = dev->second.find(name);
+        return proc == dev->second.end() ? nullptr
+                                         : reinterpret_cast<Proc>(proc->second);
+    }
+
+    bool armed();
+    VkResult record(const AthensMiVkRenderInput& input);
+    void retire(uint64_t surfaceGeneration);
+    void acquire(VkDevice device,
+                 VkSwapchainKHR swapchain,
+                 uint32_t index,
+                 VkSemaphore signal);
+    void end(VkCommandBuffer command, VkResult result);
+    void submit(VkQueue queue,
+                uint32_t count,
+                const VkSubmitInfo* batches,
+                VkResult result);
+    void submit2(VkQueue queue, uint32_t count, const VkSubmitInfo2* batches, VkResult result);
+    VkResult present(VkDevice device,
+                     VkQueue queue,
+                     const VkPresentInfoKHR* info,
+                     PFN_vkQueuePresentKHR next);
+    void semaphore(VkDevice device, VkSemaphore handle, bool createdBinary);
+    void idle(VkDevice device, bool destroying);
+    void forgetDevice(VkDevice device);
+    void destroySwapchain(VkDevice device, VkSwapchainKHR swapchain);
+
+   private:
+    bool canRecord() const {
+        return mChannel && mAcquired.size() == 1 && !mJob &&
+               mPublishedWrites.size() < kMaxInFlightWrites;
+    }
+    void collect();
+    void fenceDiscardIfOnQueue(VkQueue queue);
+    void dropJob();
+    void invalidateSignal();
+    bool containsBinary(VkSemaphore handle) const {
+        return mBinarySemaphores.contains(handle);
+    }
+
+    std::mutex mMutex;
+    std::unordered_map<VkDevice,
+                       std::unordered_map<std::string_view, PFN_vkVoidFunction>>
+        mNext;
+    std::unordered_set<VkSemaphore> mBinarySemaphores;
+    std::unordered_set<uint64_t> mVisitedBuffers;
+    std::optional<AthensMotionVectorChannel> mChannel;
+    std::unordered_map<uint32_t, Witness::ColorFrame> mAcquired;
+    std::optional<Job> mJob;
+    // WSI and SurfaceFlinger may have accepted a frame while its GPU write is pending.
+    // Keep the imports alive until their own fences signal, independently of pairing.
+    std::vector<PublishedWrite> mPublishedWrites;
+    Witness mWitness;
+    Witness::Semaphore mCurrentSignal{};
+    VkQueue mCompletionQueue = VK_NULL_HANDLE;
+    Clock::time_point mNextChannelCheck{};
+    VkDevice mDevice = VK_NULL_HANDLE;
+    VkSwapchainKHR mSwapchain = VK_NULL_HANDLE;
+    uint64_t mSwapchainGeneration = 0;
+    uint64_t mSlotGeneration = 0;
+    uint64_t mSignalGeneration = 0;
+    bool mLoggedFirstRecording = false;
+    bool mLoggedFirstVector = false;
+};
+
+Producer& State() {
+    static auto* state = new Producer;
+    return *state;
+}
+
+VkDevice DeviceFor(VkQueue queue) {
+    return driver::GetData(queue).driver_device;
+}
+VkDevice DeviceFor(VkCommandBuffer command) {
+    return driver::GetData(command).driver_device;
+}
+
+VKAPI_ATTR VkResult Acquire(VkDevice device,
+                            VkSwapchainKHR swapchain,
+                            uint64_t timeout,
+                            VkSemaphore semaphore,
+                            VkFence fence,
+                            uint32_t* index) {
+    const auto next = State().next<PFN_vkAcquireNextImageKHR>(
+        device, "vkAcquireNextImageKHR");
+    const auto result =
+        next(device, swapchain, timeout, semaphore, fence, index);
+    if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR) {
+        State().acquire(device, swapchain, *index, semaphore);
+    }
+    return result;
+}
+
+VKAPI_ATTR VkResult Acquire2(VkDevice device,
+                             const VkAcquireNextImageInfoKHR* info,
+                             uint32_t* index) {
+    const auto next = State().next<PFN_vkAcquireNextImage2KHR>(
+        device, "vkAcquireNextImage2KHR");
+    const auto result = next(device, info, index);
+    if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR) {
+        State().acquire(device, info->swapchain, *index, info->semaphore);
+    }
+    return result;
+}
+
+VKAPI_ATTR VkResult End(VkCommandBuffer command) {
+    const auto next = State().next<PFN_vkEndCommandBuffer>(
+        DeviceFor(command), "vkEndCommandBuffer");
+    const auto result = next(command);
+    State().end(command, result);
+    return result;
+}
+
+VKAPI_ATTR VkResult Submit(VkQueue queue,
+                           uint32_t count,
+                           const VkSubmitInfo* batches,
+                           VkFence fence) {
+    const auto next =
+        State().next<PFN_vkQueueSubmit>(DeviceFor(queue), "vkQueueSubmit");
+    const auto result = next(queue, count, batches, fence);
+    State().submit(queue, count, batches, result);
+    return result;
+}
+
+VkResult Submit2Named(VkQueue queue,
+                      uint32_t count,
+                      const VkSubmitInfo2* batches,
+                      VkFence fence,
+                      const char* name) {
+    const auto next = State().next<PFN_vkQueueSubmit2>(DeviceFor(queue), name);
+    const auto result = next(queue, count, batches, fence);
+    State().submit2(queue, count, batches, result);
+    return result;
+}
+
+VKAPI_ATTR VkResult Submit2(VkQueue queue,
+                            uint32_t count,
+                            const VkSubmitInfo2* batches,
+                            VkFence f) {
+    return Submit2Named(queue, count, batches, f, "vkQueueSubmit2");
+}
+
+VKAPI_ATTR VkResult Submit2Khr(VkQueue queue,
+                               uint32_t count,
+                               const VkSubmitInfo2* batches,
+                               VkFence f) {
+    return Submit2Named(queue, count, batches, f, "vkQueueSubmit2KHR");
+}
+
+VKAPI_ATTR VkResult Present(VkQueue queue, const VkPresentInfoKHR* info) {
+    const VkDevice device = DeviceFor(queue);
+    return State().present(
+        device, queue, info,
+        State().next<PFN_vkQueuePresentKHR>(device, "vkQueuePresentKHR"));
+}
+
+VKAPI_ATTR VkResult CreateSemaphore(VkDevice device,
+                                    const VkSemaphoreCreateInfo* info,
+                                    const VkAllocationCallbacks* allocator,
+                                    VkSemaphore* handle) {
+    const auto next =
+        State().next<PFN_vkCreateSemaphore>(device, "vkCreateSemaphore");
+    const auto result = next(device, info, allocator, handle);
+    if (result == VK_SUCCESS) {
+        bool binary = true;
+        for (auto* p = static_cast<const VkBaseInStructure*>(info->pNext); p;
+             p = p->pNext) {
+            if (p->sType == VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO) {
+                binary = reinterpret_cast<const VkSemaphoreTypeCreateInfo*>(p)
+                             ->semaphoreType == VK_SEMAPHORE_TYPE_BINARY;
+                break;
+            }
+        }
+        State().semaphore(device, *handle, binary);
+    }
+    return result;
+}
+
+VKAPI_ATTR void DestroySemaphore(VkDevice device,
+                                 VkSemaphore handle,
+                                 const VkAllocationCallbacks* a) {
+    const auto next =
+        State().next<PFN_vkDestroySemaphore>(device, "vkDestroySemaphore");
+    State().semaphore(device, handle, false);
+    next(device, handle, a);
+}
+
+VKAPI_ATTR VkResult ImportSemaphore(VkDevice device,
+                                    const VkImportSemaphoreFdInfoKHR* info) {
+    const auto next = State().next<PFN_vkImportSemaphoreFdKHR>(
+        device, "vkImportSemaphoreFdKHR");
+    const auto result = next(device, info);
+    if (result == VK_SUCCESS)
+        State().semaphore(device, info->semaphore, false);
+    return result;
+}
+
+VKAPI_ATTR VkResult DeviceWaitIdle(VkDevice device) {
+    const auto next =
+        State().next<PFN_vkDeviceWaitIdle>(device, "vkDeviceWaitIdle");
+    const auto result = next(device);
+    if (result == VK_SUCCESS)
+        State().idle(device, false);
+    return result;
+}
+
+VKAPI_ATTR void DestroyDevice(VkDevice device,
+                              const VkAllocationCallbacks* allocator) {
+    const auto next =
+        State().next<PFN_vkDestroyDevice>(device, "vkDestroyDevice");
+    State().idle(device, true);
+    next(device, allocator);
+    ForgetRenderEvidenceDevice(device);
+    State().forgetDevice(device);
+}
+
+VKAPI_ATTR void DestroySwapchain(VkDevice device,
+                                 VkSwapchainKHR swapchain,
+                                 const VkAllocationCallbacks* allocator) {
+    const auto next = State().next<PFN_vkDestroySwapchainKHR>(
+        device, "vkDestroySwapchainKHR");
+    State().destroySwapchain(device, swapchain);
+    next(device, swapchain, allocator);
+}
+
+PFN_vkVoidFunction Producer::wrap(VkDevice device,
+                                  const char* name,
+                                  PFN_vkVoidFunction next) {
+    if (!device || !name || !next)
+        return next;
+    {
+        std::lock_guard lock(mMutex);
+        if (mNext.empty())
+            mNext.try_emplace(device);
+        if (!mNext.contains(device))
+            return next;
+    }
+    next = WrapRenderEvidenceProc(device, name, next);
+    const struct {
+        std::string_view name;
+        PFN_vkVoidFunction proc;
+    } wrappers[] = {
+        {"vkAcquireNextImageKHR",
+         reinterpret_cast<PFN_vkVoidFunction>(Acquire)},
+        {"vkAcquireNextImage2KHR",
+         reinterpret_cast<PFN_vkVoidFunction>(Acquire2)},
+        {"vkEndCommandBuffer", reinterpret_cast<PFN_vkVoidFunction>(End)},
+        {"vkQueueSubmit", reinterpret_cast<PFN_vkVoidFunction>(Submit)},
+        {"vkQueueSubmit2", reinterpret_cast<PFN_vkVoidFunction>(Submit2)},
+        {"vkQueueSubmit2KHR", reinterpret_cast<PFN_vkVoidFunction>(Submit2Khr)},
+        {"vkQueuePresentKHR", reinterpret_cast<PFN_vkVoidFunction>(Present)},
+        {"vkCreateSemaphore",
+         reinterpret_cast<PFN_vkVoidFunction>(CreateSemaphore)},
+        {"vkDestroySemaphore",
+         reinterpret_cast<PFN_vkVoidFunction>(DestroySemaphore)},
+        {"vkImportSemaphoreFdKHR",
+         reinterpret_cast<PFN_vkVoidFunction>(ImportSemaphore)},
+        {"vkDeviceWaitIdle",
+         reinterpret_cast<PFN_vkVoidFunction>(DeviceWaitIdle)},
+        {"vkDestroyDevice",
+         reinterpret_cast<PFN_vkVoidFunction>(DestroyDevice)},
+        {"vkDestroySwapchainKHR",
+         reinterpret_cast<PFN_vkVoidFunction>(DestroySwapchain)},
+    };
+    for (const auto& entry : wrappers) {
+        if (entry.name != name)
+            continue;
+        std::lock_guard lock(mMutex);
+        if (next != entry.proc)
+            mNext[device][entry.name] = next;
+        return entry.proc;
+    }
+    return next;
+}
+
+bool Producer::armed() {
+    std::lock_guard lock(mMutex);
+    collect();
+    const bool ready = canRecord();
+    if (ready) {
+        static std::once_flag logged;
+        std::call_once(logged, [] { ALOGI("Athens MiVK renderer queried a ready vector channel"); });
+    }
+    return ready;
+}
+
+void Producer::acquire(VkDevice device,
+                       VkSwapchainKHR swapchain,
+                       uint32_t index,
+                       VkSemaphore signal) {
+    const VkImage color =
+        driver::FindAcquiredAthensPresentImage(swapchain, index);
+    if (!color)
+        return;
+    std::lock_guard lock(mMutex);
+    collect();
+    if (mCurrentSignal.handle && mCurrentSignal.handle == signal)
+        invalidateSignal();
+    if (mDevice && mDevice != device)
+        return;
+    if (mSwapchain != swapchain) {
+        if (mJob)
+            return;
+        mChannel.reset();
+        mVisitedBuffers.clear();
+        mAcquired.clear();
+        mLoggedFirstRecording = false;
+        mLoggedFirstVector = false;
+        mNextChannelCheck = {};
+        mSwapchain = swapchain;
+        ++mSwapchainGeneration;
+    }
+    mDevice = device;
+    mAcquired.insert_or_assign(
+        index, Witness::ColorFrame{swapchain, mSwapchainGeneration, color,
+                                   index, mSwapchainGeneration});
+    const auto now = Clock::now();
+    if (!mJob && now >= mNextChannelCheck) {
+        mNextChannelCheck = now + kChannelCheckInterval;
+        if (mChannel) {
+            if (!mChannel->isRevoked()) return;
+            mChannel.reset();
+            mVisitedBuffers.clear();
+            mLoggedFirstRecording = false;
+            mLoggedFirstVector = false;
+            ALOGI("Athens MiVK released the revoked motion-vector queue");
+        }
+        if (auto channel = AthensMotionVectorChannel::open(swapchain)) {
+            mChannel.emplace(std::move(*channel));
+            ALOGI("Athens MiVK opened the authenticated motion-vector queue");
+        }
+    }
+}
+
+VkResult Producer::record(const AthensMiVkRenderInput& input) {
+    if (!input.commandBuffer || !input.sourceImage)
+        return VK_NOT_READY;
+    const auto& data = driver::GetData(input.commandBuffer);
+    const auto evidence = GetRenderEvidence(
+        data.driver_device, input.sourceImage, input.commandBuffer,
+        input.sourceExtent.width, input.sourceExtent.height);
+    if (!evidence ||
+        evidence->source.format != VK_FORMAT_A2R10G10B10_UNORM_PACK32) {
+        static std::once_flag logged;
+        std::call_once(logged, [] {
+            ALOGI("Athens MiVK received a vector source without matching render evidence");
+        });
+        return VK_NOT_READY;
+    }
+    std::lock_guard lock(mMutex);
+    collect();
+    if (!canRecord() || data.driver_device != mDevice || !data.driver_physical_device ||
+        input.vectorExtent.width != AthensMotionVectorImage::kWidth ||
+        input.vectorExtent.height != AthensMotionVectorImage::kHeight) {
+        return VK_NOT_READY;
+    }
+    auto slot = mChannel->dequeue();
+    if (!slot) {
+        static std::once_flag logged;
+        std::call_once(logged, [] { ALOGI("Athens MiVK matched a vector source but could not dequeue a slot"); });
+        return VK_NOT_READY;
+    }
+    const uint64_t id = slot->buffer->getId();
+    if (std::any_of(mPublishedWrites.begin(), mPublishedWrites.end(),
+                    [id](const PublishedWrite& write) { return write.bufferId == id; }) ||
+        (mVisitedBuffers.size() >= 16 && !mVisitedBuffers.contains(id))) {
+        mChannel->cancel(*slot, {});
+        return VK_NOT_READY;
+    }
+    const bool firstUse = mVisitedBuffers.insert(id).second;
+    const Witness::VectorSlot key{0, ++mSlotGeneration, id};
+    if (!mWitness.arm(key, evidence->recording)) {
+        mChannel->cancel(*slot, {});
+        return VK_NOT_READY;
+    }
+
+    std::unique_ptr<AthensMotionVectorImage> image;
+    VkResult result = AthensMotionVectorImage::import(
+        data.driver_physical_device, data.driver_device,
+        GetLowerImageDispatch(data.driver_device),
+        slot->buffer->toAHardwareBuffer(), image,
+        AthensMotionVectorImage::CompletionMode::PresentSyncFd);
+    AthensMotionVectorImage::Submission resultInfo{};
+    if (result == VK_SUCCESS) {
+        if (mWitness.beginVectorWrite(key, evidence->recording)) {
+            using Kind = AthensMotionVectorImage::DestinationRelease::Kind;
+            const auto kind = slot->previousRead.ok() ? Kind::SyncFd
+                    : firstUse ? Kind::Unused : Kind::DequeuedWithoutFence;
+            result = image->record(
+                input.commandBuffer, evidence->queueFamily, evidence->source,
+                {kind, slot->previousRead.get()}, resultInfo);
+        } else {
+            result = VK_NOT_READY;
+        }
+    }
+    if (result != VK_SUCCESS) {
+        static std::once_flag logged;
+        std::call_once(logged, [&] { ALOGI("Athens MiVK vector import or recording failed: %d", result); });
+        (void)mWitness.cancel();
+        mChannel->cancel(*slot, {});
+        return result;
+    }
+    if (!mWitness.finishVectorWrite(key, evidence->recording))
+        mWitness.invalidate();
+    mJob.emplace(Job{key, evidence->recording, mAcquired.begin()->second,
+                     std::move(*slot), std::move(image), resultInfo.layout,
+                     input.surfaceGeneration});
+    if (!mLoggedFirstRecording) {
+        ALOGI("Athens MiVK recorded the first game motion-vector write");
+        mLoggedFirstRecording = true;
+    }
+    return VK_SUCCESS;
+}
+
+void Producer::end(VkCommandBuffer command, VkResult result) {
+    std::lock_guard lock(mMutex);
+    if (mJob && mJob->recording.commandBuffer == command) {
+        static std::once_flag logged;
+        std::call_once(logged, [&] { ALOGI("Athens MiVK ended vector recording: %d", result); });
+        if (!mWitness.endRecording(mJob->recording, result))
+            mWitness.invalidate();
+    }
+}
+
+void Producer::submit(VkQueue queue,
+                      uint32_t count,
+                      const VkSubmitInfo* batches,
+                      VkResult result) {
+    if (result != VK_SUCCESS || !count || !batches)
+        return;
+    std::lock_guard lock(mMutex);
+    if (!mJob)
+        return;
+    fenceDiscardIfOnQueue(queue);
+    auto& job = *mJob;
+    bool contains = false;
+    bool touchesSignal = false;
+    for (uint32_t i = 0; i < count; ++i) {
+        const auto& batch = batches[i];
+        for (uint32_t r = 0; r < batch.commandBufferCount; ++r) {
+            contains |= batch.pCommandBuffers[r] == job.recording.commandBuffer;
+        }
+        for (uint32_t s = 0;
+             mCurrentSignal.handle && s < batch.signalSemaphoreCount; ++s) {
+            touchesSignal |=
+                batch.pSignalSemaphores[s] == mCurrentSignal.handle;
+        }
+        for (uint32_t w = 0;
+             mCurrentSignal.handle && w < batch.waitSemaphoreCount; ++w) {
+            touchesSignal |= batch.pWaitSemaphores[w] == mCurrentSignal.handle;
+        }
+    }
+    if (!contains) {
+        if (touchesSignal)
+            invalidateSignal();
+        return;
+    }
+    if (job.submittedQueue || DeviceFor(queue) != job.recording.device) {
+        invalidateSignal();
+        return;
+    }
+    job.submittedQueue = queue;
+    static std::once_flag loggedSubmit;
+    std::call_once(loggedSubmit, [&] {
+        ALOGI("Athens MiVK queue submit: batches=%u commands=%u signals=%u waits=%u",
+              count, batches->commandBufferCount, batches->signalSemaphoreCount, batches->waitSemaphoreCount);
+    });
+    job.image->markSubmitted(result);
+    fenceDiscardIfOnQueue(queue);
+    if (count != 1 || batches->signalSemaphoreCount != 1 ||
+        !containsBinary(batches->pSignalSemaphores[0]) ||
+        !IsRecordingGeneration(job.recording.commandBuffer,
+                               job.recording.generation)) {
+        static std::once_flag logged;
+        std::call_once(logged, [&] {
+            ALOGI("Athens MiVK vector submission: batches=%u signals=%u binary=%d live=%d",
+                  count, batches->signalSemaphoreCount, batches->signalSemaphoreCount != 0 &&
+                  containsBinary(batches->pSignalSemaphores[0]),
+                  IsRecordingGeneration(job.recording.commandBuffer, job.recording.generation));
+        });
+        mWitness.invalidate();
+        return;
+    }
+    // A legacy submission's signal covers the vector write. It can retire the
+    // buffer even when the recording doesn't prove which color image should
+    // receive the vector.
+    mCurrentSignal = {batches->pSignalSemaphores[0], ++mSignalGeneration,
+                      VK_SEMAPHORE_TYPE_BINARY};
+    mCompletionQueue = queue;
+    std::array<Witness::Recording, 16> recordings;
+    if (batches->commandBufferCount > recordings.size() ||
+        mAcquired.size() != 1) {
+        mWitness.invalidate();
+        return;
+    }
+    bool colorRendered = false;
+    for (uint32_t i = 0; i < batches->commandBufferCount; ++i) {
+        const auto command = batches->pCommandBuffers[i];
+        const auto recording = GetClosedRecording(command);
+        if (!recording) {
+            static std::once_flag logged;
+            std::call_once(logged, [&] { ALOGI("Athens MiVK untracked color submission recording %u/%u", i, batches->commandBufferCount); });
+            mWitness.invalidate();
+            return;
+        }
+        recordings[i] = *recording;
+        colorRendered |= DidRenderImage(command, job.color.image);
+    }
+    if (!colorRendered) {
+        static std::once_flag logged;
+        std::call_once(logged, [] { ALOGI("Athens MiVK submitted the vector without a matched present image"); });
+        mWitness.invalidate();
+        return;
+    }
+    const Witness::Submit submitted{
+        queue,
+        result,
+        count,
+        {recordings.data(), batches->commandBufferCount},
+        {batches->pWaitSemaphores, batches->waitSemaphoreCount},
+        {&mCurrentSignal, 1},
+        job.color};
+    if (!mWitness.observeSubmit(submitted))
+        mWitness.invalidate();
+}
+
+void Producer::submit2(VkQueue queue, uint32_t count,
+                       const VkSubmitInfo2* batches,
+                       VkResult result) {
+    if (result != VK_SUCCESS || !count || !batches)
+        return;
+    std::lock_guard lock(mMutex);
+    if (!mJob)
+        return;
+    fenceDiscardIfOnQueue(queue);
+    // The stage mask on a submit2 signal is not necessarily a full completion
+    // dependency.
+    invalidateSignal();
+    if (mJob->submittedQueue)
+        return;
+    for (uint32_t i = 0; i < count; ++i) {
+        const auto& batch = batches[i];
+        for (uint32_t j = 0; j < batch.commandBufferInfoCount; ++j) {
+            if (batch.pCommandBufferInfos[j].commandBuffer ==
+                mJob->recording.commandBuffer) {
+                mJob->submittedQueue = queue;
+                static std::once_flag logged;
+                std::call_once(logged, [&] {
+                    ALOGI("Athens MiVK queue submit2: batches=%u commands=%u signals=%u",
+                          count, batch.commandBufferInfoCount, batch.signalSemaphoreInfoCount);
+                });
+                mJob->image->markSubmitted(result);
+                fenceDiscardIfOnQueue(queue);
+                return;
+            }
+        }
+    }
+}
+
+VkResult Producer::present(VkDevice device,
+                           VkQueue queue,
+                           const VkPresentInfoKHR* info,
+                           PFN_vkQueuePresentKHR next) {
+    std::optional<ScopedPresentCapture> capture;
+    uint64_t jobGeneration = 0;
+    bool pairEligible = false;
+    bool presentsJobImage = false;
+    {
+        std::lock_guard lock(mMutex);
+        if (mJob && device == mDevice) {
+            jobGeneration = mJob->slot.generation;
+            for (uint32_t i = 0; i < info->swapchainCount; ++i) {
+                if (info->pSwapchains[i] == mJob->color.swapchain &&
+                    info->pImageIndices[i] == mJob->color.imageIndex) presentsJobImage = true;
+            }
+            static std::once_flag logged[2];
+            std::call_once(logged[mJob->submittedQueue != VK_NULL_HANDLE], [&] {
+                ALOGI("Athens MiVK present: submitted=%d sameQueue=%d image=%d waits=%u "
+                      "signalMatch=%d acquired=%zu", mJob->submittedQueue != VK_NULL_HANDLE,
+                      mJob->submittedQueue == queue, presentsJobImage, info->waitSemaphoreCount,
+                      info->waitSemaphoreCount == 1 && info->pWaitSemaphores[0] == mCurrentSignal.handle,
+                      mAcquired.size());
+            });
+        }
+        if (mJob && mJob->submittedQueue && !mJob->discard && mChannel && device == mDevice &&
+            queue == mCompletionQueue && info->swapchainCount == 1 &&
+            info->waitSemaphoreCount == 1 &&
+            info->pSwapchains[0] == mJob->color.swapchain &&
+            info->pImageIndices[0] == mJob->color.imageIndex &&
+            info->pWaitSemaphores[0] == mCurrentSignal.handle &&
+            driver::FindAcquiredAthensPresentImage(info->pSwapchains[0],
+                                                   info->pImageIndices[0]) ==
+                mJob->color.image) {
+            pairEligible = mAcquired.size() == 1 &&
+                           mWitness.beginPresent(
+                               {queue, 1, {&mCurrentSignal, 1}, mJob->color});
+            if (!pairEligible) {
+                static std::once_flag logged;
+                std::call_once(logged, [] { ALOGI("Athens MiVK present lacks color submission evidence"); });
+            }
+            capture.emplace(mChannel->presentTarget(), queue,
+                            mJob->color.swapchain, mJob->color.imageIndex,
+                            mCurrentSignal.handle);
+        } else if (mJob && mJob->submittedQueue && device == mDevice) {
+            bool consumesSignal = false;
+            for (uint32_t i = 0; mCurrentSignal.handle && i < info->waitSemaphoreCount; ++i) {
+                consumesSignal |= info->pWaitSemaphores[i] == mCurrentSignal.handle;
+            }
+            if (presentsJobImage || consumesSignal) {
+                invalidateSignal();
+                mJob->discard = true;
+            }
+        }
+    }
+    const auto result = next(queue, info);
+    std::lock_guard lock(mMutex);
+    if (device == mDevice) {
+        for (uint32_t i = 0; i < info->swapchainCount; ++i) {
+            if (info->pSwapchains[i] == mSwapchain)
+                mAcquired.erase(info->pImageIndices[i]);
+        }
+    }
+    if (!mJob || jobGeneration != mJob->slot.generation || !mChannel)
+        return result;
+    if (!capture || mJob->discard) {
+        mJob->discard |= presentsJobImage;
+        fenceDiscardIfOnQueue(queue);
+        return result;
+    }
+    auto metadata = capture->take();
+    if (!isSuccessfulPresent(result) || !metadata) {
+        static std::once_flag logged;
+        std::call_once(logged, [&] { ALOGI("Athens MiVK WSI capture: present=%d metadata=%d", result, metadata.has_value()); });
+        mWitness.invalidate();
+        mJob->discard = true;
+        fenceDiscardIfOnQueue(queue);
+        return result;
+    }
+    unique_fd completion(
+        fcntl(metadata->acquireFence.get(), F_DUPFD_CLOEXEC, 0));
+    if (!completion.ok() ||
+        mJob->image->attachPresentSyncFd(std::move(completion)) != VK_SUCCESS) {
+        invalidateSignal();
+        mJob->discard = true;
+        fenceDiscardIfOnQueue(queue);
+        return result;
+    }
+    if (pairEligible) {
+        const auto pair = mWitness.finishPresent(mJob->slot, mJob->color,
+                                                 metadata->enqueue());
+        if (!pair) return result;
+        const auto status = mChannel->publish(mJob->buffer, *pair, *metadata, mJob->layout);
+        if (status == android::OK) {
+            mPublishedWrites.push_back({mJob->slot.bufferId, std::move(mJob->image)});
+            dropJob();
+            mNextChannelCheck = Clock::now() + kChannelCheckInterval;
+            if (!mLoggedFirstVector) {
+                ALOGI("Athens MiVK delivered game/vector frame %" PRIu64, pair->nativeFrameNumber);
+                mLoggedFirstVector = true;
+            }
+        } else {
+            static std::once_flag logged;
+            std::call_once(logged, [&] { ALOGI("Athens MiVK paired frame submission failed: %d", status); });
+        }
+    }
+    return result;
+}
+
+void Producer::semaphore(VkDevice device,
+                         VkSemaphore handle,
+                         bool createdBinary) {
+    std::lock_guard lock(mMutex);
+    if (!mNext.contains(device))
+        return;
+    if (mCurrentSignal.handle == handle)
+        invalidateSignal();
+    if (createdBinary && mBinarySemaphores.size() < 256)
+        mBinarySemaphores.insert(handle);
+    else
+        mBinarySemaphores.erase(handle);
+}
+
+void Producer::retire(uint64_t generation) {
+    std::lock_guard lock(mMutex);
+    if (mJob && mJob->surfaceGeneration == generation) {
+        mJob->discard = true;
+        mWitness.invalidate();
+    }
+}
+
+void Producer::collect() {
+    std::erase_if(mPublishedWrites, [](const PublishedWrite& write) {
+        const auto result = write.image->tryRetire();
+        return result == VK_SUCCESS || result == VK_ERROR_DEVICE_LOST;
+    });
+    if (!mJob)
+        return;
+    if (mJob->submittedQueue) {
+        const VkResult result = mJob->image->tryRetire();
+        if (result == VK_SUCCESS || result == VK_ERROR_DEVICE_LOST)
+            dropJob();
+    } else if (!IsRecordingGeneration(mJob->recording.commandBuffer,
+                                      mJob->recording.generation)) {
+        mJob->image->cancelRecording();
+        dropJob();
+    }
+}
+
+void Producer::fenceDiscardIfOnQueue(VkQueue queue) {
+    if (!mJob || !mJob->discard || mJob->submittedQueue != queue) return;
+    mJob->image->fenceDiscardedWrite(queue);
+}
+
+void Producer::dropJob() {
+    if (mChannel && mJob && mJob->buffer.buffer)
+        mChannel->cancel(mJob->buffer, {});
+    mJob.reset();
+    (void)mWitness.cancel();
+    mCurrentSignal = {};
+    mCompletionQueue = VK_NULL_HANDLE;
+}
+
+void Producer::invalidateSignal() {
+    mWitness.invalidate();
+    mCurrentSignal = {};
+    mCompletionQueue = VK_NULL_HANDLE;
+}
+
+void Producer::idle(VkDevice device, bool destroying) {
+    std::lock_guard lock(mMutex);
+    if (device == mDevice) {
+        for (const auto& write : mPublishedWrites) write.image->retireAfterDeviceIdle();
+        mPublishedWrites.clear();
+        if (mJob && (mJob->submittedQueue || destroying)) {
+            mJob->image->retireAfterDeviceIdle();
+            dropJob();
+        }
+        if (destroying) {
+            mChannel.reset();
+            mAcquired.clear();
+            mBinarySemaphores.clear();
+            mVisitedBuffers.clear();
+            mDevice = VK_NULL_HANDLE;
+            mSwapchain = VK_NULL_HANDLE;
+        }
+    }
+}
+
+void Producer::forgetDevice(VkDevice device) {
+    std::lock_guard lock(mMutex);
+    mNext.erase(device);
+}
+
+void Producer::destroySwapchain(VkDevice device, VkSwapchainKHR swapchain) {
+    std::lock_guard lock(mMutex);
+    if (device != mDevice || swapchain != mSwapchain)
+        return;
+    invalidateSignal();
+    mAcquired.clear();
+    mSwapchain = VK_NULL_HANDLE;
+    if (mJob)
+        mJob->discard = true;
+    else
+        mChannel.reset();
+}
+
+}  // namespace
+
+const AthensMiVkRenderCallbacks& MiVkRenderCallbacks() {
+    static const AthensMiVkRenderCallbacks callbacks{
+        .version = 1,
+        .size = sizeof(AthensMiVkRenderCallbacks),
+        .context = nullptr,
+        .isArmed = [](void*) { return State().armed(); },
+        .record =
+            [](void*, const AthensMiVkRenderInput* input) {
+                return input ? State().record(*input) : VK_NOT_READY;
+            },
+        .retire = [](void*,
+                     uint64_t generation) { State().retire(generation); },
+        .observeDeviceProc =
+            [](void*, VkDevice device, const char* name,
+               PFN_vkVoidFunction next) {
+                return State().wrap(device, name, next);
+            },
+    };
+    return callbacks;
+}
+
+}  // namespace vulkan::athens
