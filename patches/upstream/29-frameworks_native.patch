+#include "../../AthensMotionVectorTransport.h"
+
+#include <binder/Binder.h>
+#include <binder/Parcel.h>
+#include <gtest/gtest.h>
+#include <utils/String16.h>
+
+#include <algorithm>
+#include <vector>
+
+namespace android::athens {
+namespace {
+
+const String16 kDescriptor(u"vendor.xiaomi.hardware.display.mihwcextension.IMiHwcExtension");
+
+class RecordingHwc final : public BBinder {
+public:
+    const String16& getInterfaceDescriptor() const override { return kDescriptor; }
+
+    status_t onTransact(uint32_t code, const Parcel& data, Parcel* reply, uint32_t) override {
+        if (code != 9 || !reply || !data.checkInterface(this) || data.readInt32(&display) != OK ||
+            display != 0 || data.readFloatVector(&words) != OK ||
+            words.size() != kMotionVectorWordCount || data.dataAvail() != 0) {
+            return BAD_VALUE;
+        }
+        return fail ? DEAD_OBJECT : reply->writeNoException();
+    }
+
+    int32_t display = -1;
+    std::vector<float> words;
+    bool fail = false;
+};
+
+TEST(AthensMotionVectorTransport, EncodesAndSendsActiveAndIdlePackets) {
+    auto hwc = sp<RecordingHwc>::make();
+    constexpr size_t kRowBytes = kMotionVectorColumns * 4;
+    std::vector<std::byte> pixels(kRowBytes * kMotionVectorRows, std::byte{0x7f});
+    pixels[0] = std::byte{0xff};
+    pixels[1] = std::byte{0xff};
+    MotionVectorPayload active;
+    ASSERT_TRUE(encodeMotionVectors({pixels, 60, 27, kRowBytes, MotionVectorFormat::Rgba8888}, 1156,
+                                    2510, active));
+    ASSERT_TRUE(sendMotionVectorPacket(hwc, active));
+    ASSERT_EQ(hwc->words.size(), kMotionVectorWordCount);
+    EXPECT_EQ(hwc->display, 0);
+    EXPECT_EQ(hwc->words[0], 16000);
+    EXPECT_EQ(hwc->words[14], 4774881);
+    EXPECT_EQ(hwc->words[15], 0);
+    EXPECT_TRUE(std::equal(hwc->words.begin(), hwc->words.end(), active.begin()));
+
+    ASSERT_TRUE(sendMotionVectorPacket(hwc, idleMotionVectorPayload()));
+    EXPECT_TRUE(
+            std::all_of(hwc->words.begin(), hwc->words.end(), [](float x) { return x == 40000; }));
+    hwc->fail = true;
+    EXPECT_FALSE(sendMotionVectorPacket(hwc, active));
+}
+
+} // namespace
+} // namespace android::athens
