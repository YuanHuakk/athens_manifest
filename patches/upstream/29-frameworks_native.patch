+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "AthensMotionVectorEncoding.h"
+
+#include <algorithm>
+#include <bit>
+#include <cstdlib>
+
+namespace android::athens {
+namespace {
+
+constexpr size_t kPixelBytes = 4;
+constexpr float kIdleWord = 40000.0f;
+constexpr float kComponentBias = std::bit_cast<float>(uint32_t{0xbefefeff});
+constexpr std::array<float, 14> kHeader = {16000, 16724, 17741, 0, 4095, 4096,  1,
+                                           0,     1,     0,     2, 4121, 20482, 1620};
+constexpr std::array<float, 4> kFooter = {4096, 1040, 43890, 0};
+constexpr size_t kFooterOffset = kHeader.size() + kMotionVectorColumns * kMotionVectorRows;
+static_assert(kMotionVectorWordCount - kFooterOffset - kFooter.size() == 6);
+
+uint32_t readPixel(const std::byte* pixel) {
+    return std::to_integer<uint32_t>(pixel[0]) | (std::to_integer<uint32_t>(pixel[1]) << 8) |
+            (std::to_integer<uint32_t>(pixel[2]) << 16) |
+            (std::to_integer<uint32_t>(pixel[3]) << 24);
+}
+
+int32_t scaleComponent(uint32_t value, uint32_t channelMax, uint32_t scale, bool invert) {
+    const float centered =
+            static_cast<float>(static_cast<double>(value) / static_cast<double>(channelMax)) +
+            kComponentBias;
+    const float doubled = centered + centered;
+    const float squared = doubled * doubled;
+    const float magnitude = squared * static_cast<float>(scale);
+    return static_cast<int32_t>((centered >= 0.0f) != invert ? magnitude : -magnitude);
+}
+
+} // namespace
+
+const MotionVectorPayload& idleMotionVectorPayload() {
+    static constexpr auto payload = [] {
+        MotionVectorPayload words{};
+        words.fill(kIdleWord);
+        return words;
+    }();
+    return payload;
+}
+
+bool encodeMotionVectors(const MotionVectorImage& image, uint32_t scaleWidth, uint32_t scaleHeight,
+                         MotionVectorPayload& payload) {
+    if (image.width == 0 || image.width > kMaxMotionVectorDimension || image.height == 0 ||
+        image.height > kMaxMotionVectorDimension || scaleWidth == 0 ||
+        scaleWidth > kMaxMotionVectorDimension || scaleHeight == 0 ||
+        scaleHeight > kMaxMotionVectorDimension || image.rowBytes % kPixelBytes != 0 ||
+        image.rowBytes / kPixelBytes < image.width) {
+        return false;
+    }
+
+    uint32_t componentBits;
+    const uint32_t xShift = image.format == MotionVectorFormat::Rgba1010102XHigh ? 20 : 0;
+    switch (image.format) {
+        case MotionVectorFormat::Rgba8888:
+            componentBits = 8;
+            break;
+        case MotionVectorFormat::Rgba1010102:
+        case MotionVectorFormat::Rgba1010102XHigh:
+            componentBits = 10;
+            break;
+        default:
+            return false;
+    }
+
+    const size_t xStep = (image.width + kMotionVectorColumns - 1) / kMotionVectorColumns;
+    const size_t yStep = (image.height + kMotionVectorRows - 1) / kMotionVectorRows;
+    const size_t lastColumnEnd = ((kMotionVectorColumns - 1) * xStep + 1) * kPixelBytes;
+    const size_t lastRow = (kMotionVectorRows - 1) * yStep;
+    // The stock grid can sample row padding, but must stay inside that row and its mapped plane.
+    if (lastColumnEnd > image.rowBytes || lastRow >= image.height ||
+        lastColumnEnd > image.bytes.size() ||
+        lastRow > (image.bytes.size() - lastColumnEnd) / image.rowBytes) {
+        return false;
+    }
+
+    payload = idleMotionVectorPayload();
+    std::copy(kHeader.begin(), kHeader.end(), payload.begin());
+    const uint32_t channelMax = (1u << componentBits) - 1u;
+    for (size_t x = 0; x < kMotionVectorColumns; ++x) {
+        for (size_t y = 0; y < kMotionVectorRows; ++y) {
+            const size_t offset = y * yStep * image.rowBytes + x * xStep * kPixelBytes;
+            const uint32_t pixel = readPixel(image.bytes.data() + offset);
+            const int32_t vx = scaleComponent((pixel >> xShift) & channelMax, channelMax,
+                                              scaleWidth, true);
+            const int32_t vy = scaleComponent((pixel >> componentBits) & channelMax, channelMax,
+                                              scaleHeight, false);
+            const uint32_t packed = (static_cast<uint32_t>(std::abs(vx)) << 12) +
+                    static_cast<uint32_t>(std::abs(vy)) + (vx > 0 ? 0x400000u : 0u) +
+                    (vy > 0 ? 0x200u : 0u);
+            payload[kHeader.size() + x * kMotionVectorRows + y] = static_cast<float>(packed);
+        }
+    }
+    std::copy(kFooter.begin(), kFooter.end(), payload.begin() + kFooterOffset);
+    return true;
+}
+
+} // namespace android::athens
