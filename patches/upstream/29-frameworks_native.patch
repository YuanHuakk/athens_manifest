+status_t SurfaceFlinger::onAthensMotionVectorTransaction(uint32_t code, const Parcel& data,
+                                                        Parcel* reply, uint32_t flags) {
+    const auto* ipc = IPCThreadState::self();
+    if (ipc->getCallingUid() != AID_SYSTEM) return PERMISSION_DENIED;
+    CHECK_INTERFACE(ISurfaceComposer, data, reply);
+    if (!reply || (flags & IBinder::FLAG_ONEWAY)) return BAD_VALUE;
+
+    int64_t generation;
+    if (data.readInt64(&generation) != OK || generation <= 0) return BAD_VALUE;
+    const int32_t controllerPid = ipc->getCallingPid();
+    std::optional<AthensMotionVectorSession> proposed;
+    if (code == kPrepareAthensMotionVectors) {
+        int32_t uid, pid, taskId, taskLayerId;
+        int64_t physicalDisplayId;
+        if (data.readInt32(&uid) != OK || data.readInt32(&pid) != OK ||
+            data.readInt32(&taskId) != OK || data.readInt64(&physicalDisplayId) != OK ||
+            data.readInt32(&taskLayerId) != OK || uid < AID_APP_START || pid <= 0 || taskId <= 0 ||
+            physicalDisplayId < 0 || taskLayerId <= 0) {
+            return BAD_VALUE;
+        }
+        proposed = AthensMotionVectorSession{generation, controllerPid, uid, pid, taskId,
+                PhysicalDisplayId::fromValue(static_cast<uint64_t>(physicalDisplayId)),
+                static_cast<uint32_t>(taskLayerId)};
+    }
+    if (data.dataAvail() != 0) return BAD_VALUE;
+
+    const status_t result = mScheduler->schedule([=, this]() FTL_FAKE_GUARD(kMainThreadContext)
+                                                          -> status_t {
+        Mutex::Autolock lock(mStateLock);
+        if (mAthensMotionVectorSession &&
+            !isAthensMotionVectorSessionLive(*mAthensMotionVectorSession)) {
+            closeAthensMotionVectorSession();
+        }
+        updateAthensMotionVectorIngress(systemTime());
+        if (proposed) {
+            if (proposed->generation <= mLastAthensMotionVectorGeneration) return NAME_NOT_FOUND;
+            if (!isAthensMotionVectorSessionLive(*proposed)) return NAME_NOT_FOUND;
+            closeAthensMotionVectorSession();
+            mLastAthensMotionVectorGeneration = proposed->generation;
+            mAthensMotionVectorSession = proposed;
+            return OK;
+        }
+        if (!mAthensMotionVectorSession || mAthensMotionVectorSession->generation != generation ||
+            mAthensMotionVectorSession->controllerPid != controllerPid) {
+            return NAME_NOT_FOUND;
+        }
+        if (code == kStopAthensMotionVectors) {
+            closeAthensMotionVectorSession();
+            return OK;
+        }
+
+        auto& session = *mAthensMotionVectorSession;
+        const bool recentlyStaged = session.lastStagedTime > 0 &&
+                systemTime() - session.lastStagedTime <= kAthensMotionVectorContinuityNs;
+        if (code == kGetAthensMotionVectorHealth || code == kPauseAthensMotionVectorsIfIdle) {
+            if (session.armed && recentlyStaged && mAthensMotionVector->hasRecentSuccessfulSubmission(
+                                                      generation, kAthensMotionVectorContinuityNs)) {
+                return 2;
+            }
+            if (code == kPauseAthensMotionVectorsIfIdle && session.armed && !recentlyStaged) {
+                // Stop the hardware worker while the game has no fresh vectors. Keep the
+                // authenticated producer so its next real color/vector pair can stage again.
+                mAthensMotionVector->deactivate(generation);
+                session.armed = false;
+            }
+            return recentlyStaged ? 1 : 0;
+        }
+        if (session.armed) return OK;
+        if (!recentlyStaged) return WOULD_BLOCK;
+
+        if (!mAthensMotionVector) mAthensMotionVector = std::make_unique<AthensMotionVector>();
+        mAthensMotionVector->activate(generation, kAthensMotionVectorScaleWidth,
+                                      kAthensMotionVectorScaleHeight);
+        session.armed = true;
+        updateAthensMotionVectorIngress(systemTime());
+        return OK;
+    }).get();
+    const status_t header = reply->writeNoException();
+    return header == OK ? reply->writeInt32(result) : header;
+}
+
+status_t SurfaceFlinger::onAthensMotionVectorProducerTransaction(uint32_t code, const Parcel& data,
+                                                                Parcel* reply, uint32_t flags) {
+    const auto* ipc = IPCThreadState::self();
+    const int32_t uid = static_cast<int32_t>(ipc->getCallingUid());
+    const int32_t pid = ipc->getCallingPid();
+    if (uid < AID_APP_START || pid <= 0) return PERMISSION_DENIED;
+    CHECK_INTERFACE(ISurfaceComposer, data, reply);
+    if (!reply || (flags & IBinder::FLAG_ONEWAY)) return BAD_VALUE;
+
+    int64_t generation = 0;
+    int64_t gameFrameNumber = 0;
+    int64_t vectorFrameNumber = 0;
+    int32_t channelLayout = 0;
+    uint64_t gameBufferId = 0;
+    sp<IBinder> releaseEndpoint;
+    sp<IBinder> gameLayerHandle;
+    const bool open = code == kOpenAthensMotionVectorProducer;
+    if ((!open && data.readInt64(&generation) != OK) ||
+        data.readStrongBinder(&gameLayerHandle) != OK ||
+        (!open && (generation <= 0 || data.readInt64(&gameFrameNumber) != OK ||
+                   data.readInt64(&vectorFrameNumber) != OK || data.readInt32(&channelLayout) != OK ||
+                   gameFrameNumber <= 0 || vectorFrameNumber <= 0 ||
+                   (channelLayout != 0 && channelLayout != 1)))) {
+        return BAD_VALUE;
+    }
+    if (!open && data.dataAvail() &&
+        (data.readUint64(&gameBufferId) != OK || gameBufferId == 0 ||
+         data.readStrongBinder(&releaseEndpoint) != OK || !releaseEndpoint)) return BAD_VALUE;
+    if (data.dataAvail() != 0) return BAD_VALUE;
+    const uint32_t layerId = LayerHandle::getLayerId(gameLayerHandle);
+    if (layerId == UNASSIGNED_LAYER_ID) return BAD_VALUE;
+
+    // An ordinary process cannot open the queue or allocate a ticket before the exact UID
+    // and PID are selected by system_server. Check again on main after any session transition.
+    {
+        Mutex::Autolock lock(mStateLock);
+        if (!mAthensMotionVectorSession || mAthensMotionVectorSession->uid != uid ||
+            mAthensMotionVectorSession->pid != pid) {
+            return PERMISSION_DENIED;
+        }
+    }
+
+    sp<IBinder> producer;
+    // Two 60 Hz producer frames may be queued ahead of the display. After latch the
+    // original 16 ms freshness check still applies to the exact game/vector pair.
+    const nsecs_t ticketDeadline = systemTime() + kAthensMotionVectorIdleNs;
+    const status_t result = mScheduler->schedule([&, this]() FTL_FAKE_GUARD(kMainThreadContext)
+                                                           -> status_t {
+        Mutex::Autolock lock(mStateLock);
+        const nsecs_t now = systemTime();
+        updateAthensMotionVectorIngress(now);
+        if (!mAthensMotionVectorSession) return PERMISSION_DENIED;
+        auto& session = *mAthensMotionVectorSession;
+        if (session.uid != uid || session.pid != pid || !isAthensMotionVectorSessionLive(session)) {
+            return PERMISSION_DENIED;
+        }
+        if (open) {
+            generation = session.generation;
+            producer = openAthensMotionVectorIngress(generation, uid, pid, layerId);
+            return producer ? OK : BAD_VALUE;
+        }
+        if (session.releaseEndpoint && session.releaseEndpoint != releaseEndpoint) return PERMISSION_DENIED;
+
+        const auto gameFrame = static_cast<uint64_t>(gameFrameNumber);
+        const auto vectorFrame = static_cast<uint64_t>(vectorFrameNumber);
+        if (!session.producer || session.generation != generation || session.gameLayerId != layerId ||
+            gameFrame <= session.lastPublishedGameFrame ||
+            vectorFrame <= session.lastPublishedVectorFrame || gameFrame < session.gameFrameNumber ||
+            now > ticketDeadline) {
+            return BAD_VALUE;
+        }
+        if (releaseEndpoint) session.releaseEndpoint = releaseEndpoint;
+        if (session.pendingTickets.size() >= kAthensMotionVectorAcquiredBuffers) {
+            discardAthensMotionVectorBuffers(session.consumer, session.pendingTickets.front().vectorFrameNumber, now);
+            session.pendingTickets.pop_front();
+        }
+        session.lastPublishedGameFrame = gameFrame;
+        session.lastPublishedVectorFrame = vectorFrame;
+        if (session.gameFrameNumber == gameFrame) {
+            if (session.matchesGameBuffer(gameBufferId) &&
+                receiveAthensMotionVectorSample(generation, uid, pid, layerId, gameFrame,
+                        vectorFrame, channelLayout == 1)) return OK;
+            if (mAthensMotionVectorSession) {
+                discardAthensMotionVectorBuffers(session.consumer, vectorFrame, now);
+            }
+            return BAD_VALUE;
+        }
+
+        session.pendingTickets.push_back({gameFrame, gameBufferId, vectorFrame, ticketDeadline,
+                                          channelLayout == 1});
+        return OK;
+    }).get();
+
+    if (const status_t header = reply->writeNoException(); header != OK) return header;
+    if (const status_t status = reply->writeInt32(result); status != OK) return status;
+    if (!open || result != OK) return OK;
+    if (const status_t status = reply->writeInt64(generation); status != OK) return status;
+    if (const status_t status = reply->writeInt32(layerId); status != OK) return status;
+    if (const status_t status = reply->writeStrongBinder(producer); status != OK) return status;
+    return reply->writeInt32(2); // Supports the BLAST release endpoint and native buffer ID.
+}
+
 status_t SurfaceFlinger::onTransact(uint32_t code, const Parcel& data, Parcel* reply,
                                     uint32_t flags) {
+    if ((code >= kPrepareAthensMotionVectors && code <= kArmAthensMotionVectors) ||
+        code == kPauseAthensMotionVectorsIfIdle) {
+        return onAthensMotionVectorTransaction(code, data, reply, flags);
+    }
+    if (code == kOpenAthensMotionVectorProducer || code == kPublishAthensMotionVector) {
+        return onAthensMotionVectorProducerTransaction(code, data, reply, flags);
+    }
     if (const status_t error = CheckTransactCodeCredentials(code); error != OK) {
         return error;
     }
