+#include "AthensVulkanFrameWitness.h"
+
+#include <array>
+#include <cassert>
+#include <type_traits>
+
+namespace {
+
+using Witness = vulkan::athens::AthensVulkanFrameWitness;
+static_assert(vulkan::athens::isSuccessfulPresent(VK_SUBOPTIMAL_KHR));
+static_assert(vulkan::athens::isSuccessfulPresent(VK_SUCCESS));
+static_assert(!vulkan::athens::isSuccessfulPresent(VK_ERROR_OUT_OF_DATE_KHR));
+static_assert(!vulkan::athens::isSuccessfulPresent(VK_ERROR_SURFACE_LOST_KHR));
+static_assert(!vulkan::athens::isSuccessfulPresent(VK_NOT_READY));
+
+template <typename T>
+T fakeHandle(uintptr_t value) {
+    if constexpr (std::is_pointer_v<T>) {
+        return reinterpret_cast<T>(value);
+    } else {
+        return static_cast<T>(value);
+    }
+}
+
+struct Frame {
+    Witness::VectorSlot vector{3, 14, 500};
+    std::array<Witness::Recording, 1> recordings{{
+            {fakeHandle<VkDevice>(1), fakeHandle<VkCommandBuffer>(2), 19,
+             VK_COMMAND_BUFFER_LEVEL_PRIMARY, VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT},
+    }};
+    std::array<Witness::Semaphore, 1> signals{{
+            {fakeHandle<VkSemaphore>(3), 20, VK_SEMAPHORE_TYPE_BINARY},
+    }};
+    Witness::ColorFrame color{fakeHandle<VkSwapchainKHR>(4), 21, fakeHandle<VkImage>(5), 0, 22};
+    VkQueue queue = fakeHandle<VkQueue>(6);
+    Witness::Enqueue enqueue{VK_SUCCESS, 0, 43, 8};
+
+    Witness::Submit submit() const { return {queue, VK_SUCCESS, 1, recordings, {}, signals, color}; }
+
+    Witness::Present present() const { return {queue, 1, signals, color}; }
+
+    void record(Witness& witness) const {
+        assert(witness.arm(vector, recordings[0]));
+        assert(witness.beginVectorWrite(vector, recordings[0]));
+        assert(witness.finishVectorWrite(vector, recordings[0]));
+        assert(witness.endRecording(recordings[0], VK_SUCCESS));
+    }
+
+    void submitAndBeginPresent(Witness& witness) const {
+        record(witness);
+        assert(witness.observeSubmit(submit()));
+        assert(witness.beginPresent(present()));
+    }
+};
+
+void verifiesOnePresentAndRejectsReplay() {
+    Frame frame;
+    Witness witness;
+    frame.submitAndBeginPresent(witness);
+    const auto pair = witness.finishPresent(frame.vector, frame.color, frame.enqueue);
+    assert(pair && pair->vector == frame.vector && pair->color == frame.color);
+    assert(pair->nativeFrameNumber == 42);
+    assert(!witness.finishPresent(frame.vector, frame.color, frame.enqueue));
+    assert(!witness.arm(frame.vector, frame.recordings[0]));
+    assert(!witness.cancel());
+
+    ++frame.vector.generation;
+    ++frame.recordings[0].generation;
+    ++frame.signals[0].signalGeneration;
+    frame.submitAndBeginPresent(witness);
+    assert(witness.finishPresent(frame.vector, frame.color, frame.enqueue));
+}
+
+void rejectsSecondaryReusableAndUnfinishedRecordings() {
+    const Frame frame;
+    Witness witness;
+    auto recording = frame.recordings[0];
+    recording.level = VK_COMMAND_BUFFER_LEVEL_SECONDARY;
+    assert(!witness.arm(frame.vector, recording));
+    recording = frame.recordings[0];
+    recording.usage |= VK_COMMAND_BUFFER_USAGE_SIMULTANEOUS_USE_BIT;
+    assert(!witness.arm(frame.vector, recording));
+    assert(witness.arm(frame.vector, frame.recordings[0]));
+    assert(witness.beginVectorWrite(frame.vector, frame.recordings[0]));
+    assert(!witness.observeSubmit(frame.submit()));
+    assert(!witness.finishVectorWrite(frame.vector, frame.recordings[0]));
+    const auto retirement = witness.cancel();
+    assert(retirement && retirement->commandsMayReferenceSlot);
+
+    Witness failedEnd;
+    assert(failedEnd.arm(frame.vector, frame.recordings[0]));
+    assert(failedEnd.beginVectorWrite(frame.vector, frame.recordings[0]));
+    assert(failedEnd.finishVectorWrite(frame.vector, frame.recordings[0]));
+    assert(!failedEnd.endRecording(frame.recordings[0], VK_ERROR_DEVICE_LOST));
+    assert(!failedEnd.observeSubmit(frame.submit()));
+}
+
+void rejectsBatchedMalformedAndReusedSubmissions() {
+    const Frame frame;
+    Witness batched;
+    frame.record(batched);
+    auto submit = frame.submit();
+    submit.batchCount = 2;
+    assert(!batched.observeSubmit(submit));
+    assert(!batched.beginPresent(frame.present()));
+
+    Witness multiCommand;
+    frame.record(multiCommand);
+    submit = frame.submit();
+    auto unrelated = frame.recordings[0];
+    unrelated.commandBuffer = fakeHandle<VkCommandBuffer>(12);
+    const std::array recordings{frame.recordings[0], unrelated};
+    submit.recordings = recordings;
+    assert(multiCommand.observeSubmit(submit));
+    assert(multiCommand.beginPresent(frame.present()));
+
+    Witness repeatedRecording;
+    frame.record(repeatedRecording);
+    const std::array duplicates{frame.recordings[0], frame.recordings[0]};
+    submit.recordings = duplicates;
+    assert(!repeatedRecording.observeSubmit(submit));
+
+    Witness timeline;
+    frame.record(timeline);
+    submit = frame.submit();
+    auto signals = frame.signals;
+    signals[0].type = VK_SEMAPHORE_TYPE_TIMELINE;
+    submit.signals = signals;
+    assert(!timeline.observeSubmit(submit));
+
+    Witness reuse;
+    frame.record(reuse);
+    assert(reuse.observeSubmit(frame.submit()));
+    submit = frame.submit();
+    submit.recordings = {};
+    submit.signals = {};
+    // An unrelated submit leaves this witness intact.
+    assert(!reuse.observeSubmit(submit));
+    const std::array waits{signals[0].handle};
+    submit.waits = waits;
+    assert(!reuse.observeSubmit(submit));
+    assert(!reuse.beginPresent(frame.present()));
+}
+
+void rejectsWrongQueueMultiSwapchainAndWrongFrame() {
+    const Frame frame;
+    Witness wrongQueue;
+    frame.record(wrongQueue);
+    assert(wrongQueue.observeSubmit(frame.submit()));
+    auto present = frame.present();
+    present.queue = fakeHandle<VkQueue>(80);
+    assert(!wrongQueue.beginPresent(present));
+
+    Witness multi;
+    frame.record(multi);
+    assert(multi.observeSubmit(frame.submit()));
+    present = frame.present();
+    present.swapchainCount = 2;
+    assert(!multi.beginPresent(present));
+
+    Witness wrongFrame;
+    frame.record(wrongFrame);
+    assert(wrongFrame.observeSubmit(frame.submit()));
+    present = frame.present();
+    ++present.color.surfaceGeneration;
+    assert(!wrongFrame.beginPresent(present));
+
+    Witness staleWait;
+    frame.record(staleWait);
+    assert(staleWait.observeSubmit(frame.submit()));
+    present = frame.present();
+    auto waits = frame.signals;
+    ++waits[0].signalGeneration;
+    present.waits = waits;
+    assert(!staleWait.beginPresent(present));
+}
+
+void requiresSuccessfulEnqueueWithFrameNumberAndFence() {
+    const Frame frame;
+    const Witness::Enqueue rejected[] = {
+            {VK_SUCCESS, 0, 0, 8},
+            {VK_SUCCESS, 0, 1, 8},
+            {VK_SUCCESS, 0, 43, -1},
+            {VK_SUCCESS, -1, 43, 8},
+            {VK_ERROR_DEVICE_LOST, 0, 43, 8},
+    };
+    for (const auto& enqueue : rejected) {
+        Witness witness;
+        frame.submitAndBeginPresent(witness);
+        assert(!witness.finishPresent(frame.vector, frame.color, enqueue));
+        assert(!witness.finishPresent(frame.vector, frame.color, frame.enqueue));
+        const auto retirement = witness.cancel();
+        assert(retirement && retirement->vector == frame.vector);
+        assert(retirement->commandsMayReferenceSlot);
+    }
+}
+
+void cancellationDistinguishesUnwrittenAndRecordedSlots() {
+    const Frame frame;
+    Witness unrecorded;
+    assert(unrecorded.arm(frame.vector, frame.recordings[0]));
+    const auto unusedSlot = unrecorded.cancel();
+    assert(unusedSlot && !unusedSlot->commandsMayReferenceSlot);
+    assert(!unrecorded.cancel());
+    assert(!unrecorded.arm(frame.vector, frame.recordings[0]));
+
+    Witness retired;
+    frame.record(retired);
+    retired.invalidate();
+    assert(!retired.observeSubmit(frame.submit()));
+    const auto recordedSlot = retired.cancel();
+    assert(recordedSlot && recordedSlot->commandsMayReferenceSlot);
+    assert(recordedSlot->recording == frame.recordings[0]);
+}
+
+} // namespace
+
+int main() {
+    verifiesOnePresentAndRejectsReplay();
+    rejectsSecondaryReusableAndUnfinishedRecordings();
+    rejectsBatchedMalformedAndReusedSubmissions();
+    rejectsWrongQueueMultiSwapchainAndWrongFrame();
+    requiresSuccessfulEnqueueWithFrameNumberAndFence();
+    cancellationDistinguishesUnwrittenAndRecordedSlots();
+}
