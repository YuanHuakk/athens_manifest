+namespace {
+constexpr uint32_t kPrepareAthensMotionVectors = 31601;
+constexpr uint32_t kGetAthensMotionVectorHealth = 31602;
+constexpr uint32_t kStopAthensMotionVectors = 31603;
+constexpr uint32_t kArmAthensMotionVectors = 31604;
+constexpr uint32_t kOpenAthensMotionVectorProducer = 31605;
+constexpr uint32_t kPublishAthensMotionVector = 31606;
+constexpr uint32_t kPauseAthensMotionVectorsIfIdle = 31607;
+constexpr nsecs_t kAthensMotionVectorFreshnessNs = 16'000'000;
+constexpr nsecs_t kAthensMotionVectorIdleNs = 2 * 16'666'667; // Two 60 fps game frames.
+constexpr nsecs_t kAthensMotionVectorContinuityNs = 250'000'000;
+constexpr uint32_t kAthensMotionVectorScaleWidth = 1156;
+constexpr uint32_t kAthensMotionVectorScaleHeight = 2510;
+
+// Keeping the consumer and the acquired item prevents the slot from being reused while
+// the worker reads its pixels. Return the producer fence even when rejecting the item.
+struct AthensMotionVectorSlotLease {
+    AthensMotionVectorSlotLease(const sp<BufferItemConsumer>& consumer, BufferItem&& item)
+          : consumer(consumer), item(std::move(item)) {}
+    ~AthensMotionVectorSlotLease() { consumer->releaseBuffer(item, item.mFence); }
+
+    const sp<BufferItemConsumer> consumer;
+    const BufferItem item;
+};
+
+// A vector may already be queued when its game frame is dropped. Return only slots
+// through that ticket and preserve the GPU completion fence on each released slot.
+void discardAthensMotionVectorBuffers(const sp<BufferItemConsumer>& consumer,
+                                      uint64_t through, nsecs_t now) {
+    for (int i = 0; i <= kAthensMotionVectorAcquiredBuffers; ++i) {
+        BufferItem item;
+        if (consumer->acquireBuffer(&item, now, through) != OK) break;
+        consumer->releaseBuffer(item, item.mFence);
+        if (item.mFrameNumber == through) break;
+    }
+}
