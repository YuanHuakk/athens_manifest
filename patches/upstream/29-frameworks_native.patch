+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "AthensFrameMasterRepaint.h"
+
+#include <binder/Binder.h>
+#include <binder/Parcel.h>
+#include <binder/Stability.h>
+#include <binder/Status.h>
+#include <utils/Log.h>
+
+#include <string>
+#include <utility>
+
+#include "BackgroundExecutor.h"
+
+namespace android {
+namespace {
+
+const String16 kServiceName(u"vendor.xiaomi.hardware.framemaster.IFrameMaster/default");
+const String16 kServiceDescriptor(u"vendor.xiaomi.hardware.framemaster.IFrameMaster");
+const String16 kCallbackDescriptor(u"vendor.xiaomi.hardware.framemaster.IFrameMasterCallback");
+constexpr int32_t kInterfaceVersion = 1;
+// Match the HAL's ODM AIDL library rather than the stock system_ext client library.
+constexpr char kInterfaceHash[] = "be57c68fe4876b8f5de9d3bcf662d0d35e71fa60";
+constexpr uint32_t kRegisterCallback = IBinder::FIRST_CALL_TRANSACTION + 4;
+constexpr uint32_t kFrameMasterInfoChanged = IBinder::FIRST_CALL_TRANSACTION;
+constexpr uint32_t kGetInterfaceVersion = IBinder::LAST_CALL_TRANSACTION;
+constexpr uint32_t kGetInterfaceHash = IBinder::LAST_CALL_TRANSACTION - 1;
+constexpr int32_t kSwitchingCase = 10;
+constexpr int32_t kCloudGameScene = 1;
+constexpr int32_t kVideoMemcScene = 2;
+constexpr int32_t kNativeGameMemcScene = 3;
+// Stop requesting frames if the vendor completion notification is lost.
+constexpr auto kMaxRepaintWindow = std::chrono::milliseconds(500);
+// The 406 native-game worker waits up to 71 x 10 ms for the panel after switching starts.
+constexpr auto kNativeGameRepaintWindow = std::chrono::milliseconds(1000);
+
+bool readInterfaceIdentity(const sp<IBinder>& service, uint32_t code, Parcel& reply) {
+    Parcel data;
+    data.markForBinder(service);
+    binder::Status status;
+    return data.writeInterfaceToken(kServiceDescriptor) == OK &&
+            service->transact(code, data, &reply) == OK && status.readFromParcel(reply) == OK &&
+            status.isOk();
+}
+
+bool matchesStockInterface(const sp<IBinder>& service) {
+    Parcel versionReply;
+    Parcel hashReply;
+    int32_t version;
+    std::string hash;
+    return readInterfaceIdentity(service, kGetInterfaceVersion, versionReply) &&
+            versionReply.readInt32(&version) == OK && version == kInterfaceVersion &&
+            readInterfaceIdentity(service, kGetInterfaceHash, hashReply) &&
+            hashReply.readUtf8FromUtf16(&hash) == OK && hash == kInterfaceHash;
+}
+
+} // namespace
+
+class AthensFrameMasterRepaint::Callback final : public BBinder {
+public:
+    Callback(wp<AthensFrameMasterRepaint> owner, wp<IBinder> source)
+          : mOwner(std::move(owner)), mSource(std::move(source)) {
+        internal::Stability::markVintf(this);
+    }
+
+    const String16& getInterfaceDescriptor() const override { return kCallbackDescriptor; }
+
+    status_t onTransact(uint32_t code, const Parcel& data, Parcel* reply, uint32_t flags) override {
+        if (code == kFrameMasterInfoChanged) {
+            if (!(flags & IBinder::FLAG_ONEWAY) || !data.checkInterface(this)) return BAD_TYPE;
+
+            int32_t event;
+            int32_t status;
+            int32_t scene;
+            if (data.readInt32(&event) != OK || data.readInt32(&status) != OK ||
+                data.readInt32(&scene) != OK) {
+                return BAD_VALUE;
+            }
+            if (event != kSwitchingCase || (status != 0 && status != 1) ||
+                (scene != kCloudGameScene && scene != kVideoMemcScene &&
+                 scene != kNativeGameMemcScene)) {
+                return OK;
+            }
+
+            std::string command;
+            if (data.readUtf8FromUtf16(&command) != OK || data.dataAvail() != 0) return BAD_VALUE;
+            if (const auto owner = mOwner.promote()) {
+                owner->onSwitching(mSource, scene, status == 1);
+            }
+            return OK;
+        }
+        if (code == kGetInterfaceVersion || code == kGetInterfaceHash) {
+            if (reply == nullptr || !data.checkInterface(this)) return BAD_TYPE;
+            if (const auto status = reply->writeNoException(); status != OK) return status;
+            return code == kGetInterfaceVersion
+                    ? reply->writeInt32(kInterfaceVersion)
+                    : reply->writeUtf8AsUtf16(std::string(kInterfaceHash));
+        }
+        return BBinder::onTransact(code, data, reply, flags);
+    }
+
+private:
+    const wp<AthensFrameMasterRepaint> mOwner;
+    const wp<IBinder> mSource;
+};
+
+class AthensFrameMasterRepaint::ServiceRegistration final
+      : public IServiceManager::LocalRegistrationCallback {
+public:
+    explicit ServiceRegistration(wp<AthensFrameMasterRepaint> owner) : mOwner(std::move(owner)) {}
+
+    void onServiceRegistration(const String16&, const sp<IBinder>& service) override {
+        BackgroundExecutor::getLowPriorityInstance().sendCallbacks({[owner = mOwner, service] {
+            if (const auto client = owner.promote()) client->connect(service);
+        }});
+    }
+
+private:
+    const wp<AthensFrameMasterRepaint> mOwner;
+};
+
+AthensFrameMasterRepaint::AthensFrameMasterRepaint(std::function<void()> requestRepaint)
+      : mRequestRepaint(std::move(requestRepaint)) {}
+
+AthensFrameMasterRepaint::~AthensFrameMasterRepaint() {
+    if (mSubscribed)
+        defaultServiceManager()->unregisterForNotifications(kServiceName, mRegistration);
+}
+
+void AthensFrameMasterRepaint::start() {
+    const auto self = wp<AthensFrameMasterRepaint>::fromExisting(this);
+    mRegistration = sp<ServiceRegistration>::make(self);
+    BackgroundExecutor::getLowPriorityInstance().sendCallbacks({[self] {
+        if (const auto client = self.promote()) {
+            const auto status =
+                    defaultServiceManager()->registerForNotifications(kServiceName,
+                                                                      client->mRegistration);
+            client->mSubscribed = status == OK;
+            ALOGW_IF(status != OK, "Athens FrameMaster service subscription failed: %d", status);
+        }
+    }});
+}
+
+void AthensFrameMasterRepaint::connect(const sp<IBinder>& service) {
+    if (!service || !service->isBinderAlive()) return;
+
+    sp<IBinder> previous;
+    {
+        std::lock_guard lock(mMutex);
+        if (mService == service) return;
+        previous = std::move(mService);
+        mService = service;
+        mCallback.clear();
+        mActiveScene = 0;
+        mInitialRepaintPending = false;
+    }
+    const auto self = sp<AthensFrameMasterRepaint>::fromExisting(this);
+    const wp<IBinder::DeathRecipient> deathRecipient(self);
+    const wp<IBinder> source(service);
+    if (previous) previous->unlinkToDeath(deathRecipient);
+
+    if (service->linkToDeath(self) != OK) {
+        binderDied(source);
+        return;
+    }
+    if (!matchesStockInterface(service)) {
+        ALOGW("Athens FrameMaster interface does not match the stock v1 contract");
+        service->unlinkToDeath(deathRecipient);
+        binderDied(source);
+        return;
+    }
+
+    const sp<IBinder> callback = sp<Callback>::make(wp<AthensFrameMasterRepaint>(self), source);
+    {
+        std::lock_guard lock(mMutex);
+        if (mService != service) return;
+        mCallback = callback;
+    }
+    Parcel data;
+    data.markForBinder(service);
+    if (data.writeInterfaceToken(kServiceDescriptor) != OK ||
+        data.writeStrongBinder(callback) != OK ||
+        service->transact(kRegisterCallback, data, nullptr, IBinder::FLAG_ONEWAY) != OK) {
+        ALOGW("Athens FrameMaster callback registration could not be submitted");
+        service->unlinkToDeath(deathRecipient);
+        binderDied(source);
+        return;
+    }
+    ALOGI("Athens FrameMaster callback registration submitted");
+}
+
+void AthensFrameMasterRepaint::binderDied(const wp<IBinder>& who) {
+    std::lock_guard lock(mMutex);
+    if (who != mService) return;
+    mService.clear();
+    mCallback.clear();
+    mActiveScene = 0;
+    mInitialRepaintPending = false;
+}
+
+void AthensFrameMasterRepaint::onSwitching(const wp<IBinder>& source, int32_t scene,
+                                           bool entering) {
+    {
+        std::lock_guard lock(mMutex);
+        if (source != mService) return;
+        if (entering) {
+            if (mActiveScene == scene) return;
+            mActiveScene = scene;
+            mInitialRepaintPending = true;
+            mDeadline = std::chrono::steady_clock::now() +
+                    (scene == kNativeGameMemcScene ? kNativeGameRepaintWindow : kMaxRepaintWindow);
+        } else {
+            if (mActiveScene != scene) return;
+            mActiveScene = 0;
+        }
+    }
+    ALOGI("Athens FrameMaster switching scene=%d entering=%d", scene, entering);
+    if (entering) mRequestRepaint();
+}
+
+bool AthensFrameMasterRepaint::shouldRepaint() {
+    std::lock_guard lock(mMutex);
+    if (mActiveScene == 0 && !mInitialRepaintPending) return false;
+
+    if (std::chrono::steady_clock::now() >= mDeadline) {
+        ALOGW_IF(mActiveScene != 0, "Athens FrameMaster switching timed out for scene=%d",
+                 mActiveScene);
+        mActiveScene = 0;
+        mInitialRepaintPending = false;
+    }
+    // Preserve the first repaint even if both callback edges arrive within one frame.
+    const bool initial = std::exchange(mInitialRepaintPending, false);
+    return initial || mActiveScene != 0;
+}
+
+void AthensFrameMasterRepaint::clear() {
+    std::lock_guard lock(mMutex);
+    mActiveScene = 0;
+    mInitialRepaintPending = false;
+}
+
+} // namespace android
