+#pragma once
+
+#include <android-base/unique_fd.h>
+#include <utils/Looper.h>
+
+#include <functional>
+#include <utility>
+
+namespace android::athens {
+
+// The sample owns the watch. Neither the Looper callback nor its timeout owns the slot lease.
+class MotionVectorFenceWatch {
+public:
+    MotionVectorFenceWatch(const sp<Looper>& looper, base::unique_fd fd, nsecs_t deadline,
+                           std::function<void()> check)
+          : mLooper(looper), mFd(std::move(fd)), mCallback(sp<Callback>::make(std::move(check))) {
+        if (mFd.ok() && mLooper->addFd(mFd.get(), Looper::POLL_CALLBACK, Looper::EVENT_INPUT,
+                                       mCallback, nullptr) != 1) {
+            mFd.reset();
+        }
+        // The deadline is inclusive. Release a permanently pending slot even if no frame follows.
+        mLooper->sendMessageAtTime(deadline + 1, mCallback, Message());
+    }
+
+    ~MotionVectorFenceWatch() {
+        if (mFd.ok()) mLooper->removeFd(mFd.get());
+        mLooper->removeMessages(mCallback);
+    }
+
+    MotionVectorFenceWatch(const MotionVectorFenceWatch&) = delete;
+    MotionVectorFenceWatch& operator=(const MotionVectorFenceWatch&) = delete;
+
+private:
+    struct Callback final : LooperCallback, MessageHandler {
+        explicit Callback(std::function<void()> check) : check(std::move(check)) {}
+        int handleEvent(int, int, void*) override {
+            check();
+            return 0;
+        }
+        void handleMessage(const Message&) override { check(); }
+        const std::function<void()> check;
+    };
+
+    const sp<Looper> mLooper;
+    base::unique_fd mFd;
+    const sp<Callback> mCallback;
+};
+
+} // namespace android::athens
