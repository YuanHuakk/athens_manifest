+ * limitations under the License.
+ */
+
+#include "AthensMotionVectorQueue.h"
+
+#include "AthensMotionVectorEncoding.h"
+
+#include <binder/IPCThreadState.h>
+#include <gui/BufferQueueConsumer.h>
+#include <gui/BufferQueueCore.h>
+#include <gui/BufferQueueProducer.h>
+#include <hardware/gralloc.h>
+
+namespace android {
+namespace {
+
+class MotionVectorConsumer final : public BufferItemConsumer {
+public:
+    MotionVectorConsumer(const sp<IGraphicBufferProducer>& producer,
+                         const sp<IGraphicBufferConsumer>& consumer)
+          : BufferItemConsumer(producer, consumer, GRALLOC_USAGE_SW_READ_OFTEN,
+                               kAthensMotionVectorAcquiredBuffers, false) {}
+};
+
+class MotionVectorProducer final : public BufferQueueProducer {
+public:
+    MotionVectorProducer(const sp<BufferQueueCore>& core, int32_t uid, int32_t pid,
+                         nsecs_t maximumDequeueTimeout, std::shared_ptr<std::atomic_bool> revoked)
+          : BufferQueueProducer(core),
+            mUid(uid),
+            mPid(pid),
+            mMaximumDequeueTimeout(maximumDequeueTimeout),
+            mRevoked(std::move(revoked)) {}
+
+    status_t onTransact(uint32_t code, const Parcel& data, Parcel* reply, uint32_t flags) override {
+        const auto* ipc = IPCThreadState::self();
+        if (mRevoked->load() || ipc->getCallingUid() != static_cast<uid_t>(mUid) ||
+            ipc->getCallingPid() != mPid) {
+            return PERMISSION_DENIED;
+        }
+        return BufferQueueProducer::onTransact(code, data, reply, flags);
+    }
+
+    status_t attachBuffer(int*, const sp<GraphicBuffer>&) override { return PERMISSION_DENIED; }
+    status_t extendSlotCount(int) override { return PERMISSION_DENIED; }
+    status_t setSidebandStream(const sp<NativeHandle>&) override { return PERMISSION_DENIED; }
+
+    status_t setMaxDequeuedBufferCount(int count) override {
+        if (count > kAthensMotionVectorAcquiredBuffers) return BAD_VALUE;
+        return BufferQueueProducer::setMaxDequeuedBufferCount(count);
+    }
+
+    status_t setSharedBufferMode(bool enable) override {
+        return enable ? PERMISSION_DENIED : BufferQueueProducer::setSharedBufferMode(false);
+    }
+
+    status_t dequeueBuffer(int* outSlot, sp<Fence>* outFence, uint32_t width, uint32_t height,
+                           PixelFormat format, uint64_t usage, uint64_t* outBufferAge,
+                           FrameEventHistoryDelta* outTimestamps) override {
+        constexpr uint64_t kAllowedUsage = GRALLOC_USAGE_HW_RENDER | GRALLOC_USAGE_HW_TEXTURE |
+                GRALLOC_USAGE_SW_READ_MASK;
+        if (width != athens::kMotionVectorColumns || height != athens::kMotionVectorRows ||
+            (format != PIXEL_FORMAT_RGBA_8888 && format != PIXEL_FORMAT_RGBA_1010102) ||
+            (usage & ~kAllowedUsage) != 0) {
+            return BAD_VALUE;
+        }
+        return BufferQueueProducer::dequeueBuffer(outSlot, outFence, width, height, format, usage,
+                                                  outBufferAge, outTimestamps);
+    }
+
+    status_t setDequeueTimeout(nsecs_t timeout) override {
+        if (timeout < 0 || timeout > mMaximumDequeueTimeout) return BAD_VALUE;
+        return BufferQueueProducer::setDequeueTimeout(timeout);
+    }
+
+    // The checked dequeueBuffer path also handles allocation.
+    void allocateBuffers(uint32_t, uint32_t, PixelFormat, uint64_t) override {}
+
+private:
+    const int32_t mUid;
+    const int32_t mPid;
+    const nsecs_t mMaximumDequeueTimeout;
+    const std::shared_ptr<std::atomic_bool> mRevoked;
+};
+
+} // namespace
+
+std::optional<AthensMotionVectorQueue> createAthensMotionVectorQueue(int32_t uid, int32_t pid,
+                                                                   nsecs_t maximumDequeueTimeout) {
+    auto core = sp<BufferQueueCore>::make();
+    auto revoked = std::make_shared<std::atomic_bool>(false);
+    auto producer = sp<MotionVectorProducer>::make(core, uid, pid, maximumDequeueTimeout, revoked);
+    auto consumer = sp<MotionVectorConsumer>::make(producer, sp<BufferQueueConsumer>::make(core));
+    if (producer->setDequeueTimeout(0) != OK) return std::nullopt;
+    return AthensMotionVectorQueue{IInterface::asBinder(producer), std::move(consumer),
+                                    std::move(revoked)};
+}
+
+} // namespace android
