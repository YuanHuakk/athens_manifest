+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "../../AthensMotionVectorEncoding.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <vector>
+
+namespace {
+
+using android::athens::encodeMotionVectors;
+using android::athens::idleMotionVectorPayload;
+using android::athens::MotionVectorFormat;
+using android::athens::MotionVectorImage;
+using android::athens::MotionVectorPayload;
+
+void check(bool ok, const char* message) {
+    if (!ok) {
+        std::fprintf(stderr, "%s\n", message);
+        std::exit(EXIT_FAILURE);
+    }
+}
+
+void writePixel(std::vector<std::byte>& data, size_t x, size_t y, size_t stride, uint32_t pixel) {
+    for (size_t byte = 0; byte < 4; ++byte) {
+        data[y * stride + x * 4 + byte] = static_cast<std::byte>(pixel >> (byte * 8));
+    }
+}
+
+void checkRgba8888() {
+    constexpr size_t kRowBytes = 64 * 4;
+    std::vector<std::byte> pixels(kRowBytes * 27, std::byte{0x7f});
+    writePixel(pixels, 1, 2, kRowBytes, 0xff);
+    writePixel(pixels, 2, 1, kRowBytes, 0xffff);
+    writePixel(pixels, 59, 26, kRowBytes, 0);
+    MotionVectorPayload payload;
+    check(encodeMotionVectors({pixels, 60, 27, kRowBytes, MotionVectorFormat::Rgba8888}, 1156, 2510,
+                              payload),
+          "RGBA_8888 should encode");
+    const std::array<float, 14> header = {16000, 16724, 17741, 0, 4095, 4096,  1,
+                                          0,     1,     0,     2, 4121, 20482, 1620};
+    const std::array<float, 4> footer = {4096, 1040, 43890, 0};
+    check(std::equal(header.begin(), header.end(), payload.begin()), "wrong 406 header");
+    check(payload[14] == 0 && payload[14 + 27 + 2] == 4774330 &&
+                  payload[14 + 2 * 27 + 1] == 4774881 && payload[1633] == 8890810,
+          "wrong 406 words or column order");
+    check(std::equal(footer.begin(), footer.end(), payload.begin() + 1634), "wrong 406 footer");
+    check(std::all_of(payload.begin() + 1638, payload.end(), [](float x) { return x == 40000; }),
+          "wrong 406 tail");
+}
+
+void checkRgba1010102() {
+    // Validate both ceil stepping and the stock last-column sample into allocated row padding.
+    constexpr size_t kRowBytes = 124 * 4;
+    std::vector<std::byte> pixels(kRowBytes * 54);
+    writePixel(pixels, 2, 4, kRowBytes, 509 | (509 << 10));
+    writePixel(pixels, 118, 52, kRowBytes, 1023 | (1023 << 10));
+    MotionVectorPayload payload;
+    check(encodeMotionVectors({pixels, 117, 54, kRowBytes, MotionVectorFormat::Rgba1010102}, 1156,
+                              2510, payload),
+          "RGBA_1010102 with row padding should encode");
+    check(payload[14] == 8890810 && payload[14 + 27 + 2] == 0 && payload[1633] == 4774881,
+          "wrong 10-bit channel extraction or sampling step");
+    writePixel(pixels, 2, 4, kRowBytes, (509 << 20) | (509 << 10));
+    writePixel(pixels, 118, 52, kRowBytes, (1023 << 20) | (1023 << 10));
+    MotionVectorPayload nativeImport;
+    check(encodeMotionVectors({pixels, 117, 54, kRowBytes, MotionVectorFormat::Rgba1010102XHigh},
+                              1156, 2510, nativeImport) && nativeImport == payload,
+          "native AHB import must retain the OEM vector's logical B/G channels");
+}
+
+void checkUnsafeBuffers() {
+    constexpr size_t kRowBytes = 60 * 4;
+    std::vector<std::byte> pixels(kRowBytes * 27);
+    MotionVectorPayload payload = idleMotionVectorPayload();
+    const MotionVectorImage valid{pixels, 60, 27, kRowBytes, MotionVectorFormat::Rgba8888};
+    MotionVectorImage invalid = valid;
+    invalid.bytes = std::span(pixels).first(pixels.size() - 1);
+    check(!encodeMotionVectors(invalid, 1156, 2510, payload), "truncated backing length accepted");
+    invalid = valid;
+    invalid.rowBytes = std::numeric_limits<size_t>::max() & ~size_t{3};
+    check(!encodeMotionVectors(invalid, 1156, 2510, payload), "overflowing row stride accepted");
+    invalid = valid;
+    invalid.rowBytes = kRowBytes - 4;
+    check(!encodeMotionVectors(invalid, 1156, 2510, payload), "short row accepted");
+    invalid = valid;
+    invalid.rowBytes += 1;
+    check(!encodeMotionVectors(invalid, 1156, 2510, payload), "fractional pixel stride accepted");
+    invalid = valid;
+    invalid.height = 26;
+    check(!encodeMotionVectors(invalid, 1156, 2510, payload), "out-of-height sample accepted");
+    invalid = valid;
+    invalid.format = static_cast<MotionVectorFormat>(255);
+    check(!encodeMotionVectors(invalid, 1156, 2510, payload), "unsupported format accepted");
+    check(!encodeMotionVectors(valid, 0, 2510, payload), "zero scale accepted");
+    check(payload == idleMotionVectorPayload(), "failed validation modified the payload");
+    check(std::all_of(payload.begin(), payload.end(), [](float x) { return x == 40000; }),
+          "idle payload must be entirely sentinel words");
+}
+
+} // namespace
+
+int main() {
+    checkRgba8888();
+    checkRgba1010102();
+    checkUnsafeBuffers();
+    return EXIT_SUCCESS;
+}
