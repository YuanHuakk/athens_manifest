+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <vulkan/vulkan.h>
+
+#include <cstdint>
+
+// Private, process-local ABI between the trusted Android Vulkan loader and the 406 bridge.
+// Handles are the actual app handles passed by the OEM render callback. The loader owns validation
+// of the command recording, image creation and render-pass state, lower driver dispatch, and WSI.
+struct AthensMiVkRenderInput {
+    VkCommandBuffer commandBuffer;
+    VkImage sourceImage;
+    VkExtent2D sourceExtent;
+    VkExtent2D vectorExtent;
+    uint32_t vectorPixelFormat;
+    uint64_t surfaceGeneration;
+};
+
+struct AthensMiVkRenderCallbacks {
+    uint32_t version;
+    uint32_t size;
+    void* context;
+    bool (*isArmed)(void* context);
+    VkResult (*record)(void* context, const AthensMiVkRenderInput* input);
+    void (*retire)(void* context, uint64_t surfaceGeneration);
+    // Optional. A null observer or return value leaves the OEM proc address unchanged.
+    PFN_vkVoidFunction (*observeDeviceProc)(void* context, VkDevice device, const char* name,
+                                            PFN_vkVoidFunction downstream);
+};
+
+inline constexpr uint32_t kAthensMiVkRenderAbiVersion = 1;
+
+// Install immutable, process-lifetime callbacks before activating the bridge's Vulkan layer.
+extern "C" bool AthensMiVkInstallRenderCallbacks(const AthensMiVkRenderCallbacks* callbacks);
+extern "C" int AthensMiVkProducerAbiVersion();
+extern "C" bool AthensMiVkProducerBindOem(void* oemHandle);
+extern "C" PFN_vkVoidFunction AthensMiVkObserveDeviceProc(VkDevice device, const char* name,
+                                                         PFN_vkVoidFunction downstream);
