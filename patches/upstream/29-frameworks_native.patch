+
+bool SurfaceFlinger::isAthensMotionVectorSessionLive(
+        const AthensMotionVectorSession& session) const {
+    if (getHwComposer().isHeadless() || session.displayId != getPrimaryDisplayIdLocked() ||
+        !mPhysicalDisplays.get(session.displayId).transform(&PhysicalDisplay::isInternal)
+                 .value_or(false)) {
+        return false;
+    }
+    const auto display = getDisplayDeviceLocked(session.displayId);
+    if (!display || display->getPowerMode() != hal::PowerMode::ON) return false;
+
+    const auto* task = mLayerLifecycleManager.getLayerFromId(session.taskLayerId);
+    return task && task->handleAlive && task->ownerUid.val() == AID_SYSTEM &&
+            task->ownerPid.val() == session.controllerPid &&
+            task->metadata.getInt32(gui::METADATA_TASK_ID, -1) == session.taskId;
+}
+
+bool SurfaceFlinger::isAthensMotionVectorGameLayer(const AthensMotionVectorSession& session,
+                                                  uint32_t layerId) const {
+    const auto* layer = mLayerLifecycleManager.getLayerFromId(layerId);
+    const auto* snapshot = mLayerSnapshotBuilder.getSnapshot(layerId);
+    const auto display = getDisplayDeviceLocked(session.displayId);
+    if (!layer || !layer->handleAlive || layer->ownerUid.val() != session.uid ||
+        layer->ownerPid.val() != session.pid || layer->isProtected() || !snapshot ||
+        !snapshot->isVisible || snapshot->isSecure || !display ||
+        snapshot->outputFilter.layerStack != display->getLayerStack()) {
+        return false;
+    }
+    for (size_t depth = 0; layer && depth < MAX_LAYERS; ++depth) {
+        if (layer->parentId == session.taskLayerId) return true;
+        layer = mLayerLifecycleManager.getLayerFromId(layer->parentId);
+    }
+    return false;
+}
+
+std::optional<nsecs_t> SurfaceFlinger::athensMotionVectorPresentDeadline(
+        PhysicalDisplayId displayId) const {
+    if (!mAthensMotionVectorSession) return std::nullopt;
+    const auto& session = *mAthensMotionVectorSession;
+    if (!session.armed || session.displayId != displayId || session.gameFrameNumber == 0 ||
+        session.gameFrameNumber != session.lastMatchedGameFrameNumber ||
+        session.lastStagedTime != session.gameLatchTime ||
+        !isAthensMotionVectorGameLayer(session, session.gameLayerId)) {
+        return std::nullopt;
+    }
+
+    const auto activeMode = mDisplayModeController.getActiveMode(displayId).modePtr;
+    const nsecs_t deadline = session.gameLatchTime + kAthensMotionVectorFreshnessNs;
+    if (!activeMode || activeMode->getVsyncRate().getIntValue() != 120 ||
+        deadline <= systemTime() ||
+        std::none_of(mLayersWithQueuedFrames.begin(), mLayersWithQueuedFrames.end(),
+                     [&](const auto& layer) { return layer.first->sequence == session.gameLayerId; })) {
+        return std::nullopt;
+    }
+    return deadline;
+}
+
+void SurfaceFlinger::trackAthensMotionVectorGameFrame(
+        const std::vector<QueuedTransactionState>& transactions, const Layer& layer,
+        nsecs_t latchTime) {
+    auto& session = *mAthensMotionVectorSession;
+    session.gameFrameNumber = 0;
+    session.gameBufferId = 0;
+    session.gameLatchHasProcessPid = false;
+    session.gameLatchTime = 0;
+    if (!isAthensMotionVectorGameLayer(session, layer.sequence) || !layer.hasBuffer()) return;
+
+    const uint64_t latchedFrame = layer.mBufferInfo.mFrameNumber;
+    const uint64_t latchedBufferId = layer.getLatchedBufferId();
+    for (auto tx = transactions.rbegin(); tx != transactions.rend(); ++tx) {
+        for (auto state = tx->states.rbegin(); state != tx->states.rend(); ++state) {
+            const auto& buffer = state->state.bufferData;
+            if (state->layerId != layer.sequence || !state->state.hasBufferChanges()) continue;
+            // BLAST submits one-way, so Binder supplies a UID but no PID. Bind its release
+            // endpoint to the authenticated synchronous publisher and match the actual
+            // native buffer ID as well as the layer and frame number before using a vector.
+            const bool fromGamePid = tx->originPid == session.pid;
+            const bool fromGameBlast = tx->originPid == 0 && (tx->flags & ISurfaceComposer::eOneWay) &&
+                    buffer && session.releaseEndpoint &&
+                    buffer->releaseBufferEndpoint == session.releaseEndpoint;
+            // setTransactionState resolves cached buffers into BufferData. Layer::setBuffer
+            // moves the transaction's externalTexture into the layer before this latch.
+            if (tx->originUid == session.uid && (fromGamePid || fromGameBlast) && buffer &&
+                buffer->hasBuffer() && buffer->frameNumber == latchedFrame &&
+                buffer->getId() == latchedBufferId) {
+                session.gameFrameNumber = latchedFrame;
+                session.gameBufferId = latchedBufferId;
+                session.gameLatchHasProcessPid = fromGamePid;
+                session.gameLatchTime = latchTime;
+                while (!session.pendingTickets.empty() &&
+                       session.pendingTickets.front().gameFrameNumber <= latchedFrame) {
+                    const auto ticket = session.pendingTickets.front();
+                    session.pendingTickets.pop_front();
+                    if (ticket.gameFrameNumber == latchedFrame && session.matchesGameBuffer(ticket.gameBufferId) &&
+                        systemTime() <= ticket.expiresAt &&
+                        receiveAthensMotionVectorSample(session.generation, session.uid, session.pid,
+                                layer.sequence, latchedFrame, ticket.vectorFrameNumber, ticket.xHigh10)) return;
+                    if (!mAthensMotionVectorSession) return;
+                    discardAthensMotionVectorBuffers(session.consumer, ticket.vectorFrameNumber, systemTime());
+                }
+            }
+            return;
+        }
+    }
+}
+
+sp<IBinder> SurfaceFlinger::openAthensMotionVectorIngress(int64_t generation, int32_t uid,
+                                                        int32_t pid, uint32_t gameLayerId) {
+    if (!mAthensMotionVectorSession) return nullptr;
+    auto& session = *mAthensMotionVectorSession;
+    if (session.generation != generation || session.uid != uid || session.pid != pid ||
+        !isAthensMotionVectorSessionLive(session) ||
+        !isAthensMotionVectorGameLayer(session, gameLayerId)) {
+        return nullptr;
+    }
+    if (session.producer) {
+        return session.gameLayerId == gameLayerId ? session.producer : nullptr;
+    }
+
+    // The raw vector queue has no SurfaceControl and never enters display composition.
+    auto queue = createAthensMotionVectorQueue(uid, pid, kAthensMotionVectorFreshnessNs);
+    if (!queue) return nullptr;
+    session.producer = std::move(queue->producer);
+    session.consumer = std::move(queue->consumer);
+    session.producerRevoked = std::move(queue->revoked);
+    session.gameLayerId = gameLayerId;
+    return session.producer;
+}
+
+bool SurfaceFlinger::receiveAthensMotionVectorSample(int64_t generation, int32_t uid,
+                                                     int32_t pid, uint32_t gameLayerId,
+                                                     uint64_t gameFrameNumber,
+                                                     uint64_t vectorFrameNumber, bool xHigh10) {
+    const nsecs_t now = systemTime();
+    updateAthensMotionVectorIngress(now);
+    if (!mAthensMotionVectorSession) return false;
+    auto& session = *mAthensMotionVectorSession;
+    if (session.generation != generation || session.uid != uid || session.pid != pid ||
+        !session.consumer || session.gameLayerId != gameLayerId ||
+        session.gameFrameNumber != gameFrameNumber ||
+        gameFrameNumber <= session.lastMatchedGameFrameNumber ||
+        vectorFrameNumber <= session.lastVectorFrameNumber ||
+        !isAthensMotionVectorSessionLive(session) ||
+        now - session.gameLatchTime > kAthensMotionVectorFreshnessNs) {
+        return false;
+    }
+
+    for (int i = 0; i < kAthensMotionVectorAcquiredBuffers; ++i) {
+        BufferItem item;
+        // This overload does not wait for the acquire fence. A nonzero present time makes
+        // BufferQueue enforce the frame ceiling, so discarding stale slots cannot consume a
+        // future frame whose ticket has not arrived yet.
+        if (session.consumer->acquireBuffer(&item, now, vectorFrameNumber) != OK) return false;
+        auto lease = std::make_shared<AthensMotionVectorSlotLease>(session.consumer, std::move(item));
+        const auto& acquired = lease->item;
+        if (acquired.mFrameNumber < vectorFrameNumber) continue;
+        if (acquired.mFrameNumber != vectorFrameNumber || !acquired.mGraphicBuffer ||
+            (acquired.mGraphicBuffer->getUsage() & GRALLOC_USAGE_PROTECTED) != 0 ||
+            !acquired.mFence || !acquired.mFence->isValid()) {
+            return false;
+        }
+
+        session.lastMatchedGameFrameNumber = gameFrameNumber;
+        session.lastVectorFrameNumber = vectorFrameNumber;
+        session.lastMatchedTime = session.gameLatchTime;
+        mAthensMotionVectorSample.emplace(AthensMotionVectorSample{
+                acquired.mGraphicBuffer, acquired.mFence, std::move(lease), session.gameLatchTime,
+                xHigh10});
+        updateAthensMotionVectorIngress(systemTime());
+        return true;
+    }
+    return false;
+}
+
+void SurfaceFlinger::updateAthensMotionVectorIngress(nsecs_t now) {
+    if (!mAthensMotionVectorSession || !mAthensMotionVectorSession->consumer) return;
+    auto& session = *mAthensMotionVectorSession;
+    if (!isAthensMotionVectorGameLayer(session, session.gameLayerId)) {
+        closeAthensMotionVectorSession();
+        return;
+    }
+    while (!session.pendingTickets.empty() && now > session.pendingTickets.front().expiresAt) {
+        discardAthensMotionVectorBuffers(session.consumer, session.pendingTickets.front().vectorFrameNumber, now);
+        session.pendingTickets.pop_front();
+    }
+    if (mAthensMotionVectorSample) {
+        auto& sample = *mAthensMotionVectorSample;
+        const nsecs_t deadline = sample.gameLatchTime + kAthensMotionVectorFreshnessNs;
+        const nsecs_t signalTime = sample.acquireFence->getSignalTime();
+        // Queue draining and layer traversal may have taken time since the caller sampled now.
+        now = systemTime();
+        const bool verified = Fence::isValidTimestamp(signalTime) && signalTime <= deadline;
+        if (verified) session.lastStagedTime = sample.gameLatchTime;
+
+        const bool currentFrame = session.gameFrameNumber == session.lastMatchedGameFrameNumber;
+        if (verified && session.armed && now <= deadline && currentFrame) {
+            mAthensMotionVector->submit(session.generation, sample.buffer, sample.acquireFence,
+                                        std::move(sample.lease), sample.xHigh10);
+            mAthensMotionVectorSample.reset();
+        } else if (!currentFrame || now > deadline || signalTime == Fence::SIGNAL_TIME_INVALID) {
+            mAthensMotionVectorSample.reset();
+        } else if (signalTime == Fence::SIGNAL_TIME_PENDING && !sample.fenceWatch) {
+            const auto check = [weak = wp<SurfaceFlinger>::fromExisting(this),
+                                generation = session.generation,
+                                game = session.lastMatchedGameFrameNumber,
+                                vector = session.lastVectorFrameNumber]()
+                                       FTL_FAKE_GUARD(kMainThreadContext) {
+                const auto flinger = weak.promote();
+                if (!flinger) return;
+                Mutex::Autolock lock(flinger->mStateLock);
+                const auto& current = flinger->mAthensMotionVectorSession;
+                if (!current || !flinger->mAthensMotionVectorSample ||
+                    current->generation != generation || current->lastMatchedGameFrameNumber != game ||
+                    current->lastVectorFrameNumber != vector) {
+                    return;
+                }
+                if (!flinger->isAthensMotionVectorSessionLive(*current)) {
+                    flinger->closeAthensMotionVectorSession();
+                    return;
+                }
+                flinger->updateAthensMotionVectorIngress(systemTime());
+            };
+            sample.fenceWatch = std::make_unique<athens::MotionVectorFenceWatch>(
+                    mScheduler->getMainThreadLooper(),
+                    base::unique_fd(fcntl(sample.acquireFence->get(), F_DUPFD_CLOEXEC, 0)),
+                    deadline, check);
+        }
+    }
+    if (session.lastMatchedTime > 0 && now - session.lastMatchedTime > kAthensMotionVectorIdleNs) {
+        if (session.armed) mAthensMotionVector->idle(session.generation);
+        mAthensMotionVectorSample.reset();
+        session.lastMatchedTime = 0;
+    }
+}
+
+void SurfaceFlinger::closeAthensMotionVectorSession() {
+    if (mAthensMotionVectorSession) {
+        const auto& session = *mAthensMotionVectorSession;
+        if (session.producerRevoked) session.producerRevoked->store(true);
+        if (session.armed) mAthensMotionVector->deactivate(session.generation);
+        mAthensMotionVectorSample.reset();
+        if (session.consumer) session.consumer->abandon();
+    }
+    mAthensMotionVectorSession.reset();
+}
