+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <android-base/unique_fd.h>
+#include <android/hardware_buffer.h>
+#include <vulkan/vulkan.h>
+#include <vulkan/vulkan_android.h>
+
+#include <cstdint>
+#include <memory>
+
+namespace vulkan::athens {
+
+// The destination is always native AHB RGBA_1010102. These values specify which
+// stored channel the consumer must use as the X component of the motion vector.
+enum class MotionVectorLayout {
+    XLow10YMiddle10,   // Native A2B10G10R10 source: X is logical R.
+    XHigh10YMiddle10,  // 406 A2R10G10B10 source: X is logical B.
+};
+
+// Every handle and function must belong to the same lower Vulkan driver. The
+// caller externally serializes access and keeps the device/source image alive.
+class AthensMotionVectorImage final {
+   public:
+    struct Dispatch {
+        PFN_vkGetPhysicalDeviceFormatProperties getFormatProperties;
+        PFN_vkGetPhysicalDeviceExternalSemaphoreProperties
+            getExternalSemaphoreProperties;
+        PFN_vkGetAndroidHardwareBufferPropertiesANDROID
+            getHardwareBufferProperties;
+        PFN_vkCreateImage createImage;
+        PFN_vkDestroyImage destroyImage;
+        PFN_vkAllocateMemory allocateMemory;
+        PFN_vkFreeMemory freeMemory;
+        PFN_vkBindImageMemory bindImageMemory;
+        PFN_vkCmdPipelineBarrier cmdPipelineBarrier;
+        PFN_vkCmdBlitImage cmdBlitImage;
+        PFN_vkCreateSemaphore createSemaphore;
+        PFN_vkDestroySemaphore destroySemaphore;
+        PFN_vkGetSemaphoreFdKHR getSemaphoreFd;
+        PFN_vkCreateFence createFence;
+        PFN_vkDestroyFence destroyFence;
+        PFN_vkGetFenceStatus getFenceStatus;
+        PFN_vkQueueSubmit queueSubmit;
+    };
+
+    enum class CompletionMode { Owned, PresentSyncFd };
+
+    struct Source {
+        VkImage image;
+        VkFormat format;
+        VkExtent2D extent;
+        VkImageUsageFlags usage;
+        VkImageCreateFlags flags;
+        VkImageTiling tiling;
+        VkSampleCountFlagBits samples;
+        VkImageLayout layout;
+        // VK_QUEUE_FAMILY_IGNORED is valid only for an actually concurrent
+        // image.
+        uint32_t queueFamily;
+        VkPipelineStageFlags beforeStages;
+        VkAccessFlags beforeAccess;
+        VkPipelineStageFlags afterStages;
+        VkAccessFlags afterAccess;
+    };
+
+    struct DestinationRelease {
+        enum class Kind {
+            SyncFd,
+            Unused,
+            DequeuedWithoutFence,
+        };
+        // Unused attests the buffer has never been handed to a consumer.
+        // DequeuedWithoutFence attests a successful exclusive dequeue with a
+        // proven NO_FENCE release.
+        Kind kind = Kind::SyncFd;
+        // Borrowed SYNC_FD from the latest dequeue of this slot. A pending
+        // fence leaves the command buffer untouched.
+        int syncFd = -1;
+    };
+
+    struct Submission {
+        // In Owned mode, insert this semaphore in the same submission's signal
+        // list.
+        VkSemaphore signalSemaphore = VK_NULL_HANDLE;
+        // In Owned mode, pass this fence to vkQueueSubmit for that submission.
+        VkFence completionFence = VK_NULL_HANDLE;
+        MotionVectorLayout layout = MotionVectorLayout::XLow10YMiddle10;
+    };
+
+    static constexpr uint32_t kWidth = 60;
+    static constexpr uint32_t kHeight = 27;
+
+    // Imports a slot's real AHB and retains its own reference until
+    // destruction.
+    static VkResult import(VkPhysicalDevice physicalDevice,
+                           VkDevice device,
+                           const Dispatch& dispatch,
+                           AHardwareBuffer* buffer,
+                           std::unique_ptr<AthensMotionVectorImage>& output,
+                           CompletionMode mode = CompletionMode::Owned);
+
+    AthensMotionVectorImage(const AthensMotionVectorImage&) = delete;
+    AthensMotionVectorImage& operator=(const AthensMotionVectorImage&) = delete;
+    // The owner must retain pending jobs until tryRetire succeeds. Destruction
+    // never waits.
+    ~AthensMotionVectorImage();
+
+    // Call outside a render pass. The source layout is restored before
+    // returning from the recorded command sequence. At most one recording is
+    // outstanding.
+    VkResult record(VkCommandBuffer cmd,
+                    uint32_t queueFamily,
+                    const Source& source,
+                    DestinationRelease release,
+                    Submission& output);
+
+    // Report the actual submission covering this recording. Owned mode uses
+    // both returned handles.
+    VkResult markSubmitted(VkResult submitResult);
+    // Owned mode only. Export transfers a real FD and consumes the semaphore
+    // signal.
+    VkResult exportSyncFd(android::base::unique_fd& output);
+    // PresentSyncFd mode only. Transfer a duplicate from the exact WSI Present
+    // wait covering this write.
+    VkResult attachPresentSyncFd(android::base::unique_fd completion);
+    // Retire an unpaired write on its original, externally synchronized queue.
+    // This fence is for lifetime only and cannot authorize publication.
+    VkResult fenceDiscardedWrite(VkQueue queue);
+    // Returns VK_NOT_READY while completion is absent or unsignaled.
+    VkResult tryRetire();
+    // Before canceling, invalidate/reset the unsubmitted recording at its
+    // owner.
+    void cancelRecording();
+    // Final teardown only, after the lower device reports idle.
+    void retireAfterDeviceIdle();
+
+   private:
+    enum class State { Idle, Recorded, Submitted };
+
+    AthensMotionVectorImage(VkDevice device,
+                            const Dispatch& dispatch,
+                            AHardwareBuffer* buffer,
+                            CompletionMode mode);
+    void destroySubmission();
+
+    VkDevice mDevice;
+    Dispatch mDispatch;
+    AHardwareBuffer* mBuffer;
+    CompletionMode mCompletionMode;
+    VkImage mImage = VK_NULL_HANDLE;
+    VkDeviceMemory mMemory = VK_NULL_HANDLE;
+    VkSemaphore mSemaphore = VK_NULL_HANDLE;
+    VkFence mFence = VK_NULL_HANDLE;
+    android::base::unique_fd mPresentSyncFd;
+    State mState = State::Idle;
+    bool mNativeSourceSupported = false;
+    bool mStockSourceSupported = false;
+    bool mEverSubmitted = false;
+    bool mExported = false;
+    bool mDeviceLost = false;
+};
+
+}  // namespace vulkan::athens
