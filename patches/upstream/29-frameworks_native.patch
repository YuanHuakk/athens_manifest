+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+
+#include <vulkan/vulkan.h>
+
+namespace vulkan::athens {
+
+// Android may report a transform mismatch after the native window has queued the frame.
+constexpr bool isSuccessfulPresent(VkResult result) {
+    return result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR;
+}
+
+// Correlates one vector write with a single Vulkan submission and actual platform WSI enqueue.
+// The caller serializes events, tracks resource generations and supplies only identities obtained
+// from platform-owned objects and Vulkan calls. The vector buffer, fences and GPU lifetime are
+// owned by the caller. This class neither queues buffers nor locks a consumer lease.
+class AthensVulkanFrameWitness {
+public:
+    AthensVulkanFrameWitness() = default;
+    AthensVulkanFrameWitness(const AthensVulkanFrameWitness&) = delete;
+    AthensVulkanFrameWitness& operator=(const AthensVulkanFrameWitness&) = delete;
+
+    struct VectorSlot {
+        int32_t slot;
+        // Strictly increasing across all vector writes in this session, even when a slot recurs.
+        uint64_t generation;
+        uint64_t bufferId;
+        bool operator==(const VectorSlot&) const = default;
+    };
+
+    struct Recording {
+        VkDevice device;
+        VkCommandBuffer commandBuffer;
+        uint64_t generation;
+        VkCommandBufferLevel level;
+        VkCommandBufferUsageFlags usage;
+        bool operator==(const Recording&) const = default;
+    };
+
+    struct ColorFrame {
+        VkSwapchainKHR swapchain;
+        uint64_t swapchainGeneration;
+        VkImage image;
+        uint32_t imageIndex;
+        uint64_t surfaceGeneration;
+        bool operator==(const ColorFrame&) const = default;
+    };
+
+    struct Semaphore {
+        VkSemaphore handle;
+        uint64_t signalGeneration;
+        VkSemaphoreType type;
+        bool operator==(const Semaphore&) const = default;
+    };
+
+    struct Submit {
+        VkQueue queue;
+        VkResult result;
+        uint32_t batchCount;
+        std::span<const Recording> recordings;
+        std::span<const VkSemaphore> waits;
+        std::span<const Semaphore> signals;
+        // Present image proved by the adapter's rendering observation for this submission.
+        // An unrelated image, or an inference based just on the queue or its timing, is insufficient.
+        ColorFrame color;
+    };
+
+    struct Present {
+        VkQueue queue;
+        uint32_t swapchainCount;
+        std::span<const Semaphore> waits;
+        ColorFrame color;
+    };
+
+    struct Pair {
+        VectorSlot vector;
+        ColorFrame color;
+        uint64_t nativeFrameNumber;
+    };
+
+    struct Enqueue {
+        VkResult releaseImageResult;
+        int queueStatus;
+        uint64_t nextFrameNumber;
+        int acquireFenceFd;
+    };
+
+    struct Retirement {
+        VectorSlot vector;
+        Recording recording;
+        // A recorded write can still be submitted. Before returning the slot, the caller must
+        // retire the recording and wait for any GPU writes, including after an unsupported call.
+        bool commandsMayReferenceSlot;
+    };
+
+    [[nodiscard]] bool arm(VectorSlot vector, Recording recording) {
+        if (mPhase != Phase::Empty || vector.slot < 0 || vector.bufferId == 0 ||
+            vector.generation <= mLastVectorGeneration || recording.device == VK_NULL_HANDLE ||
+            recording.commandBuffer == VK_NULL_HANDLE || recording.generation == 0 ||
+            recording.level != VK_COMMAND_BUFFER_LEVEL_PRIMARY ||
+            recording.usage != VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT) {
+            return false;
+        }
+        mLastVectorGeneration = vector.generation;
+        mVector = vector;
+        mRecording = recording;
+        mCommandsMayReferenceSlot = false;
+        mPhase = Phase::Armed;
+        return true;
+    }
+
+    // Call immediately before recording the verified vector write. Failure must prevent the write.
+    [[nodiscard]] bool beginVectorWrite(VectorSlot vector, Recording recording) {
+        if (mPhase != Phase::Armed || mVector != vector || mRecording != recording) return false;
+
+        mCommandsMayReferenceSlot = true;
+        mPhase = Phase::Writing;
+        return true;
+    }
+
+    // Call only after the adapter has recorded the write into this command buffer.
+    [[nodiscard]] bool finishVectorWrite(VectorSlot vector, Recording recording) {
+        if (mPhase != Phase::Writing || mVector != vector || mRecording != recording) return false;
+
+        mPhase = Phase::Recorded;
+        return true;
+    }
+
+    // The tracked vkEndCommandBuffer must also succeed before the recording can be submitted.
+    [[nodiscard]] bool endRecording(Recording recording, VkResult result) {
+        if (mPhase != Phase::Recorded || mRecording != recording) return false;
+
+        if (result != VK_SUCCESS) {
+            invalidate();
+            return false;
+        }
+        mPhase = Phase::Executable;
+        return true;
+    }
+
+    // Supply the full legacy vkQueueSubmit for observed calls in the tracked submission scope.
+    // Unknown or unsupported submission paths that may touch the state must call invalidate().
+    [[nodiscard]] bool observeSubmit(const Submit& submit) {
+        if (mPhase == Phase::Empty || mPhase == Phase::Invalid) {
+            return false;
+        }
+        // Bound work and fail closed if any references may be hidden by an oversized submission.
+        if (submit.recordings.size() > kMaxSubmitEntries || submit.waits.size() > kMaxSubmitEntries ||
+            submit.signals.size() > kMaxSubmitEntries) {
+            invalidate();
+            return false;
+        }
+        unsigned matchingRecordings = 0;
+        for (const Recording& recording : submit.recordings) {
+            if (recording.commandBuffer == mRecording.commandBuffer) ++matchingRecordings;
+        }
+        if (mPhase == Phase::Submitted || mPhase == Phase::Presenting) {
+            bool touchesSemaphore = false;
+            for (VkSemaphore wait : submit.waits) {
+                touchesSemaphore |= wait == mSignal.handle;
+            }
+            for (const Semaphore& signal : submit.signals) {
+                touchesSemaphore |= signal.handle == mSignal.handle;
+            }
+            if (matchingRecordings || touchesSemaphore) invalidate();
+            return false;
+        }
+        if (matchingRecordings == 0) return false;
+
+        if (mPhase != Phase::Executable || submit.queue == VK_NULL_HANDLE ||
+            submit.result != VK_SUCCESS || submit.batchCount != 1 || matchingRecordings != 1 ||
+            submit.signals.size() != 1 ||
+            !isBinarySignal(submit.signals.front()) || !isColorFrameValid(submit.color)) {
+            invalidate();
+            return false;
+        }
+        for (const auto& recording : submit.recordings) {
+            if (recording.device != mRecording.device || recording.generation == 0 ||
+                recording.level != VK_COMMAND_BUFFER_LEVEL_PRIMARY ||
+                (recording.commandBuffer == mRecording.commandBuffer && recording != mRecording)) {
+                invalidate();
+                return false;
+            }
+        }
+        for (VkSemaphore wait : submit.waits) {
+            if (wait == submit.signals.front().handle) {
+                invalidate();
+                return false;
+            }
+        }
+        mQueue = submit.queue;
+        mSignal = submit.signals.front();
+        mColor = submit.color;
+        mPhase = Phase::Submitted;
+        return true;
+    }
+
+    [[nodiscard]] bool beginPresent(const Present& present) {
+        if (mPhase != Phase::Submitted) return false;
+
+        if (present.queue != mQueue || present.swapchainCount != 1 || present.waits.size() != 1 ||
+            present.waits.front() != mSignal || present.color != mColor) {
+            invalidate();
+            return false;
+        }
+        mPhase = Phase::Presenting;
+        return true;
+    }
+
+    // Supply SurfaceQueueBufferOutput::nextFrameNumber from the same queue call. Its sync_file must
+    // come from WSI after consuming the observed waits. The caller keeps the FD alive.
+    [[nodiscard]] std::optional<Pair> finishPresent(VectorSlot vector, ColorFrame color,
+                                                    const Enqueue& enqueue) {
+        if (mPhase != Phase::Presenting) return std::nullopt;
+
+        if (vector != mVector || color != mColor || enqueue.releaseImageResult != VK_SUCCESS ||
+            enqueue.queueStatus != 0 || enqueue.nextFrameNumber <= 1 || enqueue.acquireFenceFd < 0) {
+            invalidate();
+            return std::nullopt;
+        }
+        mPhase = Phase::Empty;
+        return Pair{mVector, mColor, enqueue.nextFrameNumber - 1};
+    }
+
+    // Call upon any untracked change that could invalidate the proof, including semaphore reuse,
+    // command or pool reset, swapchain replacement and device loss. Retire resources separately.
+    void invalidate() {
+        if (mPhase != Phase::Empty) mPhase = Phase::Invalid;
+    }
+
+    [[nodiscard]] std::optional<Retirement> cancel() {
+        if (mPhase == Phase::Empty) return std::nullopt;
+
+        mPhase = Phase::Empty;
+        return Retirement{mVector, mRecording, mCommandsMayReferenceSlot};
+    }
+
+private:
+    enum class Phase { Empty, Armed, Writing, Recorded, Executable, Submitted, Presenting, Invalid };
+    static constexpr std::size_t kMaxSubmitEntries = 16;
+
+    static bool isBinarySignal(const Semaphore& signal) {
+        return signal.handle != VK_NULL_HANDLE && signal.signalGeneration != 0 &&
+                signal.type == VK_SEMAPHORE_TYPE_BINARY;
+    }
+
+    static bool isColorFrameValid(const ColorFrame& color) {
+        return color.swapchain != VK_NULL_HANDLE && color.swapchainGeneration != 0 &&
+                color.image != VK_NULL_HANDLE && color.surfaceGeneration != 0;
+    }
+
+    Phase mPhase = Phase::Empty;
+    bool mCommandsMayReferenceSlot = false;
+    uint64_t mLastVectorGeneration = 0;
+    VectorSlot mVector{};
+    Recording mRecording{};
+    VkQueue mQueue = VK_NULL_HANDLE;
+    Semaphore mSignal{};
+    ColorFrame mColor{};
+};
+
+} // namespace vulkan::athens
diff --git a/vulkan/libvulkan/AthensVulkanPresentCapture.h b/vulkan/libvulkan/AthensVulkanPresentCapture.h
