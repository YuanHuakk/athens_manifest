+#include <thread>
+
+namespace android {
+
+class AthensMotionVector final {
+public:
+    using SessionId = uint64_t;
+
+    ~AthensMotionVector();
+
+    void activate(SessionId session, uint32_t scaleWidth, uint32_t scaleHeight);
+    // The caller must authenticate the companion, match the game frame, and hold its
+    // BufferQueue slot for CPU use until the worker releases the lease.
+    void submit(SessionId session, const sp<GraphicBuffer>& buffer, const sp<Fence>& acquireFence,
+                std::shared_ptr<const void> lease, bool xHigh10);
+    void idle(SessionId session);
+    void deactivate(SessionId session);
+    bool hasRecentSuccessfulSubmission(SessionId session, int64_t maxAgeNs) const;
+
+private:
+    using Clock = std::chrono::steady_clock;
+
+    struct Session {
+        SessionId id;
+        uint32_t scaleWidth;
+        uint32_t scaleHeight;
+    };
+
+    struct Frame {
+        sp<GraphicBuffer> buffer;
+        sp<Fence> acquireFence;
+        std::shared_ptr<const void> lease;
+        Clock::time_point queuedAt;
+        Session session;
+        bool xHigh10;
+    };
+
+    void discard(SessionId session, bool deactivate);
+    void run();
+
+    mutable std::mutex mMutex;
+    std::condition_variable mWake;
+    std::optional<Session> mSession;
+    std::optional<Frame> mPending;
+    std::optional<Clock::time_point> mLastSubmitted;
+    std::thread mThread;
+    uint64_t mGeneration = 0;
+    bool mStopping = false;
+    bool mOutputDirty = false;
+    bool mResetRequested = false;
+};
+
+} // namespace android
