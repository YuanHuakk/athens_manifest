diff --git a/vulkan/libvulkan/athens_mivk/AthensMiVkBridge.cpp b/vulkan/libvulkan/athens_mivk/AthensMiVkBridge.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9a29b2cdf45791b6a63f2c5dcb506da4633d374e
--- /dev/null
+++ b/vulkan/libvulkan/athens_mivk/AthensMiVkBridge.cpp
@@ -0,0 +1,201 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <dlfcn.h>
+#include <vulkan/vulkan_core.h>
+
+#include <cstddef>
+#include <cstring>
+
+// The strong factory reference keeps the OEM ELF in this bridge's local dependency group.
+// Loading the OEM independently would bind its PLT before the render replacements are in scope.
+extern "C" void* createInstance();
+extern "C" int AthensMiVkProducerAbiVersion() __attribute__((weak));
+extern "C" bool AthensMiVkProducerBindOem(void* oemHandle) __attribute__((weak));
+extern "C" PFN_vkVoidFunction AthensMiVkObserveDeviceProc(VkDevice device, const char* name,
+                                                        PFN_vkVoidFunction downstream)
+        __attribute__((weak));
+
+namespace {
+
+constexpr int kBridgeAbiVersion = 1;
+constexpr size_t kIsEnabledVtableOffset = 0x18;
+constexpr char kOemLibrary[] = "libmivk.so";
+constexpr char kIsEnabledSymbol[] = "_ZN6vulkan12MiVkStubImpl9isEnabledEv";
+
+using OemFactory = void* (*)();
+using OemIsEnabled = bool (*)(void*);
+
+struct OemApi {
+    void* handle;
+    OemFactory factory;
+    OemIsEnabled isEnabled;
+    PFN_vkGetInstanceProcAddr getInstanceProcAddr;
+    PFN_vkGetDeviceProcAddr getDeviceProcAddr;
+    PFN_vkEnumerateInstanceLayerProperties enumerateInstanceLayers;
+    PFN_vkEnumerateInstanceExtensionProperties enumerateInstanceExtensions;
+    PFN_vkEnumerateDeviceLayerProperties enumerateDeviceLayers;
+    PFN_vkEnumerateDeviceExtensionProperties enumerateDeviceExtensions;
+
+    bool complete() const {
+        return handle && factory && isEnabled && getInstanceProcAddr && getDeviceProcAddr &&
+                enumerateInstanceLayers && enumerateInstanceExtensions && enumerateDeviceLayers &&
+                enumerateDeviceExtensions;
+    }
+};
+
+template <typename Function>
+Function resolve(void* handle, const char* name) {
+    return reinterpret_cast<Function>(dlsym(handle, name));
+}
+
+OemApi resolveOemApi() {
+    Dl_info factoryOwner{};
+    if (dladdr(reinterpret_cast<const void*>(createInstance), &factoryOwner) == 0 ||
+        !factoryOwner.dli_fname) {
+        return {};
+    }
+    const char* slash = std::strrchr(factoryOwner.dli_fname, '/');
+    const char* basename = slash ? slash + 1 : factoryOwner.dli_fname;
+    if (std::strcmp(basename, kOemLibrary) != 0) return {};
+
+    // This must resolve the dependency already bound with the bridge. Its handle also permits
+    // the producer replacements to look up the original implementations without recursion.
+    void* handle = dlopen(factoryOwner.dli_fname, RTLD_NOW | RTLD_LOCAL | RTLD_NOLOAD);
+    if (!handle) return {};
+    OemApi api{
+            handle,
+            resolve<OemFactory>(handle, "createInstance"),
+            resolve<OemIsEnabled>(handle, kIsEnabledSymbol),
+            resolve<PFN_vkGetInstanceProcAddr>(handle, "MiVkGetInstanceProcAddr"),
+            resolve<PFN_vkGetDeviceProcAddr>(handle, "MiVkGetDeviceProcAddr"),
+            resolve<PFN_vkEnumerateInstanceLayerProperties>(handle,
+                                                         "MiVkEnumerateInstanceLayerProperties"),
+            resolve<PFN_vkEnumerateInstanceExtensionProperties>(
+                    handle, "MiVkEnumerateInstanceExtensionProperties"),
+            resolve<PFN_vkEnumerateDeviceLayerProperties>(handle,
+                                                       "MiVkEnumerateDeviceLayerProperties"),
+            resolve<PFN_vkEnumerateDeviceExtensionProperties>(
+                    handle, "MiVkEnumerateDeviceExtensionProperties"),
+    };
+    if (api.complete() && api.factory == createInstance) return api;
+    dlclose(handle);
+    return {};
+}
+
+const OemApi& getOemApi() {
+    static const OemApi api = resolveOemApi();
+    return api;
+}
+
+bool startOem(const OemApi& api) {
+    if (!api.complete() || !AthensMiVkProducerBindOem(api.handle)) return false;
+
+    // The factory returns a stock process-lifetime object. HyperOS Vulkan dispatches its
+    // isEnabled() virtual at address-point +0x18. Verify that slot before calling it.
+    void* instance = api.factory();
+    if (!instance) return false;
+    const std::byte* vtable = nullptr;
+    std::memcpy(&vtable, instance, sizeof(vtable));
+    if (!vtable) return false;
+    OemIsEnabled isEnabled = nullptr;
+    std::memcpy(&isEnabled, vtable + kIsEnabledVtableOffset, sizeof(isEnabled));
+    return isEnabled == api.isEnabled && isEnabled(instance);
+}
+
+const OemApi* getEnabledApi() {
+    if (!AthensMiVkProducerAbiVersion || !AthensMiVkProducerBindOem ||
+        AthensMiVkProducerAbiVersion() != kBridgeAbiVersion) {
+        return nullptr;
+    }
+    const OemApi& api = getOemApi();
+    static const bool enabled = startOem(api);
+    return enabled ? &api : nullptr;
+}
+
+VkResult enumerateUnavailable(uint32_t* count, const char* layerName = nullptr) {
+    if (!count) return VK_ERROR_INITIALIZATION_FAILED;
+    *count = 0;
+    return layerName ? VK_ERROR_LAYER_NOT_PRESENT : VK_SUCCESS;
+}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL getBridgeDeviceProcAddr(VkDevice device, const char* name) {
+    const OemApi* api = getEnabledApi();
+    if (!api || !name) return nullptr;
+    const auto downstream = api->getDeviceProcAddr(device, name);
+    if (!downstream) return nullptr;
+    if (std::strcmp(name, "vkGetDeviceProcAddr") == 0) {
+        return reinterpret_cast<PFN_vkVoidFunction>(getBridgeDeviceProcAddr);
+    }
+    return AthensMiVkObserveDeviceProc ? AthensMiVkObserveDeviceProc(device, name, downstream)
+                                      : downstream;
+}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL getBridgeInstanceProcAddr(VkInstance instance,
+                                                                  const char* name) {
+    const OemApi* api = getEnabledApi();
+    if (!api || !name) return nullptr;
+    const auto downstream = api->getInstanceProcAddr(instance, name);
+    if (!downstream) return nullptr;
+    if (std::strcmp(name, "vkGetInstanceProcAddr") == 0) {
+        return reinterpret_cast<PFN_vkVoidFunction>(getBridgeInstanceProcAddr);
+    }
+    if (std::strcmp(name, "vkGetDeviceProcAddr") == 0) {
+        return reinterpret_cast<PFN_vkVoidFunction>(getBridgeDeviceProcAddr);
+    }
+    return downstream;
+}
+
+} // namespace
+
+#define ATHENS_MIVK_EXPORT extern "C" __attribute__((visibility("default")))
+
+ATHENS_MIVK_EXPORT int AthensMiVkBridgeVersion() {
+    return getEnabledApi() ? kBridgeAbiVersion : 0;
+}
+
+// Shell probes may verify the load group and exports without starting the OEM factory.
+ATHENS_MIVK_EXPORT int AthensMiVkBridgeProbe() {
+    return getOemApi().complete() ? kBridgeAbiVersion : 0;
+}
+
+ATHENS_MIVK_EXPORT VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vkGetInstanceProcAddr(VkInstance instance, const char* name) {
+    return getBridgeInstanceProcAddr(instance, name);
+}
+
+ATHENS_MIVK_EXPORT VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vkGetDeviceProcAddr(VkDevice device, const char* name) {
+    return getBridgeDeviceProcAddr(device, name);
+}
+
+ATHENS_MIVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL
+vkEnumerateInstanceLayerProperties(uint32_t* count, VkLayerProperties* properties) {
+    const OemApi* api = getEnabledApi();
+    return api ? api->enumerateInstanceLayers(count, properties) : enumerateUnavailable(count);
+}
+
+ATHENS_MIVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL
+vkEnumerateInstanceExtensionProperties(const char* layerName, uint32_t* count,
+                                       VkExtensionProperties* properties) {
+    const OemApi* api = getEnabledApi();
+    return api ? api->enumerateInstanceExtensions(layerName, count, properties)
+               : enumerateUnavailable(count, layerName);
+}
+
+ATHENS_MIVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL
+vkEnumerateDeviceLayerProperties(VkPhysicalDevice device, uint32_t* count,
+                                 VkLayerProperties* properties) {
+    const OemApi* api = getEnabledApi();
+    return api ? api->enumerateDeviceLayers(device, count, properties) : enumerateUnavailable(count);
+}
+
+ATHENS_MIVK_EXPORT VKAPI_ATTR VkResult VKAPI_CALL
+vkEnumerateDeviceExtensionProperties(VkPhysicalDevice device, const char* layerName, uint32_t* count,
+                                     VkExtensionProperties* properties) {
+    const OemApi* api = getEnabledApi();
+    return api ? api->enumerateDeviceExtensions(device, layerName, count, properties)
+               : enumerateUnavailable(count, layerName);
+}
diff --git a/vulkan/libvulkan/athens_mivk/AthensMiVkRenderHooks.cpp b/vulkan/libvulkan/athens_mivk/AthensMiVkRenderHooks.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4a16b26940a0a8ff95fcbde247c6b7d79eb14a62
--- /dev/null
+++ b/vulkan/libvulkan/athens_mivk/AthensMiVkRenderHooks.cpp
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "AthensMiVkRenderHooks.h"
+
+#include <dlfcn.h>
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstring>
+#include <mutex>
+
+namespace {
+
+// Exact Athens 406 ARM64 ABI. The OEM's allocator, RefBase construction, and original virtual
+// destruction remain in use. These are the only two member offsets this bridge reads or writes.
+constexpr std::size_t kReadyOffset = 0x28;
+constexpr std::size_t kRenderModuleSurfaceOffset = 0x268;
+constexpr uint32_t kRgba1010102 = 0x2b;
+constexpr VkExtent2D kVectorExtent{60, 27};
+
+constexpr char kStockDestructor[] = "_ZN7android19MotionVectorSurfaceD1Ev";
+constexpr char kStockBaseDestructor[] = "_ZN7android19MotionVectorSurfaceD2Ev";
+constexpr uintptr_t kStockBaseDestructorOffset = 0x66f224;
+
+extern "C" void StockBaseDestructor(void* surface) asm("_ZN7android19MotionVectorSurfaceD2Ev");
+
+struct SurfaceState {
+    void* object = nullptr;
+    uint64_t generation = 0;
+    bool configured = false;
+};
+
+std::atomic<const AthensMiVkRenderCallbacks*> gCallbacks{nullptr};
+std::atomic<bool> gOemBound{false};
+std::mutex gSurfaceMutex;
+std::array<SurfaceState, 8> gSurfaces;
+uint64_t gNextSurfaceGeneration = 1;
+
+const AthensMiVkRenderCallbacks* ReadyCallbacks() {
+    return gOemBound.load(std::memory_order_acquire) ? gCallbacks.load(std::memory_order_acquire)
+                                                     : nullptr;
+}
+
+// JUMP_SLOT entries in 406 libmivk.so, plus the complete destructor in its vtable.
+// `dlsym(oemHandle, ...)` can resolve the original even if libmivk was loaded before the bridge.
+// Inspect the relocated pointers as well to verify that actual OEM call sites land in this DSO.
+bool OemCallsUseBridge(const Dl_info& oem, const Dl_info& bridge) {
+    struct Relocation {
+        uintptr_t offset;
+        const char* symbol;
+    };
+    constexpr Relocation kRelocations[] = {
+            {0x828d58, "_ZN7android19MotionVectorSurface4initEjj"},
+            {0x828d60, "_ZN7android19MotionVectorSurface10updateSizeEjj"},
+            {0x828d68, "_ZN7android19MotionVectorSurface18queueGraphicBufferEi"},
+            {0x828d70, "_ZN7android19MotionVectorSurface16getGraphicBufferEPNS_2spINS_13GraphicBufferEEE"},
+            {0x8297e0, kStockDestructor},
+            {0x818148, kStockDestructor},
+            {0x8266f0, "_ZN7android10EMVMonitor12getEMVStatusEv"},
+            {0x82a370, "_ZN6vulkan4mivk3app6module22MiVkYuanshenMIMVModule27scaleVkImageToGraphicBuffer"
+                       "EP10VkDevice_TP18VkPhysicalDevice_TP9VkImage_T8VkFormatjjP17VkCommandBuffer_T"},
+    };
+    const auto base = reinterpret_cast<uintptr_t>(oem.dli_fbase);
+    for (const auto& entry : kRelocations) {
+        const auto* address = reinterpret_cast<const char*>(base + entry.offset);
+        Dl_info slotInfo{};
+        if (!dladdr(address + sizeof(void*) - 1, &slotInfo) || slotInfo.dli_fbase != oem.dli_fbase) {
+            return false;
+        }
+        const void* target;
+        std::memcpy(&target, address, sizeof(target));
+        Dl_info targetInfo{};
+        if (!target || !dladdr(target, &targetInfo) || targetInfo.dli_fbase != bridge.dli_fbase ||
+            !targetInfo.dli_sname || std::strcmp(targetInfo.dli_sname, entry.symbol) != 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+} // namespace
+
+extern "C" [[gnu::visibility("default")]] bool AthensMiVkInstallRenderCallbacks(
+        const AthensMiVkRenderCallbacks* callbacks) {
+    if (!callbacks || callbacks->version != kAthensMiVkRenderAbiVersion ||
+        callbacks->size != sizeof(AthensMiVkRenderCallbacks) || !callbacks->isArmed ||
+        !callbacks->record || !callbacks->retire) {
+        return false;
+    }
+    const AthensMiVkRenderCallbacks* previous = nullptr;
+    return gCallbacks.compare_exchange_strong(previous, callbacks, std::memory_order_acq_rel) ||
+            previous == callbacks;
+}
+
+extern "C" [[gnu::visibility("default")]] int AthensMiVkProducerAbiVersion() {
+    return gCallbacks.load(std::memory_order_acquire) ? kAthensMiVkRenderAbiVersion : 0;
+}
+
+extern "C" [[gnu::visibility("default")]] bool AthensMiVkProducerBindOem(void* oemHandle) {
+    if (!oemHandle || AthensMiVkProducerAbiVersion() != kAthensMiVkRenderAbiVersion) return false;
+
+    // D1 and D2 are the exact same implementation in 406. Linking D2 also keeps a strong dependency
+    // on the OEM library, so the loader relocates the OEM PLT in the bridge's local load group.
+    const auto stockD2 = reinterpret_cast<decltype(&StockBaseDestructor)>(
+            dlsym(oemHandle, kStockBaseDestructor));
+    const auto stockD1 = reinterpret_cast<decltype(&StockBaseDestructor)>(
+            dlsym(oemHandle, kStockDestructor));
+    if (!stockD2 || stockD2 != stockD1 || stockD2 != StockBaseDestructor) return false;
+
+    Dl_info oem{};
+    Dl_info bridge{};
+    if (!dladdr(reinterpret_cast<const void*>(stockD2), &oem) ||
+        !dladdr(reinterpret_cast<const void*>(&ReadyCallbacks), &bridge) ||
+        reinterpret_cast<uintptr_t>(stockD2) - reinterpret_cast<uintptr_t>(oem.dli_fbase) !=
+                kStockBaseDestructorOffset ||
+        !OemCallsUseBridge(oem, bridge)) {
+        return false;
+    }
+
+    gOemBound.store(true, std::memory_order_release);
+    return true;
+}
+
+extern "C" [[gnu::visibility("default")]] PFN_vkVoidFunction AthensMiVkObserveDeviceProc(
+        VkDevice device, const char* name, PFN_vkVoidFunction downstream) {
+    const auto* callbacks = ReadyCallbacks();
+    if (callbacks && callbacks->observeDeviceProc && device && name && downstream) {
+        if (auto observed = callbacks->observeDeviceProc(callbacks->context, device, name,
+                                                         downstream)) {
+            return observed;
+        }
+    }
+    return downstream;
+}
+
+extern "C" [[gnu::visibility("default")]] void SurfaceInit(void* object, uint32_t format,
+                                                          uint32_t blastFormat)
+        asm("_ZN7android19MotionVectorSurface4initEjj");
+extern "C" void SurfaceInit(void* object, uint32_t format, uint32_t blastFormat) {
+    if (!ReadyCallbacks() || !object || format != kRgba1010102 || blastFormat != kRgba1010102) {
+        return;
+    }
+
+    std::lock_guard lock(gSurfaceMutex);
+    for (const auto& surface : gSurfaces) {
+        if (surface.object == object) return;
+    }
+    for (auto& surface : gSurfaces) {
+        if (surface.object || gNextSurfaceGeneration == 0) continue;
+        surface = {object, gNextSurfaceGeneration++, false};
+        // The OEM constructor's call sites read this byte immediately after init returns. It is
+        // set before publication once and stays untouched for the lifetime of the object.
+        static_cast<unsigned char*>(object)[kReadyOffset] = 1;
+        return;
+    }
+}
+
+extern "C" [[gnu::visibility("default")]] void SurfaceUpdateSize(void* object, uint32_t width,
+                                                                uint32_t height)
+        asm("_ZN7android19MotionVectorSurface10updateSizeEjj");
+extern "C" void SurfaceUpdateSize(void* object, uint32_t width, uint32_t height) {
+    if (!object) return;
+
+    std::lock_guard lock(gSurfaceMutex);
+    for (auto& surface : gSurfaces) {
+        if (surface.object != object) continue;
+        surface.configured = width == kVectorExtent.width && height == kVectorExtent.height;
+        return;
+    }
+}
+
+extern "C" [[gnu::visibility("default")]] void SurfaceDestroy(void* object)
+        asm("_ZN7android19MotionVectorSurfaceD1Ev");
+extern "C" void SurfaceDestroy(void* object) {
+    uint64_t generation = 0;
+    {
+        std::lock_guard lock(gSurfaceMutex);
+        for (auto& surface : gSurfaces) {
+            if (surface.object != object) continue;
+            generation = surface.generation;
+            surface = {};
+            break;
+        }
+    }
+    if (generation != 0) {
+        if (const auto* callbacks = ReadyCallbacks()) {
+            callbacks->retire(callbacks->context, generation);
+        }
+    }
+    StockBaseDestructor(object);
+}
+
+extern "C" [[gnu::visibility("default")]] int SurfaceGetBuffer(void*, void*)
+        asm("_ZN7android19MotionVectorSurface16getGraphicBufferEPNS_2spINS_13GraphicBufferEEE");
+extern "C" int SurfaceGetBuffer(void*, void*) {
+    return -1;
+}
+
+extern "C" [[gnu::visibility("default")]] void SurfaceQueueBuffer(void*, int)
+        asm("_ZN7android19MotionVectorSurface18queueGraphicBufferEi");
+extern "C" void SurfaceQueueBuffer(void*, int) {}
+
+extern "C" [[gnu::visibility("default")]] int GetEmvStatus(void*)
+        asm("_ZN7android10EMVMonitor12getEMVStatusEv");
+extern "C" int GetEmvStatus(void*) {
+    const auto* callbacks = ReadyCallbacks();
+    return callbacks && callbacks->isArmed(callbacks->context) ? 1 : 0;
+}
+
+extern "C" [[gnu::visibility("default")]] VkResult ScaleGameVector(
+        void* module, VkDevice device, VkPhysicalDevice physicalDevice, VkImage image,
+        VkFormat format, uint32_t width, uint32_t height, VkCommandBuffer commandBuffer)
+        asm("_ZN6vulkan4mivk3app6module22MiVkYuanshenMIMVModule27scaleVkImageToGraphicBuffer"
+            "EP10VkDevice_TP18VkPhysicalDevice_TP9VkImage_T8VkFormatjjP17VkCommandBuffer_T");
+extern "C" VkResult ScaleGameVector(void* module, VkDevice, VkPhysicalDevice, VkImage image,
+                                    VkFormat, uint32_t width, uint32_t height,
+                                    VkCommandBuffer commandBuffer) {
+    const auto* callbacks = ReadyCallbacks();
+    if (!callbacks || !module || !image || !commandBuffer || !width || !height ||
+        !callbacks->isArmed(callbacks->context)) {
+        return VK_SUCCESS;
+    }
+    void* object;
+    std::memcpy(&object, static_cast<const unsigned char*>(module) + kRenderModuleSurfaceOffset,
+                sizeof(object));
+    if (!object) return VK_SUCCESS;
+
+    uint64_t generation = 0;
+    {
+        std::lock_guard lock(gSurfaceMutex);
+        for (const auto& surface : gSurfaces) {
+            if (surface.object == object && surface.configured) {
+                generation = surface.generation;
+                break;
+            }
+        }
+    }
+    if (generation == 0) return VK_SUCCESS;
+
+    // 406 PostVkCmdEndRenderPass populates the source image, extent and command buffer. The
+    // remaining ABI argument registers are scratch, and the original implementation ignores them.
+    const AthensMiVkRenderInput input{commandBuffer, image, {width, height}, kVectorExtent,
+                                     kRgba1010102, generation};
+    // OEM handles VK_SUCCESS by continuing the original app render path. A skipped vector must
+    // not affect the game's render pass or cause a repeated error log on its render thread.
+    const VkResult result = callbacks->record(callbacks->context, &input);
+    return result == VK_NOT_READY ? VK_SUCCESS : result;
+}
