+constexpr uint8_t kJointStereo = 0x08;
+constexpr uint8_t kR2Extension = 0x01;
+constexpr uint8_t kR21SourceFeatures = 0x03;
+constexpr uint8_t kR22SourceFeatures = 0x17;
+constexpr int32_t kBitdepth = 24;
+
+CodecId MakeCodecId() {
+    return CodecId::make<CodecId::Tag::vendor>(CodecId::Vendor{.id = kVendorId, .codecId = kCodecId});
+}
+
+CodecInfo MakeCodecInfo(bool supports_r2_1, bool supports_r2_2) {
+    uint8_t rates = kRate48000;
+    std::vector<int32_t> sampling_frequencies = {48000};
+    if (supports_r2_1 || supports_r2_2) {
+        rates |= kRate96000Mask;
+        sampling_frequencies.push_back(96000);
+    }
+    // Qualcomm's 44.1 kHz path also configures its controller Lossless mode.
+    // Keep that rate out of this encoder's capabilities until that mode is integrated.
+
+    uint8_t features = 0;
+    if (supports_r2_2) {
+        features = kR22SourceFeatures;
+    } else if (supports_r2_1) {
+        features = kR21SourceFeatures;
+    }
+
+    std::vector<uint8_t> capabilities = {
+            rates, kJointStereo,
+            0x50, 0x64, 0x64, 0x64, 0xff, 0xff, 0,  // TTP and reserved octet
+            kR2Extension, features, 0, 0, 0x0f,     // extension version and feature word
+            0x02, 0x03, 0x03, 0x03,                 // setup preferences
+            0, 0xaa,                               // end of extension
+    };
+    capabilities.resize(kPayloadSize);
+
+    return {.id = MakeCodecId(),
+            .name = "aptX Adaptive",
+            .transport = CodecInfo::Transport::make<CodecInfo::Transport::Tag::a2dp>(
+                    CodecInfo::A2dp{.capabilities = std::move(capabilities),
+                                    .channelMode = {ChannelMode::STEREO},
+                                    .samplingFrequencyHz = std::move(sampling_frequencies),
+                                    .bitdepth = {kBitdepth}})};
+}
+
+uint8_t RateMask(int32_t frequency) {
+    switch (frequency) {
+        case 48000:
+            return kRate48000;
+        case 96000:
+            return kRate96000Mask;
+        default:
+            return 0;
+    }
+}
+
+int32_t SamplingFrequency(uint8_t rate) {
+    switch (rate) {
+        case kRate48000:
+            return 48000;
+        case kRate96000Alternate:
+        case kRate96000:
+        case kRate96000Mask:
+            return 96000;
+        default:
+            return 0;
+    }
+}
+
+int8_t TimeToPlay(uint8_t value) {
+    return static_cast<int8_t>(static_cast<int>(value) - 128);
+}
+
+}  // namespace
+
+A2dpOffloadCodecAptxAdaptive::A2dpOffloadCodecAptxAdaptive(bool supports_r2_1, bool supports_r2_2)
+    : A2dpOffloadCodec(info_), info_(MakeCodecInfo(supports_r2_1, supports_r2_2)) {}
+
+bool A2dpOffloadCodecAptxAdaptive::IsCodecId(const CodecId& id) {
+    return id == MakeCodecId();
+}
+
+A2dpStatus A2dpOffloadCodecAptxAdaptive::SelectA2dpConfiguration(
+        const std::vector<uint8_t>& configuration, CodecParameters* codec_parameters) const {
+    if (configuration.size() != kPayloadSize) return A2dpStatus::BAD_LENGTH;
+
+    const uint8_t rate = configuration[kSamplingFrequency] & kRateMask;
+    const int32_t frequency = SamplingFrequency(rate);
+    if (frequency == 0) return A2dpStatus::INVALID_SAMPLING_FREQUENCY;
+
+    const uint8_t extension = configuration[kExtensionVersion];
+    if (extension > kR2Extension) return A2dpStatus::NOT_SUPPORTED_CODEC_PARAMETER;
+
+    const auto& capabilities = info_.transport.get<CodecInfo::Transport::Tag::a2dp>().capabilities;
+    if ((capabilities[kSamplingFrequency] & rate) != rate ||
+        (extension == 0 && rate != kRate48000)) {
+        return A2dpStatus::NOT_SUPPORTED_SAMPLING_FREQUENCY;
+    }
+
+    const uint8_t channels = configuration[kChannelMode] & kChannelMask;
+    if (!std::has_single_bit(channels)) return A2dpStatus::INVALID_CHANNEL_MODE;
+    if (channels != kJointStereo) return A2dpStatus::NOT_SUPPORTED_CHANNEL_MODE;
+
+    *codec_parameters = {.channelMode = ChannelMode::STEREO,
+                         .samplingFrequencyHz = frequency,
+                         .bitdepth = kBitdepth,
+                         .vendorSpecificParameters = {}};
+    return A2dpStatus::OK;
+}
+
+A2dpStatus A2dpOffloadCodecAptxAdaptive::SelectA2dpConfiguration(
+        const std::vector<uint8_t>& configuration, AptxAdaptiveConfiguration* codec_parameters) const {
+    CodecParameters parameters;
+    const auto status = SelectA2dpConfiguration(configuration, &parameters);
+    if (status != A2dpStatus::OK) return status;
+
+    // The typed offload interface carries the extension independently of the
+    // other negotiated fields. See Qualcomm CAF a2dp_encoding.cc:1305–1328.
+    *codec_parameters = {
+            .sampleRateHz = parameters.samplingFrequencyHz,
+            .channelMode = AptxAdaptiveChannelMode::JOINT_STEREO,
+            .bitsPerSample = kBitdepth,
+            .aptxMode = AptxMode::HIGH_QUALITY,
+            .sinkBufferingMs = {20, 50, 20, 50, 20, 50},
+            .ttp = {TimeToPlay(configuration[kTimeToPlay]),
+                    TimeToPlay(configuration[kTimeToPlay + 1]),
+                    TimeToPlay(configuration[kTimeToPlay + 2]),
+                    TimeToPlay(configuration[kTimeToPlay + 3]),
+                    TimeToPlay(configuration[kTimeToPlay + 4]),
+                    TimeToPlay(configuration[kTimeToPlay + 5])},
+            .inputMode = AptxAdaptiveInputMode::STEREO,
+            .inputFadeDurationMs = 255,
+            .aptxAdaptiveConfigStream = {configuration.begin() + kExtensionVersion,
+                                         configuration.begin() + kExtensionEnd},
+    };
+    return A2dpStatus::OK;
+}
+
+bool A2dpOffloadCodecAptxAdaptive::BuildConfiguration(
+        const std::vector<uint8_t>& remote_capabilities, const std::optional<CodecParameters>& hint,
+        std::vector<uint8_t>* configuration) const {
+    if (remote_capabilities.size() != kPayloadSize) return false;
+
+    const auto& local = info_.transport.get<CodecInfo::Transport::Tag::a2dp>().capabilities;
+    const uint8_t extension = remote_capabilities[kExtensionVersion];
+    if (extension > kR2Extension) return false;
+
+    if ((remote_capabilities[kChannelMode] & kJointStereo) == 0) return false;
+
+    const uint8_t source_features = local[kFeatures];
+    const uint8_t sink_features = remote_capabilities[kFeatures];
+    uint8_t rates = local[kSamplingFrequency] & remote_capabilities[kSamplingFrequency];
+    if (extension == 0) rates &= kRate48000;
+
+    uint8_t rate = hint ? rates & RateMask(hint->samplingFrequencyHz) : 0;
+    if (rate == 0) {
+        // Prefer 48 kHz for a new stream. A supported explicit rate can still
+        // select 96 kHz.
+        for (uint8_t preferred_rate : {kRate48000, kRate96000Mask}) {
+            rate = rates & preferred_rate;
+            if (rate != 0) break;
+        }
+    }
+    if (rate == 0) return false;
+    // Both 96 kHz encodings are supported. Signal one that the peer offers.
+    if (rate == kRate96000Mask) rate = kRate96000;
+
+    auto result = local;
+    result[kSamplingFrequency] = rate;
+    result[kChannelMode] = kJointStereo;
+    if (extension == 0) {
+        std::copy_n(remote_capabilities.begin() + kExtensionVersion,
+                    kExtensionEnd - kExtensionVersion, result.begin() + kExtensionVersion);
+    } else {
+        // Combine the source/sink role bits and intersect the shared features.
+        result[kFeatures] = ((source_features | sink_features) & 0xf0) |
+                            ((source_features & sink_features) & 0x0f);
+        std::copy_n(remote_capabilities.begin() + kFeatures + 1, 3, result.begin() + kFeatures + 1);
+    }
+    *configuration = std::move(result);
+    return true;
+}
+
