+    fixed = data.replace(original, corrected.ljust(len(original), b"\0"))
+    if hashlib.sha256(fixed).hexdigest() != fixed_hash:
+        raise ValueError(f"{path}: unexpected Novatek daemon SHA-256 after fixup")
+    path.write_bytes(fixed)
