+    source_hash = hashlib.sha256(data).hexdigest()
+    if source_hash == fixed_hash:
+        return
+    if source_hash != stock_hash:
+        raise ValueError(f"{path}: unexpected SuperNight RAW SHA-256 {source_hash}")
