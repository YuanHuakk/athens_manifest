+// SPDX-License-Identifier: Apache-2.0
+
+cc_prebuilt_library_shared {
+    name: "btaudio_offload_if_stock",
+    defaults: ["//device/xiaomi/sm8850-common:xiaomi_btaudio_offload_blob_defaults"],
