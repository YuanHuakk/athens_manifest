+    # The mprotect flags are passed in w2 on AArch64.
+    data[0x3EF27C:0x3EF280] = bytes.fromhex("62 00 80 52")  # mov w2, #3 (RW)
+    data[0x3EF90C:0x3EF910] = bytes.fromhex("22 00 80 52")  # mov w2, #1 (R)
+    if hashlib.sha256(data).hexdigest() != fixed_hash:
