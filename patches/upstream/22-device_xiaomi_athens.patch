+def fixup_novatek_touch_scan_log(ctx, file, file_path, *args, **kwargs):
+    """Drop the missing second string argument from the 406 touch-scan error log."""
+    path = Path(file_path)
+    data = path.read_bytes()
+    stock_hash = "9c172c695a2884ffa91ce0ddef3ef6ec46c56a3578e1f9f320cf7655eda7b099"
+    fixed_hash = "fca9d061beab72c7e38f572e8b0c126464c109f7f39078fc00d30579b694151e"
+    source_hash = hashlib.sha256(data).hexdigest()
+    if source_hash == fixed_hash:
+        return
+    if source_hash != stock_hash:
+        raise ValueError(f"{path}: unexpected Novatek daemon SHA-256 {source_hash}")
+
+    original = b"Close TouchInfo Detector(Scan dir failed for %s, %s)\n\0"
+    corrected = b"Close TouchInfo Detector(Scan dir failed for %s)\n\0"
+    if data.count(original) != 1:
+        raise ValueError(f"{path}: expected one Novatek touch-scan error format")
+
