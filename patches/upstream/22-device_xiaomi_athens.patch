+    "novatek_cmd_control_interval": int,
+    "novatek_bypass_refreshrate": bool,
+    "novatek_non_playing_config": list,
+    "novatek_gex_fps_limit": list,
+}
+DISPLAY_POLICIES = [
+    {"feature": "PQ_FIRST", "strategy": "NT#FISR"},
+    {"feature": "FPS_FIRST", "strategy": "NT#FI"},
+]
+PACKAGE = re.compile(r"[A-Za-z0-9.]+")
+FPS_LIMIT = re.compile(r"[A-Za-z0-9.]+:[1-9][0-9]*")
+MIVK_REFERENCE_PACKAGE = "com.miHoYo.Yuanshen"
+
+
+def verified_input(path, expected_sha256):
+    data = path.read_bytes()
+    if hashlib.sha256(data).hexdigest() != expected_sha256:
+        raise ValueError(f"{path}: SHA-256 does not match the verified Athens 4.0.6 input")
+    return data
+
+
+def stock_codec_material(apk):
+    # Evaluate only the verified method's literal byte array initialization and XOR loop.
+    # Its result is used in memory by the stock asset codec.
+    with zipfile.ZipFile(io.BytesIO(apk)) as joyose:
+        dex = joyose.read("classes.dex")
+    code = struct.unpack_from(f"<{CODE_UNITS}H", dex, CODE_OFFSET)
+    if code[0x92] != 0x03DF or code[0x93] & 0xFF != 3:
+        raise ValueError("unexpected Joyose codec XOR instruction")
+
+    registers = {}
+    pc = 0
+    while pc < XOR_LOOP:
+        opcode = code[pc] & 0xFF
+        operand = code[pc] >> 8
+        if opcode == 0x12:  # const/4
+            registers[operand & 0xF] = operand >> 4
+            pc += 1
+            continue
+        if opcode == 0x13:  # const/16
+            registers[operand] = code[pc + 1]
+        elif opcode == 0x23:  # new-array
+            registers[operand & 0xF] = bytearray(registers[operand >> 4])
+        elif opcode == 0x4F:  # aput-byte
+            array = code[pc + 1] & 0xFF
+            index = code[pc + 1] >> 8
+            registers[array][registers[index]] = registers[operand] & 0xFF
+        else:
+            raise ValueError("unexpected Joyose codec initialization instruction")
+        pc += 2
+
+    material = registers[1]
+    if pc != XOR_LOOP or len(material) != 32:
+        raise ValueError("unexpected Joyose codec material layout")
+    xor_mask = code[0x93] >> 8
+    return bytes(value ^ xor_mask for value in material)
+
+
+def decrypt_defaults(defaults, apk):
+    try:
+        from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
+        from cryptography.hazmat.primitives.padding import PKCS7
+    except ImportError as error:
+        raise ValueError("the Python cryptography package is required") from error
+
+    decryptor = Cipher(algorithms.AES(stock_codec_material(apk)), modes.ECB()).decryptor()
+    unpadder = PKCS7(128).unpadder()
+    return json.loads(
+        unpadder.update(decryptor.update(defaults) + decryptor.finalize())
+        + unpadder.finalize()
+    )
+
+
+def validate_profile_rows(rows, expected_count):
+    packages = set()
+    if not isinstance(rows, list) or len(rows) != expected_count:
+        raise ValueError("unexpected number of Joyose display profile rows")
+    for row in rows:
+        parts = row.split("_") if isinstance(row, str) else []
+        if len(parts) != 4 or not PACKAGE.fullmatch(parts[0]) or parts[0] in packages:
+            raise ValueError("invalid or duplicate Joyose display profile row")
+        if not all(parts[1:]):
+            raise ValueError("empty command field in Joyose display profile row")
+        packages.add(parts[0])
+
+
+def display_profiles(doc):
+    config = doc["booster_config"]
+    if (
+        config["config_name"] != "booster_config"
+        or config["version"] != 2026092851
+        or config["enable"] is not True
+        or config["with_model"] is not False
+    ):
+        raise ValueError("unexpected Athens Joyose configuration version")
+
+    game_booster = config["params"]["game_booster"]
+    profiles = game_booster["novatek_game_params"]
+    validate_profile_rows(profiles, 113)
+
+    blacklist = game_booster["novatek_black_app"]
+    if not isinstance(blacklist, list) or len(blacklist) != 15 or not all(
+        isinstance(package, str) and PACKAGE.fullmatch(package) for package in blacklist
+    ):
+        raise ValueError("invalid Joyose display blacklist")
+
+    extension = game_booster["novatek_extend_config"]
+    if set(extension) != DISPLAY_EXTENSIONS.keys() or not all(
+        type(extension[key]) is value_type for key, value_type in DISPLAY_EXTENSIONS.items()
+    ):
+        raise ValueError("invalid Joyose display extension")
+    fps_limits = extension["novatek_gex_fps_limit"]
+    if len(fps_limits) != 4 or not all(
+        isinstance(limit, str) and FPS_LIMIT.fullmatch(limit) for limit in fps_limits
+    ):
+        raise ValueError("invalid Joyose display FPS limits")
+
+    non_playing = extension["novatek_non_playing_config"]
+    if (
+        len(non_playing) != 1
+        or not isinstance(non_playing[0], str)
+        or not non_playing[0].startswith("com.tencent.tmgp.sgame_")
+        or len(non_playing[0].split("_")) != 3
+    ):
+        raise ValueError("invalid Joyose non-playing display profile")
+
+    policies = []
+    policy_config = game_booster["fisr_config"]["enhance_config"]
+    if not isinstance(policy_config, list) or len(policy_config) != 2:
+        raise ValueError("unexpected Joyose FISR policy count")
+    for policy in policy_config:
+        games = policy["game_list"]
+        if not isinstance(games, list) or not games or not all(
+            isinstance(game, str) and PACKAGE.fullmatch(game) for game in games
+        ):
+            raise ValueError("invalid Joyose FISR game list")
+        if policy["enhance_policy_config"] != DISPLAY_POLICIES:
+            raise ValueError("unexpected Joyose FISR display policy")
+        # joint_action_cmd belongs to the wider Game Booster configuration.
+        policies.append({"game_list": games, "enhance_policy_config": DISPLAY_POLICIES})
+
+    return {
+        "stock_firmware": "406",
+        "stock_asset": "odm/etc/default_cloud.json",
+        "stock_asset_sha256": DEFAULTS_SHA256,
+        "config_name": config["config_name"],
+        "version": config["version"],
+        "novatek_game_params": profiles,
+        "novatek_black_app": blacklist,
+        "novatek_extend_config": extension,
+        "fisr_config": {"enhance_config": policies},
+        "mivk_query": {MIVK_REFERENCE_PACKAGE: mivk_reference_reply(doc)},
+    }
+
+
+def read_stock_config(apk: Path, defaults: Path) -> dict:
+    joyose = verified_input(apk, JOYOSE_SHA256)
+    odm_defaults = verified_input(defaults, DEFAULTS_SHA256)
+    return decrypt_defaults(odm_defaults, joyose)
+
+
+def extract_profiles(apk: Path, defaults: Path) -> dict:
+    return display_profiles(read_stock_config(apk, defaults))
+
+
+def mivk_reference_reply(doc: dict) -> dict:
+    # Joyose queryVKSettingsByAppName flattens this row into a `configs` object.
+    booster = doc["booster_config"]["params"]["game_booster"]
+    settings = booster["mivk_settings"]
+    matches = [row for row in settings["app_params"]
+               if MIVK_REFERENCE_PACKAGE in row["app_cmdlines"]]
+    if settings["enable"] is not True or len(matches) != 1:
+        raise ValueError("406 MiVK configuration does not uniquely enable Genshin CN")
+
+    profile = matches[0]
+    xrender = profile["xrender_config"]
+    # Android 17 prefers support_module_w when present. STANDARD is the third tuner mode.
+    module_key = "support_module_w" if "support_module_w" in xrender else "support_module"
+    module_list = xrender[module_key]
+    standard_mode = 1 << 2
+    base_info = 0
+    enabled = []
+    for index, entry in enumerate(module_list):
+        name, mask = (part.strip() for part in entry.split(":", 1))
+        if int(mask) & standard_mode:
+            base_info |= 1 << index
+            enabled.append(name)
+    if "mimv" not in enabled or "drr" not in enabled:
+        raise ValueError("406 Genshin MiVK standard profile is missing its motion-vector modules")
+
+    config = {
+        "xrender_BaseInfo": base_info,
+        "xrender_ModuleList": ",".join(enabled),
+        "xrender_CheckMainInfo": xrender["checkMainInfo"],
+        # JSONObject.getString serializes the nested OEM object into a string on the wire.
+        "drr_Params": json.dumps(profile["drr"]["params"], separators=(",", ":")),
+        # A device without a saved OEM resolution preset returns -1.
+        "remode": -1,
+    }
+    for source, key in (("payloadData", "xrender_PayloadData"), ("checkEXT", "xrender_CheckEXT")):
+        if source in xrender:
+            config[key] = xrender[source]
+    return {"configs": config}
+
+
+def write_profiles(output: Path, contents: str):
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with tempfile.NamedTemporaryFile(
+        mode="w", encoding="utf-8", dir=output.parent, prefix=f".{output.name}.", delete=False
+    ) as temporary:
+        path = Path(temporary.name)
+        try:
+            temporary.write(contents)
+            os.fchmod(temporary.fileno(), 0o644)
+            temporary.close()
+            path.replace(output)
+        finally:
+            path.unlink(missing_ok=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--joyose-apk", type=Path, required=True)
+    parser.add_argument("--odm-defaults", type=Path, required=True)
+    parser.add_argument("--output", type=Path, help="Atomically replace this file. Defaults to stdout.")
+    parser.add_argument("--mivk-reference-reply", action="store_true",
+                        help="Emit the 406 Genshin CN MiVK reply for standard GPU tuning")
+    args = parser.parse_args()
+    try:
+        if args.mivk_reference_reply:
+            profiles = mivk_reference_reply(read_stock_config(args.joyose_apk, args.odm_defaults))
+        else:
+            profiles = extract_profiles(args.joyose_apk, args.odm_defaults)
+        contents = json.dumps(profiles, ensure_ascii=False, indent=2) + "\n"
+        if args.output is None:
+            sys.stdout.write(contents)
+        else:
+            write_profiles(args.output, contents)
+    except (OSError, ValueError, KeyError, TypeError, struct.error, zipfile.BadZipFile) as error:
+        parser.exit(1, f"{parser.prog}: {error}\n")
+
+
+if __name__ == "__main__":
+    main()
