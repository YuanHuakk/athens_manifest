diff --git a/compat/aptx_adaptive_stock/aptx_adaptive.xml b/compat/aptx_adaptive_stock/aptx_adaptive.xml
new file mode 100644
index 0000000000000000000000000000000000000000..fa8857a1a8ad73f621225a461d43ed714e88ea06
--- /dev/null
+++ b/compat/aptx_adaptive_stock/aptx_adaptive.xml
@@ -0,0 +1,7 @@
+<manifest version="9.0" type="device">
+    <hal format="aidl">
+        <name>android.hardware.bluetooth.audio</name>
