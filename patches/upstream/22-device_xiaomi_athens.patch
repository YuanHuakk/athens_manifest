+def fixup_supernight_raw_protection(ctx, file, file_path, *args, **kwargs):
+    """Use RW during SuperNight decryption and R afterward."""
+    path = Path(file_path)
+    data = bytearray(path.read_bytes())
+    stock_hash = "bc99d7e100d6f3f3415e34a65eef9347a5f5560f7b769ca1ef45042134f47c6f"
+    fixed_hash = "ac81b956e569bdc4e2e6b7c03653ef90db7fb940d983a770e318235ad1b4cccc"
+    source_hash = hashlib.sha256(data).hexdigest()
+    if source_hash == fixed_hash:
+        return
+    if source_hash != stock_hash:
+        raise ValueError(f"{path}: unexpected SuperNight RAW SHA-256 {source_hash}")
+
+    # DecryptSection only changes protection on data pages before .text.
+    # The mprotect flags are passed in w2 on AArch64.
+    data[0x3EF27C:0x3EF280] = bytes.fromhex("62 00 80 52")  # mov w2, #3 (RW)
+    data[0x3EF90C:0x3EF910] = bytes.fromhex("22 00 80 52")  # mov w2, #1 (R)
+    if hashlib.sha256(data).hexdigest() != fixed_hash:
+        raise ValueError(f"{path}: unexpected SuperNight RAW SHA-256 after fixup")
+    path.write_bytes(data)
+
