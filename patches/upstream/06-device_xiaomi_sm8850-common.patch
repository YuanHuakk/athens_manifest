+def fixup_wfd_hdcp_destructors(ctx, file, file_path, *args, **kwargs):
+    # Register sMutex before sHDCPFactory and sDeathNotifier so it outlives
+    # their destructors. The stock order locks an already destroyed mutex
+    # when the lazy DRM service exits after getSupportedCryptoSchemes().
+    before = bytes.fromhex(
+        "3f2303d5fd7bbea9f30b00f9fd030091610000b01f2003d593d10410219840f91f2003d5"
+        "c00a0010e20313aa69200094610000b01f2003d5400f0010219c40f9e20313aa63200094"
+        "600000b0610000b000ac40f921a040f9e20313aaf30b40f9fd7bc2a8bf2303d55a200014"
+    )
+    after = bytes.fromhex(
+        "3f2303d5fd7bbea9f30b00f9fd030091610000b01f2003d593d1041021a040f9600000b0"
+        "00ac40f9e20313aa69200094610000b01f2003d5200a0010219840f9e20313aa63200094"
+        "1f2003d5610000b0800e0010219c40f9e20313aaf30b40f9fd7bc2a8bf2303d55a200014"
+    )
+    with open(file_path, 'rb') as stream:
+        data = stream.read()
+    if data.count(after) == 1:
+        return
+    if data.count(before) != 1:
+        raise ValueError('Unexpected WFD HDCP static initializer')
+    with open(file_path, 'wb') as stream:
+        stream.write(data.replace(before, after, 1))
+
