diff --git a/compat/vpp_dsp.c b/compat/vpp_dsp.c
new file mode 100644
index 0000000000000000000000000000000000000000..e3abbc294e3ef35cb7afc77d59f9a567a7911a49
--- /dev/null
+++ b/compat/vpp_dsp.c
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#include <dlfcn.h>
+#include <string.h>
+
+int __open_2(const char *path, int flags) {
+    int (*real_open)(const char *, int) = dlsym(RTLD_NEXT, "__open_2");
+    // VPP's signed CDSP sessions use the secure node allowed by its policy.
+    if (strcmp(path, "/dev/fastrpc-nsp1000") == 0) {
+        path = "/dev/fastrpc-cdsp-secure";
+    }
+    return real_open(path, flags);
+}
