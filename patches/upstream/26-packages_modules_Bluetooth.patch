+namespace {
+
+constexpr uint16_t kQtiA2dpOffloadOpcode = 0xfc0a;
+constexpr uint8_t kQtiA2dpOffloadStart = 0x0a;
+constexpr uint8_t kQtiA2dpOffloadStop = 0x05;
+constexpr uint8_t kQtiA2dpAptxAdaptive = 0x0a;
+constexpr size_t kQtiOffloadCodecOffset = 22;
+constexpr size_t kQtiOffloadCodecSize = 44;
+constexpr size_t kAptxAdaptiveCieSize = a2dp::kAptxAdaptiveCieLength + 1;
+static_assert(kAptxAdaptiveCieSize <= kQtiOffloadCodecSize);
+
+// The BTA control block is cleared when the profile is enabled again. Keep tokens unique across
+// that reset so a late completion cannot acknowledge a new stream using the same handle.
+uint64_t qti_aptx_adaptive_offload_sequence = 0;
+
+void report_qti_aptx_adaptive_start(tBTA_AV_HNDL handle, tBTA_AV_STATUS status) {
+  tBTA_AV result{.offload_start = {.status = status, .hndl = handle}};
+  (*bta_av_cb.p_cback)(BTA_AV_OFFLOAD_START_RSP_EVT, &result);
+}
+
+bool qti_a2dp_offload_succeeded(const hci::CommandCompleteView& complete, uint8_t subcommand) {
+  const auto payload = complete.GetPayload();
+  return payload.size() >= 2 && payload[0] == 0 && payload[1] == subcommand;
+}
+
+void send_qti_aptx_adaptive_stop() {
+  std::array<uint8_t, 2> parameters{kQtiA2dpOffloadStop, 0};
+  btu_hcif_send_cmd_with_cb(kQtiA2dpOffloadOpcode, parameters.data(), parameters.size(),
+                            base::BindOnce([](hci::CommandCompleteView complete) {
+                              if (qti_a2dp_offload_succeeded(complete, kQtiA2dpOffloadStop)) {
+                                log::info("Qualcomm aptX Adaptive offload stopped");
+                              } else {
+                                log::warn("Qualcomm aptX Adaptive offload stop failed");
+                              }
+                            }));
+}
+
+}  // namespace
+
+static void bta_av_stop_qti_aptx_adaptive_offload(const tBTA_AV_SCB& scb) {
+  if (bta_av_cb.qti_aptx_adaptive_offload_generation == 0) {
+    return;
+  }
+
+  const bool pending = bta_av_cb.offload_start_pending_hndl == scb.hndl;
+  if (!pending && bta_av_cb.offload_started_hndl != scb.hndl) {
+    return;
+  }
+
+  bta_av_cb.qti_aptx_adaptive_offload_generation = 0;
+  bta_av_cb.offload_start_pending_hndl = BTA_AV_INVALID_HANDLE;
+  bta_av_cb.offload_started_hndl = BTA_AV_INVALID_HANDLE;
+  // HCI serializes commands. Queue the stop even if the controller has yet to finish the start.
+  send_qti_aptx_adaptive_stop();
+  if (pending && scb.PeerAddress() == btif_av_source_active_peer()) {
+    report_qti_aptx_adaptive_start(scb.hndl, BTA_AV_FAIL_STREAM);
+  }
+}
+
+static void on_qti_aptx_adaptive_started(tBTA_AV_HNDL handle, uint64_t generation,
+                                         hci::CommandCompleteView complete) {
+  if (bta_av_cb.qti_aptx_adaptive_offload_generation != generation ||
+      bta_av_cb.offload_start_pending_hndl != handle) {
+    return;
+  }
+
+  const auto payload = complete.GetPayload();
+  const bool started = qti_a2dp_offload_succeeded(complete, kQtiA2dpOffloadStart);
+  const tBTA_AV_SCB* scb = bta_av_hndl_to_scb(handle);
+  const bool active = scb && scb->PeerAddress() == btif_av_source_active_peer();
+  bta_av_cb.offload_start_pending_hndl = BTA_AV_INVALID_HANDLE;
+  if (started && active && scb->started && !scb->suspending) {
+    bta_av_cb.offload_started_hndl = handle;
+    log::info("Qualcomm aptX Adaptive offload started");
+    report_qti_aptx_adaptive_start(handle, BTA_AV_SUCCESS);
+    return;
+  }
+
+  bta_av_cb.qti_aptx_adaptive_offload_generation = 0;
+  if (payload.size() == 0 || payload[0] == 0) {
+    // The command may have started the hardware even when its completion was incomplete.
+    send_qti_aptx_adaptive_stop();
+  }
+  if (!started) {
+    const int status = payload.size() == 0 ? -1 : payload[0];
+    log::warn("Qualcomm aptX Adaptive offload start failed: HCI status={}, length={}", status,
+              payload.size());
+  }
+  if (active) {
+    const bool stream_running = scb->started && !scb->suspending;
+    const auto status = stream_running ? BTA_AV_FAIL_RESOURCES : BTA_AV_FAIL_STREAM;
+    report_qti_aptx_adaptive_start(handle, status);
+  }
+}
+
+static void bta_av_start_qti_aptx_adaptive_offload(tBTA_AV_SCB& scb) {
+  if (scb.suspending || scb.PeerAddress() != btif_av_source_active_peer()) {
+    report_qti_aptx_adaptive_start(scb.hndl, BTA_AV_FAIL_STREAM);
+    return;
+  }
+
+  auto* controller = shim::GetController();
+  auto* codec = bta_av_get_a2dp_peer_current_codec(scb.PeerAddress());
+  std::array<uint8_t, AVDT_CODEC_SIZE> provider_config;
+  if (!controller ||
+      controller->GetLocalVersionInformation().manufacturer_name_ != LMP_COMPID_QTI || !codec ||
+      !codec->isHardwareProviderCodec() || codec->codecId() != a2dp::kAptxAdaptiveCodec ||
+      scb.cfg.codec_info[0] != a2dp::kAptxAdaptiveCieLength ||
+      A2DP_GetMediaType(scb.cfg.codec_info) != AVDT_MEDIA_TYPE_AUDIO ||
+      a2dp::ParseCodecId(scb.cfg.codec_info) != a2dp::kAptxAdaptiveCodec ||
+      !codec->copyOutOtaCodecConfig(provider_config.data()) ||
+      !std::equal(provider_config.begin(), provider_config.begin() + kAptxAdaptiveCieSize,
+                  scb.cfg.codec_info)) {
+    log::warn("Qualcomm aptX Adaptive offload requires a negotiated hardware codec configuration");
+    report_qti_aptx_adaptive_start(scb.hndl, BTA_AV_FAIL_RESOURCES);
+    return;
+  }
+
+  // Qualcomm's sampling frequency field uses the same bit values as btav for 44.1–192 kHz.
+  const auto sample_rate = static_cast<uint16_t>(codec->getCodecConfig().sample_rate);
+  const uint16_t acl_handle = get_btm_client_interface().peer.BTM_GetHCIConnHandle(
+          scb.PeerAddress(), BT_TRANSPORT_BR_EDR);
+  uint16_t remote_cid = 0;
+  if (!std::has_single_bit(sample_rate) || sample_rate > BTAV_A2DP_CODEC_SAMPLE_RATE_192000 ||
+      acl_handle == HCI_INVALID_HANDLE || scb.stream_mtu == 0 ||
+      !stack::l2cap::get_interface().L2CA_GetRemoteChannelId(scb.l2c_cid, &remote_cid) ||
+      remote_cid == 0) {
+    log::warn("Qualcomm aptX Adaptive offload has an invalid sample rate or transport");
+    report_qti_aptx_adaptive_start(scb.hndl, BTA_AV_FAIL_RESOURCES);
+    return;
+  }
+
+  std::array<uint8_t, kQtiOffloadCodecOffset + kQtiOffloadCodecSize> parameters{};
+  parameters[0] = kQtiA2dpOffloadStart;
+  parameters[1] = kQtiA2dpAptxAdaptive;  // Codec type
+  parameters[3] = kQtiA2dpAptxAdaptive;  // Stream type
+  parameters[7] = scb.p_cos->get_scmst_info(scb.PeerAddress()).enable_status;
+  parameters[8] = 2;  // SCMS-T header
+  uint8_t* transport = parameters.data() + 9;
+  UINT16_TO_STREAM(transport, sample_rate);
+  UINT16_TO_STREAM(transport, acl_handle);
+  UINT16_TO_STREAM(transport, remote_cid);
+  const uint16_t mtu =
+          std::min<uint16_t>(scb.stream_mtu, MAX_3MBPS_AVDTP_MTU) + AVDT_MEDIA_HDR_SIZE;
+  UINT16_TO_STREAM(transport, mtu);
+  parameters[17] = 1;    // Start streaming
+  parameters[20] = 150;  // Time to play (little-endian)
+  // LOSC is 42, so there are 43 bytes including LOSC. The controller field holds 44 bytes.
+  std::copy_n(scb.cfg.codec_info, kAptxAdaptiveCieSize,
+              parameters.begin() + kQtiOffloadCodecOffset);
+
+  const uint64_t generation = ++qti_aptx_adaptive_offload_sequence;
+  bta_av_cb.qti_aptx_adaptive_offload_generation = generation;
+  bta_av_cb.offload_start_pending_hndl = scb.hndl;
+  bta_av_cb.offload_start_v2 = false;
+  btu_hcif_send_cmd_with_cb(kQtiA2dpOffloadOpcode, parameters.data(), parameters.size(),
+                            base::BindOnce(on_qti_aptx_adaptive_started, scb.hndl, generation));
+}
