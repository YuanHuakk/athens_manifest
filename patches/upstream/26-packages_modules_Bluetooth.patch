+bool BtaAvCo::FallbackFromAptxAdaptive(const RawAddress& peer_address) {
+  BtaAvCoPeer* peer = peer_cache_->FindPeer(peer_address);
+  if (peer == nullptr || !peer->opened || peer != bta_av_source_state_.getActivePeer()) {
+    return false;
+  }
+  auto* current_codec = peer->GetCodecs()->getCurrentCodecConfig();
+  if (current_codec == nullptr || current_codec->codecId() != bluetooth::a2dp::kAptxAdaptiveCodec) {
+    return false;
+  }
+
+  const auto source_codecs = peer->GetCodecs()->orderedSourceCodecs();
+  for (auto codec_index : {BTAV_A2DP_CODEC_INDEX_SOURCE_AAC, BTAV_A2DP_CODEC_INDEX_SOURCE_SBC}) {
+    auto codec = std::find_if(source_codecs.begin(), source_codecs.end(),
+                              [codec_index](const A2dpCodecConfig* config) {
+                                return config->codecIndex() == codec_index;
+                              });
+    if (codec == source_codecs.end()) {
+      continue;
+    }
+    const auto* sink = AttemptSourceCodecSelection(**codec, peer);
+    if (sink == nullptr) {
+      continue;
+    }
+    peer->acceptor = false;
+    uint8_t num_protect =
+            ContentProtectEnabled() && peer->ContentProtectActive() ? AVDT_CP_INFO_LEN : 0;
+    log::info("Reconfiguring aptX Adaptive stream to {}", (*codec)->name());
+    BTA_AvReconfig(peer->BtaAvHandle(), true, sink->sep_info_idx, peer->codec_config, num_protect,
+                   bta_av_co_cp_scmst);
+    return true;
+  }
+  return false;
+}
