+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.app;
+
+import android.app.ActivityManager;
+import android.app.ActivityManagerInternal;
+import android.app.ActivityTaskManager;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Binder;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.system.OsConstants;
+import android.util.Slog;
+import android.view.Display;
+import android.view.DisplayAddress;
+
+import com.android.server.LocalServices;
+import com.android.server.wm.ActivityTaskManagerInternal;
+import com.android.server.wm.ActivityTaskManagerInternal.ForegroundSurfaceTarget;
+
+import libcore.util.HexEncoding;
+
+import java.io.File;
+import java.util.List;
+
+/** Admits external motion vectors only for the selected, authenticated foreground game. */
+final class AthensEmvSession {
+    static final String GAME = "com.miHoYo.Yuanshen";
+    private static final String TAG = "AthensEmvSession";
+    private static final String SURFACE_FLINGER = "SurfaceFlinger";
+    private static final String SURFACE_COMPOSER = "android.ui.ISurfaceComposer";
+    private static final int PREPARE = 31601;
+    private static final int HEALTH = 31602;
+    private static final int STOP = 31603;
+    private static final int ARM = 31604;
+    private static final int PAUSE_IF_IDLE = 31607;
+    private static final int POLL_MS = 250;
+    // The compositor reports HWC delivery over a rolling 250 ms window. A missed poll
+    // is normal during gameplay. The native worker independently idles after 75 ms.
+    private static final int DELIVERY_TIMEOUT_MS = 1500;
+    private static final int INITIAL_RETRY_MS = 4000;
+    private static final int MAX_RETRY_MS = 30_000;
+    private static final String JOYOSE = "xiaomi.joyose";
+    private static final String JOYOSE_DESCRIPTOR = "com.xiaomi.joyose.IJoyoseInterface";
+    private static final int QUERY = IBinder.FIRST_CALL_TRANSACTION + 29;
+    private static final int REGISTER = IBinder.FIRST_CALL_TRANSACTION + 34;
+    private static final byte[] GAME_CERT = HexEncoding.decode(
+            "f2d8dcddd05056151347b5f319605229885c71461809ab58ed90d8347e3b4a49");
+    private static final File PRODUCER = new File("/system_ext/lib64/libathens_mivk_bridge.so");
+
+    private record Target(ForegroundSurfaceTarget owner, long physicalId) {}
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final Runnable mReevaluate;
+    private final Runnable mPoll = this::poll;
+    private final String mProfile;
+    // Keep the eligible owner while backing off so the timer can recheck all scene gates.
+    private Target mTarget;
+    private long mGeneration;
+    private boolean mPrepared;
+    private long mArmedAt = -1;
+    private long mLastDeliveryAt;
+    private long mStagedWithoutDeliverySince = -1;
+    private long mRetryAt;
+    private int mRetryDelay = INITIAL_RETRY_MS;
+
+    static AthensEmvSession create(Context context, Handler handler, Runnable reevaluate,
+            String profile) {
+        if (profile == null || !PRODUCER.isFile()) return null;
+        final AthensEmvSession session = new AthensEmvSession(context, handler, reevaluate,
+                profile);
+        try {
+            if (ServiceManager.checkService(JOYOSE) != null) return null;
+            final JoyoseConfig service = session.new JoyoseConfig();
+            ServiceManager.addService(JOYOSE, service);
+            if (ServiceManager.checkService(JOYOSE) != service) return null;
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Could not publish the MiVK configuration service", e);
+            return null;
+        }
+        return session;
+    }
+
+    private AthensEmvSession(Context context, Handler handler, Runnable reevaluate,
+            String profile) {
+        mContext = context;
+        mHandler = handler;
+        mReevaluate = reevaluate;
+        mProfile = profile;
+    }
+
+    long update(ActivityTaskManager.RootTaskInfo task, Display display) {
+        final ActivityTaskManagerInternal atm = LocalServices.getService(
+                ActivityTaskManagerInternal.class);
+        final DisplayAddress address = display.getAddress();
+        final ForegroundSurfaceTarget owner = atm.getForegroundSurfaceTarget(GAME, task.userId,
+                task.taskId);
+        if (address == null || owner == null || UserHandle.getUserId(owner.uid()) != task.userId) {
+            clear();
+            return 0;
+        }
+        final long displayId = address.getPhysicalDisplayId();
+        if (displayId == DisplayAddress.INVALID_DISPLAY_ID) {
+            clear();
+            return 0;
+        }
+        final Target target = new Target(owner, displayId);
+        if (!target.equals(mTarget)) {
+            clear();
+            mTarget = target;
+        }
+        final long now = SystemClock.uptimeMillis();
+        if (!mPrepared) {
+            if (now < mRetryAt) return 0;
+            if (!isSignedGame(owner.uid())) {
+                clear();
+                return 0;
+            }
+            mHandler.removeCallbacks(mPoll);
+            mGeneration = Math.max(mGeneration + 1, SystemClock.elapsedRealtimeNanos());
+            if (transact(PREPARE, target) != 0) {
+                retry();
+                return 0;
+            }
+            mPrepared = true;
+            mRetryAt = 0;
+        }
+        final boolean deliveryExpired = mArmedAt >= 0
+                && now - mLastDeliveryAt >= DELIVERY_TIMEOUT_MS;
+        final int health = transact(deliveryExpired ? PAUSE_IF_IDLE : HEALTH, null);
+        if (health < 0) {
+            retry();
+            return 0;
+        }
+        if (mArmedAt >= 0) {
+            if (health == 1) {
+                // A fresh source returning from an idle interval needs time to reach HWC.
+                if (mStagedWithoutDeliverySince < 0) mStagedWithoutDeliverySince = now;
+                if (now - mStagedWithoutDeliverySince >= DELIVERY_TIMEOUT_MS) {
+                    retry();
+                    return 0;
+                }
+            } else {
+                mStagedWithoutDeliverySince = -1;
+                if (health == 2) {
+                    mLastDeliveryAt = now;
+                    if (now - mArmedAt >= MAX_RETRY_MS) mRetryDelay = INITIAL_RETRY_MS;
+                } else if (deliveryExpired) {
+                    // SF disarmed in the same transaction that confirmed there was no source.
+                    mArmedAt = -1;
+                }
+            }
+        }
+        if (!mHandler.hasCallbacks(mPoll)) mHandler.postDelayed(mPoll, POLL_MS);
+        return health > 0 || mArmedAt >= 0 ? mGeneration : 0;
+    }
+
+    boolean arm(long generation) {
+        if (!mPrepared || generation != mGeneration) return false;
+        if (mArmedAt >= 0) return true;
+        final int result = transact(ARM, null);
+        if (result != 0) {
+            // The source can go quiet during FrameMaster's asynchronous mode transition.
+            if (result != -OsConstants.EAGAIN) retry();
+            return false;
+        }
+        mArmedAt = SystemClock.uptimeMillis();
+        mLastDeliveryAt = mArmedAt;
+        mStagedWithoutDeliverySince = mArmedAt;
+        return true;
+    }
+
+    void reject(long generation) {
+        if (mPrepared && generation == mGeneration) retry();
+    }
+
+    private void retry() {
+        stop();
+        mRetryAt = SystemClock.uptimeMillis() + mRetryDelay;
+        mRetryDelay = Math.min(MAX_RETRY_MS, mRetryDelay * 2);
+        mHandler.postAtTime(mPoll, mRetryAt);
+    }
+
+    void clear() {
+        stop();
+        mTarget = null;
+        mRetryAt = 0;
+        mRetryDelay = INITIAL_RETRY_MS;
+    }
+
+    private void stop() {
+        mHandler.removeCallbacks(mPoll);
+        if (mPrepared) transact(STOP, null);
+        mPrepared = false;
+        mArmedAt = -1;
+    }
+
+    private void poll() {
+        if (mTarget != null) mReevaluate.run();
+    }
+
+    private int transact(int operation, Target target) {
+        final IBinder service = ServiceManager.checkService(SURFACE_FLINGER);
+        if (service == null) return -1;
+        final Parcel request = Parcel.obtain(service);
+        final Parcel reply = Parcel.obtain();
+        try {
+            request.writeInterfaceToken(SURFACE_COMPOSER);
+            request.writeLong(mGeneration);
+            if (target != null) {
+                request.writeInt(target.owner().uid());
+                request.writeInt(target.owner().pid());
+                request.writeInt(target.owner().taskId());
+                request.writeLong(target.physicalId());
+                request.writeInt(target.owner().layerId());
+            }
+            if (!service.transact(operation, request, reply, 0)) return -1;
+            reply.readException();
+            return reply.readInt();
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "SurfaceFlinger EMV session request failed: " + operation, e);
+            return -1;
+        } finally {
+            request.recycle();
+            reply.recycle();
+        }
+    }
+
+    private boolean isSignedGame(int uid) {
+        final UserHandle user = UserHandle.of(UserHandle.getUserId(uid));
+        final PackageManager manager = mContext.createContextAsUser(user, 0).getPackageManager();
+        try {
+            return manager.getPackageUid(GAME, 0) == uid
+                    && manager.hasSigningCertificate(GAME, GAME_CERT,
+                            PackageManager.CERT_INPUT_SHA256);
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
+
+    private static boolean isMainGameProcess(int uid, int pid) throws RemoteException {
+        final ActivityManagerInternal am = LocalServices.getService(ActivityManagerInternal.class);
+        if (am == null || !GAME.equals(am.getPackageNameByPid(pid))) return false;
+        final List<ActivityManager.RunningAppProcessInfo> running =
+                ActivityManager.getService().getRunningAppProcesses();
+        if (running == null) return false;
+        for (ActivityManager.RunningAppProcessInfo process : running) {
+            if (process.uid == uid && process.pid == pid && GAME.equals(process.processName)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private final class JoyoseConfig extends Binder {
+        JoyoseConfig() {
+            attachInterface(null, JOYOSE_DESCRIPTOR);
+        }
+
+        @Override
+        protected boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            if (code != QUERY && code != REGISTER) return super.onTransact(code, data, reply, flags);
+            if (code == QUERY && reply == null) return false;
+            data.enforceInterface(JOYOSE_DESCRIPTOR);
+            if (data.dataAvail() > 256) return false;
+            final String process = data.readString();
+            if (code == REGISTER) data.readStrongBinder();
+            data.enforceNoDataAvail();
+            final int uid = Binder.getCallingUid();
+            final int pid = Binder.getCallingPid();
+            final long identity = Binder.clearCallingIdentity();
+            try {
+                if (code == QUERY) {
+                    final int user = UserHandle.getUserId(uid);
+                    final boolean eligible = GAME.equals(process)
+                            && user == ActivityManager.getCurrentUser()
+                            && isMainGameProcess(uid, pid) && isSignedGame(uid)
+                            && Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                                    AthensJoyoseGameSession.SETTING, 0, user)
+                                    == AthensJoyoseGameProfiles.MODE_FI;
+                    reply.writeNoException();
+                    reply.writeString(eligible ? mProfile : "");
+                }
+                // The original MIMV module reads the EMV state separately from the MiFISR callback.
+                return true;
+            } finally {
+                Binder.restoreCallingIdentity(identity);
+            }
+        }
+    }
+}
