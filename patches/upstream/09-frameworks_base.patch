+        }
+
+        boolean matchesNativeSelection(ActivityTaskManager.RootTaskInfo task, int mode) {
+            return kind == NATIVE_GAME && task.userId == userId && task.taskId == taskId
+                    && mode == nativeGameMode && activity.equals(task.topActivity.getPackageName());
+        }
+
+        boolean usesImageMemc() {
+            return vectorGeneration == 0 && requiresMemcTransition();
+        }
