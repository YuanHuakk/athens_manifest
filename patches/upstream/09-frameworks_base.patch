+    @Test
+    public void notificationSmallIcon_allowsGlyphWithTransparentPadding() {
+        Bitmap bitmap = Bitmap.createBitmap(16, 16, Bitmap.Config.ARGB_8888);
+        for (int y = 4; y < 12; y++) {
+            for (int x = 4; x < 12; x++) {
+                bitmap.setPixel(x, y, Color.WHITE);
+            }
+        }
+        assertTrue(StatusBarIconView.hasNotificationIconContour(
+                new BitmapDrawable(mContext.getResources(), bitmap)));
+    }
+
+    @Test
+    public void notificationSmallIcon_rejectsSolidAndEmptyIcons() {
+        assertFalse(StatusBarIconView.hasNotificationIconContour(new ColorDrawable(Color.RED)));
+        assertFalse(StatusBarIconView.hasNotificationIconContour(
+                new ColorDrawable(Color.TRANSPARENT)));
+    }
+
+    @Test
+    public void notificationSmallIcon_preservesLevelDependentIcons() {
+        LevelListDrawable drawable = new LevelListDrawable();
