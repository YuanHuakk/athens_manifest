+package com.android.server.app;
+
+import static com.android.server.app.AthensFrameEnhancementController.matchesFailure;
+import static com.android.server.app.AthensFrameEnhancementController.matchesNativeDeferral;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class AthensFrameEnhancementControllerTest {
+    private static final String CLOUD_PROFILE =
+            "LDSR:1,LDSRMode:1,LDSRV2Mode:0x22,Sharpness:1,SharpnessMode:1";
+    private static final String RESET_PROFILE = "SceneID:0000";
+
+    @Test
+    public void reportedFailureMatchesOriginalCommand() {
+        assertTrue(matchesFailure(6, 1, 1, "\"" + CLOUD_PROFILE + "\"", 1, true,
+                CLOUD_PROFILE));
+        assertTrue(matchesFailure(8, 0, 2, "\"SceneID:0000\"", 2, false, RESET_PROFILE));
+    }
+
+    @Test
+    public void unmatchedCallbackCannotChangeCurrentScene() {
+        assertFalse(matchesFailure(6, 0, 2, "\"SceneID:0000\"", 1, false, RESET_PROFILE));
+        assertFalse(matchesFailure(8, 1, 1, "\"" + CLOUD_PROFILE + "\"", 1, false,
+                RESET_PROFILE));
+        assertFalse(matchesFailure(6, 0, 2, RESET_PROFILE, 2, false, RESET_PROFILE));
+        assertFalse(matchesFailure(10, 0, 2, "\"SceneID:0000\"", 2, false, RESET_PROFILE));
+    }
+
+    @Test
+    public void deferredGameCommandMustMatchDirectionSceneAndQuotedProfile() {
+        final String fi = "Category:0,InputFPS:60,TargetFPS:120,MEMC:1,MEMCMode:0x2114";
+        final String quoted = "\"" + fi + "\"";
+        assertTrue(matchesNativeDeferral(7, 1, 3, quoted, true, fi));
+        assertTrue(matchesNativeDeferral(7, 0, 3, "\"SceneID:0000\"", false, RESET_PROFILE));
+        assertFalse(matchesNativeDeferral(7, 1, 1, quoted, true, fi));
+        assertFalse(matchesNativeDeferral(7, 0, 3, quoted, true, fi));
+        assertFalse(matchesNativeDeferral(7, 1, 3, fi, true, fi));
+        assertFalse(matchesNativeDeferral(7, 1, 3, quoted, true, RESET_PROFILE));
+        assertFalse(matchesNativeDeferral(8, 1, 3, quoted, true, fi));
+    }
+}
