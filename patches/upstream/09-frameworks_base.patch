+    /** Holds only the physical mode for an Athens game enhancement session. */
+    public boolean setAthensGamePhysicalDisplayMode(int modeId) {
+        final int displayId = Display.DEFAULT_DISPLAY;
+        final int priority = Vote.PRIORITY_ATHENS_GAME_PHYSICAL_REFRESH_RATE;
+        synchronized (mLock) {
+            if (modeId == 0) {
+                mVotesStorage.updateVote(displayId, priority, null);
+                return true;
+            }
+            final Display.Mode[] modes = mSupportedModesByDisplay.get(displayId);
+            if (modes == null) return false;
+            for (Display.Mode mode : modes) {
+                if (mode.getModeId() != modeId || mode.isSynthetic()) continue;
+                final float hz = mode.getRefreshRate();
+                mVotesStorage.updateVote(displayId, priority, Vote.forVotes(List.of(
+                        new RefreshRateVote.PhysicalVote(hz, hz),
+                        Vote.forSize(mode.getPhysicalWidth(), mode.getPhysicalHeight()))));
+                final DesiredDisplayModeSpecs specs = getDesiredDisplayModeSpecs(displayId);
+                if (specs.baseModeId == modeId
+                        && isPhysicalRangePinned(specs.primary.physical, hz)
+                        && isPhysicalRangePinned(specs.appRequest.physical, hz)) {
+                    return true;
+                }
+                mVotesStorage.updateVote(displayId, priority, null);
+                return false;
+            }
+            return false;
+        }
+    }
+
+    private static boolean isPhysicalRangePinned(RefreshRateRange range, float hz) {
+        // The panel's reported rate and the user's nominal cap can differ within AOSP tolerance.
+        return Math.abs(range.min - hz) <= RefreshRateRange.FLOAT_TOLERANCE
+                && Math.abs(range.max - hz) <= RefreshRateRange.FLOAT_TOLERANCE;
+    }
+
     /**
