+/** Applies the Athens stock Game HDR profiles when enabled by the foreground user. */
+final class AthensGameHdrController {
+    private static final String TAG = "AthensGameHdr";
+    private static final String SETTING = "gamespace_athens_game_hdr";
+    private static final String PROFILE_PATH = "/odm/etc/display/ui_service_cloud_config.xml";
+    private static final String FRAME_MASTER_DESCRIPTOR =
+            "vendor.xiaomi.hardware.framemaster.IFrameMaster";
+    private static final String FRAME_MASTER_SERVICE = FRAME_MASTER_DESCRIPTOR + "/default";
+    // IFrameMaster v1 setParameter is the first transaction in the stock 406 interface.
+    private static final int SET_PARAMETER_TRANSACTION = IBinder.FIRST_CALL_TRANSACTION;
+    private static final int GAME_HDR_CASE_ID = 0;
+    private static final int NOTIFY_NITS_BRIGHTNESS_ARRAY_TRANSACTION =
+            IBinder.FIRST_CALL_TRANSACTION + 5;
+    private static final float DEFAULT_USER_REFRESH_RATE = 120f;
+    private static final long TRANSITION_DELAY_MS = 400;
+    private static final long RESET_RETRY_MS = 1000;
+    private static final int MAX_RESET_RETRIES = 3;
+    private static final Pattern PACKAGE_NAME =
+            Pattern.compile("[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+");
+    private static final Pattern PROFILE =
+            Pattern.compile("LightPlus:1,LightPlusMode:0x[0-9a-fA-F]+"
+                    + "(?:,SDR2HDR:1,SDR2HDRMode:0x[0-9a-fA-F]+)?");
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final DisplayManager mDisplayManager;
+    private final PowerManager mPowerManager;
+    private final KeyguardManager mKeyguardManager;
+    private final Map<String, String> mProfiles;
+    private final AthensFrameEnhancementController mFrameEnhancement;
+    private final Runnable mUpdate = this::update;
+    private final Runnable mEnable = this::enableIfCurrent;
+    private String mPendingPackage;
+    private String mActivePackage;
+    private String mActiveProfile;
+    private int mResetRetries;
+
+    static void start(Context context, Handler handler) {
+        if (!"athens".equals(Build.DEVICE)) {
+            return;
+        }
+        handler.post(() -> {
+            Map<String, String> profiles;
+            try {
+                profiles = readStockProfiles();
+            } catch (IOException | XmlPullParserException | JSONException | RuntimeException e) {
+                Slog.w(TAG, "Cannot load the Game HDR profiles", e);
+                profiles = Map.of();
+            }
+            final AthensGameHdrController controller =
+                    new AthensGameHdrController(context, handler, profiles);
+            if (!profiles.isEmpty() || controller.mFrameEnhancement != null) {
+                controller.register();
+            }
+        });
+    }
+
+    private AthensGameHdrController(Context context, Handler handler, Map<String, String> profiles) {
+        mContext = context;
+        mHandler = handler;
+        mProfiles = profiles;
+        mDisplayManager = context.getSystemService(DisplayManager.class);
+        mPowerManager = context.getSystemService(PowerManager.class);
+        mKeyguardManager = context.getSystemService(KeyguardManager.class);
+        mFrameEnhancement = AthensFrameEnhancementController.create(context, handler,
+                this::getEligibleTask, () -> mActivePackage != null || mPendingPackage != null,
+                this::update);
+    }
+
+    private void register() {
+        mPowerManager.addThermalStatusListener(mHandler::post, status -> update());
+        ActivityTaskManager.getInstance().registerTaskStackListener(new TaskStackListener() {
+            @Override
+            public void onTaskStackChanged() {
+                mHandler.post(mUpdate);
+            }
+
+            @Override
+            public void onTaskFocusChanged(int taskId, boolean focused) {
+                mHandler.post(mUpdate);
+            }
+        });
+        mDisplayManager.registerDisplayListener(new DisplayManager.DisplayListener() {
+            @Override
+            public void onDisplayAdded(int displayId) {
+                if (displayId == DEFAULT_DISPLAY) {
+                    update();
+                } else if (mFrameEnhancement != null) {
+                    mFrameEnhancement.update();
+                }
+            }
+
+            @Override
+            public void onDisplayRemoved(int displayId) {
+                if (displayId == DEFAULT_DISPLAY) {
+                    update();
+                } else if (mFrameEnhancement != null) {
+                    mFrameEnhancement.update();
+                }
+            }
+
+            @Override
+            public void onDisplayChanged(int displayId) {
+                if (displayId == DEFAULT_DISPLAY) {
+                    update();
+                } else if (mFrameEnhancement != null) {
+                    mFrameEnhancement.update();
+                }
+            }
+        }, mHandler);
+        IntentFilter filter = new IntentFilter(Intent.ACTION_SCREEN_OFF);
+        filter.addAction(Intent.ACTION_SCREEN_ON);
+        filter.addAction(Intent.ACTION_USER_PRESENT);
+        filter.addAction(Intent.ACTION_USER_SWITCHED);
+        filter.addAction(PowerManager.ACTION_POWER_SAVE_MODE_CHANGED);
+        mContext.registerReceiver(new BroadcastReceiver() {
+            @Override
+            public void onReceive(Context context, Intent intent) {
+                update();
+            }
+        }, filter, null, mHandler, Context.RECEIVER_NOT_EXPORTED);
+        final ContentObserver settingsObserver = new ContentObserver(mHandler) {
+            @Override
+            public void onChange(boolean selfChange) {
+                update();
+            }
+        };
+        mContext.getContentResolver().registerContentObserver(Settings.Secure.getUriFor(SETTING),
+                false, settingsObserver, UserHandle.USER_ALL);
+        if (mFrameEnhancement != null) {
+            mContext.getContentResolver().registerContentObserver(Settings.Secure.getUriFor(
