+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.statusbar.notification.icon;
+
+import android.content.Context;
+import android.content.res.Resources;
+import android.content.res.XmlResourceParser;
+import android.graphics.drawable.Drawable;
+import android.util.ArrayMap;
+import android.util.Log;
+
+import androidx.annotation.Nullable;
+
+import com.android.systemui.res.R;
+
+import org.xmlpull.v1.XmlPullParser;
+import org.xmlpull.v1.XmlPullParserException;
+
+import java.io.IOException;
+import java.util.Collections;
+import java.util.Map;
+
+/** The offline package-to-monochrome-icon index bundled with SystemUI. */
+public final class NotificationSmallIconLibrary {
+    private static final String TAG = "NotificationSmallIcons";
+    private static final String ANDROID_NS = "http://schemas.android.com/apk/res/android";
+    private static final Object sLock = new Object();
+    private static volatile Map<String, Integer> sIconResources;
+
+    private NotificationSmallIconLibrary() {}
+
+    @Nullable
+    public static Drawable getDrawable(Context context, String packageName) {
+        Map<String, Integer> icons = sIconResources;
+        if (icons == null) {
+            synchronized (sLock) {
+                if (sIconResources == null) {
+                    sIconResources = readIndex(context.getResources());
+                }
+                icons = sIconResources;
+            }
+        }
+
+        Integer resource = icons.get(packageName);
+        return resource != null ? context.getDrawable(resource) : null;
+    }
+
+    private static Map<String, Integer> readIndex(Resources resources) {
+        ArrayMap<String, Integer> result = new ArrayMap<>();
+        try (XmlResourceParser parser = resources.getXml(R.xml.notification_small_icon_library)) {
+            for (int event = parser.next(); event != XmlPullParser.END_DOCUMENT;
+                    event = parser.next()) {
+                if (event != XmlPullParser.START_TAG || !"icon".equals(parser.getName())) continue;
+
+                String packageName = parser.getAttributeValue(null, "package");
+                int resource = parser.getAttributeResourceValue(ANDROID_NS, "icon", 0);
+                if (packageName != null && resource != 0) {
+                    result.put(packageName, resource);
+                }
+            }
+        } catch (IOException | XmlPullParserException | Resources.NotFoundException e) {
+            Log.w(TAG, "Unable to read the bundled notification icon index", e);
+        }
+        return Collections.unmodifiableMap(result);
+    }
+}
