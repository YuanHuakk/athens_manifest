+        assertNull(NotificationSmallIconLibrary.getDrawable(mContext, "com.eg.android.alipaygphone"));
+    }
+
+    @Test
+    public void notificationSmallIcon_recognizesOnlyMiPushLauncherResources() {
+        final String targetPackage = "com.example.target";
+        final StatusBarNotification notification = getMockSbn();
+        when(notification.getPackageName()).thenReturn(targetPackage);
+        when(notification.getOpPkg()).thenReturn("com.xiaomi.xmsf");
+
+        final ApplicationInfo app = new ApplicationInfo();
+        app.packageName = targetPackage;
+        app.icon = 0x7f010001;
+        app.logo = 0x7f010002;
+        final Context packageContext = mock(Context.class);
+        when(packageContext.getApplicationInfo()).thenReturn(app);
+
+        final StatusBarIcon icon = new StatusBarIcon(UserHandle.SYSTEM, targetPackage,
+                Icon.createWithResource(targetPackage, app.icon), 0, 0, "",
+                StatusBarIcon.Type.NotifSmallIcon);
+        assertTrue(StatusBarIconView.isMiPushAppIcon(packageContext, notification, icon));
+
+        icon.icon = Icon.createWithResource(targetPackage, app.logo);
+        assertTrue(StatusBarIconView.isMiPushAppIcon(packageContext, notification, icon));
+
+        icon.icon = Icon.createWithResource(targetPackage, 0x7f010003);
+        assertFalse(StatusBarIconView.isMiPushAppIcon(packageContext, notification, icon));
+
+        icon.icon = Icon.createWithResource("com.example.other", app.icon);
+        assertFalse(StatusBarIconView.isMiPushAppIcon(packageContext, notification, icon));
+
+        icon.icon = Icon.createWithResource(targetPackage, app.icon);
+        when(notification.getOpPkg()).thenReturn(targetPackage);
+        assertFalse(StatusBarIconView.isMiPushAppIcon(packageContext, notification, icon));
+    }
