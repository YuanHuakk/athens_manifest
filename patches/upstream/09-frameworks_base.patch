+    }
+
+    private boolean reset() {
+        final String state = mActiveProfile.contains(",SDR2HDR:1,")
+                ? "LightPlus:0,SDR2HDR:0" : "LightPlus:0";
+        if (!setParameter(false, getTransitionRefreshRate(), state)) {
+            return false;
+        }
+        mActivePackage = null;
+        mActiveProfile = null;
+        mResetRetries = 0;
+        return true;
+    }
+
+    private String getEligiblePackage(Display display) {
+        if (mFrameEnhancement != null && mFrameEnhancement.isBusy()) return null;
+        try {
+            final ActivityTaskManager.RootTaskInfo task = getEligibleTask(display);
+            if (task == null || Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                    SETTING, 0, task.userId) != 1) {
+                return null;
+            }
+            final String packageName = task.topActivity.getPackageName();
+            if (!mProfiles.containsKey(packageName)
+                    || (mFrameEnhancement != null
+                            && mFrameEnhancement.hasEligibleNativeGame(display))) {
+                return null;
+            }
+            return packageName;
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Cannot read the Game HDR setting", e);
+            return null;
+        }
+    }
+
+    private ActivityTaskManager.RootTaskInfo getEligibleTask(Display display) {
+        try {
+            if (display == null || display.getState() != Display.STATE_ON
+                    || !mPowerManager.isInteractive()
+                    || mKeyguardManager.isKeyguardLocked() || mPowerManager.isPowerSaveMode()
+                    || mPowerManager.getCurrentThermalStatus()
+                            >= PowerManager.THERMAL_STATUS_MODERATE) {
+                return null;
+            }
+            ActivityTaskManager.RootTaskInfo task =
+                    ActivityTaskManager.getService().getFocusedRootTaskInfo();
+            if (task == null || task.displayId != DEFAULT_DISPLAY || task.topActivity == null
+                    || !task.isVisible || task.userId != ActivityManager.getCurrentUser()
+                    || task.configuration.windowConfiguration.getWindowingMode()
+                            != WINDOWING_MODE_FULLSCREEN) {
+                return null;
+            }
+            return task;
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Cannot read the foreground game", e);
+            return null;
+        }
+    }
+
+    private int getTransitionRefreshRate() {
+        // 406 uses the same user-setting-based selector for enable and reset.
+        final float preferred = Settings.System.getFloatForUser(mContext.getContentResolver(),
+                Settings.System.PEAK_REFRESH_RATE, DEFAULT_USER_REFRESH_RATE,
+                UserHandle.USER_CURRENT);
+        return Math.round(preferred) == 60 ? 60 : 120;
+    }
+
+    private static boolean setParameter(boolean enabled, int refreshRate, String profile) {
+        try {
+            IBinder service = ServiceManager.checkService(FRAME_MASTER_SERVICE);
+            if (service == null || (enabled && (!isFrameMasterVersionOne(service)
+                    || !sendBrightnessMapping(service)))) {
+                return false;
+            }
+            Parcel data = Parcel.obtain(service);
+            try {
+                data.writeInterfaceToken(FRAME_MASTER_DESCRIPTOR);
+                data.writeInt(GAME_HDR_CASE_ID);
+                data.writeInt(enabled ? 1 : 0);
+                data.writeInt(refreshRate);
+                data.writeString("\"" + profile + "\"");
+                data.writeString("null");
+                boolean sent = service.transact(SET_PARAMETER_TRANSACTION, data, null,
+                        IBinder.FLAG_ONEWAY);
+                Slog.i(TAG, "Game HDR request enabled=" + enabled + " sent=" + sent);
+                return sent;
+            } finally {
+                data.recycle();
+            }
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Cannot send the Game HDR request", e);
+            return false;
+        }
+    }
+
+    private static boolean sendBrightnessMapping(IBinder service) throws RemoteException {
+        final DisplayManagerInternal displayManager =
+                LocalServices.getService(DisplayManagerInternal.class);
+        final BrightnessToNitsMapping mapping = displayManager == null ? null
+                : displayManager.getBrightnessToNitsMapping(DEFAULT_DISPLAY);
+        if (mapping == null) {
+            return false;
+        }
+        final float[] nits = mapping.nits();
+        final float[] brightness = mapping.brightness();
+        if (nits.length < 2 || nits.length != brightness.length) {
+            return false;
+        }
+        for (int i = 0; i < nits.length; i++) {
+            if (!Float.isFinite(nits[i]) || nits[i] < 0f
+                    || !Float.isFinite(brightness[i]) || brightness[i] < 0f || brightness[i] > 1f
+                    || (i > 0 && (nits[i] < nits[i - 1] || brightness[i] <= brightness[i - 1]))) {
+                return false;
+            }
+        }
+        final Parcel data = Parcel.obtain(service);
+        try {
+            // Stock UIService sends nits first, then normalized brightness, synchronously.
+            data.writeInterfaceToken(FRAME_MASTER_DESCRIPTOR);
+            data.writeFloatArray(nits);
+            data.writeFloatArray(brightness);
+            return service.transact(NOTIFY_NITS_BRIGHTNESS_ARRAY_TRANSACTION, data, null, 0);
+        } finally {
+            data.recycle();
+        }
+    }
+
+    private static boolean isFrameMasterVersionOne(IBinder service) throws RemoteException {
+        Parcel data = Parcel.obtain(service);
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(FRAME_MASTER_DESCRIPTOR);
+            if (!service.transact(IBinder.LAST_CALL_TRANSACTION, data, reply, 0)) {
+                return false;
+            }
+            reply.readException();
+            return reply.readInt() == 1;
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+
+    private static Map<String, String> readStockProfiles()
+            throws IOException, XmlPullParserException, JSONException {
+        try (FileInputStream stream = new FileInputStream(PROFILE_PATH)) {
+            XmlPullParser parser = Xml.newPullParser();
+            parser.setInput(stream, "UTF-8");
+            while (parser.next() != XmlPullParser.END_DOCUMENT) {
+                if (parser.getEventType() == XmlPullParser.START_TAG
+                        && "cloud-data-item".equals(parser.getName())
+                        && "gamehdr".equals(parser.getAttributeValue(null, "moduleName"))) {
+                    return readGameHdrList(parser.getAttributeValue(null, "moduleString"));
+                }
+            }
+        }
+        return Map.of();
+    }
+
+    private static Map<String, String> readGameHdrList(String value) throws JSONException {
+        JSONArray entries = new JSONObject(value).getJSONArray("mWhitePackageList");
+        Map<String, String> profiles = new ArrayMap<>();
+        if (entries.length() == 0 || !"switch on".equals(entries.getString(0))) {
+            return profiles;
+        }
+
+        for (int i = 1; i < entries.length(); i++) {
+            String[] entry = entries.getString(i).trim().split("#", -1);
+            if ((entry.length == 3 || entry.length == 4)
+                    && PACKAGE_NAME.matcher(entry[0]).matches() && PROFILE.matcher(entry[1]).matches()) {
+                profiles.putIfAbsent(entry[0], entry[1]);
+            }
+        }
+        return profiles;
+    }
+}
diff --git a/services/core/java/com/android/server/app/AthensJoyoseGameProfiles.java b/services/core/java/com/android/server/app/AthensJoyoseGameProfiles.java
