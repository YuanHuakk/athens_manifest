+    /** The legacy HDR controller yields only once the selected native mode can be submitted. */
+    boolean hasEligibleNativeGame(Display display) {
+        try {
+            if (getNativeGameMode(UserHandle.USER_CURRENT) == 0) return false;
+            final ActivityTaskManager.RootTaskInfo task = mEligibleTask.apply(display);
+            if (task == null) return false;
+            final int mode = getNativeGameMode(task.userId);
+            if (isRejectedNativeGame(task, mode) || !mNativeGameSession.supportsPackage(
+                    task.topActivity.getPackageName(), mode)) return false;
+            if (hasOtherActiveOutput()) return false;
+            final int panelHz = getPhysicalRefreshRate(display);
+            return !mHdrVisible && isNativeGameRate(panelHz)
+                    && getNativeGameScene(task, panelHz, mode) != null;
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Cannot check the native game display scene", e);
+            return false;
+        }
+    }
+
+    void update() {
+        if (mConnection != null && !mConnection.binder().isBinderAlive()) {
+            clearConnection();
+        }
+        Scene desired = getEligibleScene();
+        if (mHeldNativeGameModeId != 0 && (!Objects.equals(desired, mActive)
+                || !isNativeGameModeStillCurrent())) {
+            releaseNativeGameMode();
+            mResetRequired = true;
+        }
+        if (mResetPending || mHandler.hasCallbacks(mRetryReset)) return;
+        if (mRejectedScene != null && mRejectedScene.kind() != NATIVE_GAME) {
+            if (mRejectedScene.equals(desired)) {
+                desired = null;
+            } else {
+                mRejectedScene = null;
+            }
+        }
+        if (desired != null && (desired.equals(mPending) || (!mResetRequired
+                && desired.equals(mActive) && mConnection != null))) {
+            return;
+        }
+
+        mHandler.removeCallbacks(mEnable);
+        mPending = null;
+        if (mActive != null) {
+            mResetRequired = true;
+            if (mResetAttempts > MAX_RESET_RETRIES) return;
+            final long commandDelay = mActive.kind() == NATIVE_GAME ? remainingNativeGameDelay() : 0;
+            if (commandDelay > 0) {
+                mHandler.postDelayed(mRetryReset, commandDelay);
+                return;
+            }
+            mResetAttempts++;
+            final int refreshRate = mActive.kind() == NATIVE_GAME
+                    ? mNativeGameSession.resetRefreshRate(mActive.refreshRate())
+                    : getUserRefreshRate(UserHandle.USER_CURRENT);
+            if (!send(mActive.kind(), false, refreshRate, RESET)) {
+                scheduleResetRetry();
+                return;
+            }
+            // Keep both controllers blocked for the stock reset's settling interval.
+            mResetPending = true;
+            mResetTransitionEnded = false;
+            mHandler.postDelayed(mFinishReset, mActive.requiresMemcTransition()
+                    ? IMAGE_MEMC_SWITCH_TIMEOUT_MS : SWITCH_DELAY_MS);
+            return;
+        }
+        if (desired != null) {
+            mPending = desired;
+            mHandler.postDelayed(mEnable, desired.kind() == NATIVE_GAME
+                    ? Math.max(SWITCH_DELAY_MS, remainingNativeGameDelay()) : SWITCH_DELAY_MS);
+        }
+    }
+
+    private long remainingNativeGameDelay() {
+        return Math.max(0, mLastNativeGameCommand + NATIVE_GAME_COMMAND_INTERVAL_MS
+                - SystemClock.uptimeMillis());
+    }
+
+    private void finishReset() {
+        mResetPending = false;
+        if (mResetSwitching || (mActive != null && mActive.requiresMemcTransition()
+                && !mResetTransitionEnded)) {
+            // A deferred native command can produce no transition at all. Retry its reset.
+            mResetSwitching = false;
+            scheduleResetRetry();
+            return;
+        }
+        if (mConnection != null && mConnection.binder().isBinderAlive()
+                && ServiceManager.checkService(SERVICE) == mConnection.binder()) {
+            mActive = null;
+            mResetRequired = false;
+            mNativeGameBypassCheckAt = 0;
+        } else {
+            clearConnection();
+        }
+        mResetAttempts = 0;
+        mReevaluate.run();
+    }
+
+    private void retryReset() {
+        if (mResetAttempts > MAX_RESET_RETRIES && mActive != null
+                && mActive.requiresMemcTransition()) {
+            mResetAttempts = MAX_RESET_RETRIES;
+        }
+        mReevaluate.run();
+    }
+
+    private void scheduleResetRetry() {
+        if (mResetAttempts <= MAX_RESET_RETRIES) {
+            // Stock checks bypass again after a foreground change, only if it is still needed.
+            final long delay = mActive != null && mActive.kind() == NATIVE_GAME
+                    ? Math.max(RESET_RETRY_MS, mNativeGameBypassCheckAt - SystemClock.uptimeMillis())
+                    : RESET_RETRY_MS;
+            mHandler.postDelayed(mRetryReset, delay);
+        } else if (mActive != null && mActive.requiresMemcTransition()) {
+            // A competing stock client may hold the display past the quick retries.
+            mHandler.postDelayed(mRetryReset, RESET_RECOVERY_MS);
+        }
+    }
+
+    private void enableIfCurrent() {
+        final Scene pending = mPending;
+        mPending = null;
+        if (pending == null || isBusy() || !pending.equals(getEligibleScene())) return;
+        final boolean nativeGame = pending.kind() == NATIVE_GAME;
+        if ((nativeGame && !holdNativeGameMode(pending))
+                || !send(pending.kind(), true, pending.refreshRate(), pending.profile())) {
+            if (nativeGame) {
+                releaseNativeGameMode();
+                deferNativeScene(pending);
+            }
+            return;
+        }
+        mActive = pending;
+        mNativeGameBypassCheckAt = 0;
+        if (nativeGame) {
+            mHandler.postDelayed(mExpireNativeGameModeRequest, NATIVE_GAME_MODE_REQUEST_TIMEOUT_MS);
+            if (pending.requiresMemcTransition()) {
+                mHandler.postDelayed(mExpireImageMemcSwitch, IMAGE_MEMC_SWITCH_TIMEOUT_MS);
+            }
+        }
+    }
+
+    private boolean holdNativeGameMode(Scene scene) {
+        try {
+            if (getVerifiedService() == null) return false;
+            final Display display = mDisplayManager.getDisplay(DEFAULT_DISPLAY);
+            if (mDisplayManagerInternal == null || display == null
+                    || getPhysicalRefreshRate(display) != scene.refreshRate()
+                    || !isWithinUserRefreshRateBounds(scene.userId(), scene.refreshRate())) {
+                return false;
+            }
+            final int modeId = display.getMode().getModeId();
+            if (!mDisplayManagerInternal.setAthensGamePhysicalDisplayMode(modeId)) return false;
+            mHeldNativeGameModeId = modeId;
+            return isNativeGameModeStillCurrent()
+                    && getPhysicalRefreshRate(display) == scene.refreshRate();
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Cannot prepare FrameMaster for native game display mode", e);
+            return false;
+        }
+    }
+
+    private boolean isNativeGameModeStillCurrent() {
+        final Display display = mDisplayManager.getDisplay(DEFAULT_DISPLAY);
+        return display != null && display.getState() == Display.STATE_ON
+                && display.getMode().getModeId() == mHeldNativeGameModeId;
+    }
+
+    private void releaseNativeGameMode() {
+        mHandler.removeCallbacks(mExpireNativeGameModeRequest);
+        mHandler.removeCallbacks(mExpireImageMemcSwitch);
+        mNativeGameAcceptanceUntil = 0;
+        mAcceptedNativeGameEffects = 0;
+        if (mHeldNativeGameModeId != 0) {
+            mDisplayManagerInternal.setAthensGamePhysicalDisplayMode(0);
+            mHeldNativeGameModeId = 0;
+        }
+    }
+
+    private void expireNativeGameModeRequest() {
+        if (mActive == null || mActive.kind() != NATIVE_GAME || mHeldNativeGameModeId == 0) return;
+        Slog.w(TAG, "FrameMaster native game mode request timed out");
+        rejectActiveScene();
+    }
+
+    private void rejectActiveScene() {
+        if (mActive != null && mActive.vectorGeneration() != 0) {
+            mEmvSession.reject(mActive.vectorGeneration());
+        } else {
+            mRejectedScene = mActive;
+        }
+        resetActiveScene();
+    }
+
+    private void resetActiveScene() {
+        releaseNativeGameMode();
+        mResetRequired = true;
+        mReevaluate.run();
+    }
+
+    private void deferNativeScene(Scene scene) {
+        if (scene.vectorGeneration() != 0) {
+            mEmvSession.reject(scene.vectorGeneration());
+            mReevaluate.run();
+            return;
+        }
+        mRejectedScene = scene;
+        mNativeRetryDelay = scene.equals(mLastDeferredScene)
+                ? Math.min(RESET_RECOVERY_MS, mNativeRetryDelay * 2) : NATIVE_GAME_BYPASS_RECHECK_MS;
+        mLastDeferredScene = scene;
+        // Registration wakes us if the service is absent. Retry a busy service only while
+        // this exact foreground request still owns the deferral.
+        if (ServiceManager.checkService(SERVICE) != null) {
+            mHandler.postDelayed(() -> {
+                if (mRejectedScene != scene) return;
+                mRejectedScene = null;
+                mReevaluate.run();
+            }, mNativeRetryDelay);
+        }
+        mReevaluate.run();
+    }
+
+    private Scene getEligibleScene() {
+        final Scene scene = getEligibleImageScene();
+        if (mEmvSession == null) return scene;
+        if (scene == null || !scene.usesImageMemc() || scene.refreshRate() != 120
+                || !AthensEmvSession.GAME.equals(scene.activity())) {
+            mEmvSession.clear();
+            return scene;
+        }
+        final Display display = mDisplayManager.getDisplay(DEFAULT_DISPLAY);
+        final ActivityTaskManager.RootTaskInfo task = mEligibleTask.apply(display);
+        if (task == null || task.taskId != scene.taskId() || task.userId != scene.userId()
+                || !scene.activity().equals(task.topActivity.getPackageName())) {
+            mEmvSession.clear();
+            return null;
+        }
+        final long generation = mEmvSession.update(task, display);
+        if (generation == 0) return scene;
+        return new Scene(scene.kind(), scene.userId(), scene.activity(),
+                AthensJoyoseGameProfiles.externalMotionVectorCommand(scene.activity()),
+                scene.refreshRate(), scene.taskId(), scene.nativeGameMode(), generation);
+    }
+
+    private Scene getEligibleImageScene() {
+        try {
+            final int currentNativeMode = getNativeGameMode(UserHandle.USER_CURRENT);
+            if (currentNativeMode == 0 && mRejectedScene != null
+                    && mRejectedScene.kind() == NATIVE_GAME) {
+                mRejectedScene = null;
+            }
+            final boolean legacyHdrBusy = mGameHdrBusy.getAsBoolean();
+            if (!isEnabled(CLOUD_GAME_SETTING, UserHandle.USER_CURRENT)
+                    && !isEnabled(VIDEO_SETTING, UserHandle.USER_CURRENT)
+                    && currentNativeMode == 0) {
+                mNativeGameSession.clear();
+                if (mHdrDisplayToken != null) {
+                    mHdrListener.unregister(mHdrDisplayToken);
+                    mHdrDisplayToken = null;
+                    mHdrVisible = false;
+                }
+                return null;
+            }
+            final Display display = mDisplayManager.getDisplay(DEFAULT_DISPLAY);
+            final ActivityTaskManager.RootTaskInfo task = mEligibleTask.apply(display);
+            if (task != null && mActive != null && mActive.kind() == NATIVE_GAME
+                    && mNativeGameBypassCheckAt == 0
+                    && (task.taskId != mActive.taskId() || task.userId != mActive.userId()
+                            || !mActive.activity().equals(task.topActivity.getPackageName()))) {
+                mNativeGameBypassCheckAt = SystemClock.uptimeMillis() + NATIVE_GAME_BYPASS_RECHECK_MS;
+            }
+            if (task == null || hasOtherActiveOutput()) {
+                mNativeGameSession.clear();
+                return null;
+            }
+
+            final String packageName = task.topActivity.getPackageName();
+            final String activity = task.topActivity.flattenToString();
+            final String cloud = mCloudProfiles.get(packageName);
+            final String video = mVideoProfiles.get(activity);
+            final boolean cloudEnabled = cloud != null && isEnabled(CLOUD_GAME_SETTING, task.userId);
+            final boolean videoEnabled = video != null && isEnabled(VIDEO_SETTING, task.userId);
+            final int nativeMode = getNativeGameMode(task.userId);
+            final boolean nativeRejected = isRejectedNativeGame(task, nativeMode);
+            if (mRejectedScene != null && mRejectedScene.kind() == NATIVE_GAME && !nativeRejected) {
+                mRejectedScene = null;
+            }
+            final boolean nativeEnabled = nativeMode != 0
+                    && !nativeRejected && mNativeGameSession.supportsPackage(packageName, nativeMode);
+            if (!nativeEnabled && (legacyHdrBusy || (!cloudEnabled && !videoEnabled))) {
+                mNativeGameSession.clear();
+                return null;
+            }
+            final int panelHz = getPhysicalRefreshRate(display);
+            if (panelHz == 0 || mHdrVisible) {
+                mNativeGameSession.clear();
+                return null;
+            }
+            if (nativeEnabled && isNativeGameRate(panelHz)) {
+                // Keep sampling an eligible game while legacy HDR owns the display.
+                final Scene nativeScene = getNativeGameScene(task, panelHz, nativeMode);
+                if (nativeScene != null && !legacyHdrBusy) return nativeScene;
+            } else {
+                mNativeGameSession.clear();
+            }
+            if (legacyHdrBusy) return null;
+            final int refreshRate = getUserRefreshRate(task.userId);
+            if (panelHz != refreshRate) return null;
+            if (videoEnabled && (display.getRotation() == Surface.ROTATION_90
+                    || display.getRotation() == Surface.ROTATION_270)) {
+                return new Scene(VIDEO, task.userId, activity, video, refreshRate);
+            }
+            return cloudEnabled
+                    ? new Scene(CLOUD_GAME, task.userId, packageName, cloud, refreshRate) : null;
+        } catch (RuntimeException e) {
+            mNativeGameSession.clear();
+            Slog.w(TAG, "Cannot read the foreground display scene", e);
+            return null;
+        }
+    }
+
+    private boolean hasOtherActiveOutput() {
+        for (Display display : mDisplayManager.getDisplays()) {
+            if (display.getDisplayId() != DEFAULT_DISPLAY && display.getState() == Display.STATE_ON) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean isRejectedNativeGame(ActivityTaskManager.RootTaskInfo task, int mode) {
+        return mRejectedScene != null && mRejectedScene.matchesNativeSelection(task, mode);
+    }
+
+    private Scene getNativeGameScene(ActivityTaskManager.RootTaskInfo task, int panelHz, int mode) {
+        if (!isWithinUserRefreshRateBounds(task.userId, panelHz)) {
+            mNativeGameSession.clear();
+            return null;
+        }
+        final AthensJoyoseGameSession.GameProfile profile =
+                mNativeGameSession.evaluate(task, panelHz, mode);
+        if (profile == null || !isNativeGameRate(profile.targetHz())) return null;
+        return new Scene(NATIVE_GAME, task.userId, task.topActivity.getPackageName(),
+                profile.command(), profile.targetHz(), task.taskId, mode, 0);
+    }
+
+    private static boolean isNativeGameRate(int rate) {
+        return rate == 60 || rate == 120 || rate == 144 || rate == 165 || rate == 185;
+    }
+
+    private int getPhysicalRefreshRate(Display display) {
+        final DisplayAddress address = display.getAddress();
+        if (address == null) return 0;
+        final long physicalId = address.getPhysicalDisplayId();
+        if (physicalId == DisplayAddress.INVALID_DISPLAY_ID) return 0;
+        final SurfaceControl.StaticDisplayInfo panel = SurfaceControl.getStaticDisplayInfo(physicalId);
+        if (panel == null || !panel.isInternal) return 0;
+        final IBinder token = DisplayControl.getPhysicalDisplayToken(physicalId);
+        if (token == null) return 0;
+        if (token != mHdrDisplayToken) {
+            if (mHdrDisplayToken != null) mHdrListener.unregister(mHdrDisplayToken);
+            mHdrDisplayToken = null;
+            mHdrVisible = false;
+            mHdrListener.register(token);
+            mHdrDisplayToken = token;
+        }
+
+        final Display.Mode mode = display.getMode();
+        if (mode.isSynthetic()) return 0;
+        final int refreshRate = Math.round(mode.getRefreshRate());
+        final SurfaceControl.DynamicDisplayInfo info =
+                SurfaceControl.getDynamicDisplayInfo(physicalId);
+        if (info == null || info.supportedDisplayModes == null) return 0;
+        for (SurfaceControl.DisplayMode physicalMode : info.supportedDisplayModes) {
+            if (physicalMode.id == info.activeDisplayModeId) {
+                return Math.round(physicalMode.peakRefreshRate) == refreshRate ? refreshRate : 0;
+            }
+        }
+        return 0;
+    }
+
+    private int getNativeGameMode(int userId) {
+        final int mode = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                AthensJoyoseGameSession.SETTING, 0, userId);
+        return mode == 1 || mode == 2 || mode == 4 ? mode : 0;
+    }
+
+    private boolean isEnabled(String setting, int userId) {
+        return Settings.Secure.getIntForUser(mContext.getContentResolver(), setting, 0, userId) == 1;
+    }
+
+    private int getUserRefreshRate(int userId) {
+        final float peak = Settings.System.getFloatForUser(mContext.getContentResolver(),
+                Settings.System.PEAK_REFRESH_RATE, 120f, userId);
+        return Math.round(peak) == 60 ? 60 : 120;
+    }
+
+    private boolean isWithinUserRefreshRateBounds(int userId, int hz) {
+        float min = Settings.System.getFloatForUser(mContext.getContentResolver(),
+                Settings.System.MIN_REFRESH_RATE, 0f, userId);
+        final float peak = Settings.System.getFloatForUser(mContext.getContentResolver(),
+                Settings.System.PEAK_REFRESH_RATE, Float.POSITIVE_INFINITY, userId);
+        if (min == Float.POSITIVE_INFINITY) {
+            final Display display = mDisplayManager.getDisplay(DEFAULT_DISPLAY);
+            if (display == null) return false;
+            min = 0;
+            for (Display.Mode mode : display.getSupportedModes()) {
+                if (!mode.isSynthetic()) min = Math.max(min, Math.round(mode.getRefreshRate()));
+            }
+        }
+        return hz >= min && (peak == 0f || hz <= peak);
+    }
+
+    private void watchService() {
+        try {
+            ServiceManager.registerForNotifications(SERVICE, new IServiceCallback.Stub() {
+                @Override
+                public void onRegistration(String name, IBinder binder) {
+                    if (!SERVICE.equals(name) || binder == null) return;
+                    mHandler.post(() -> {
+                        if (!binder.isBinderAlive()
+                                || ServiceManager.checkService(SERVICE) != binder
+                                || (mConnection != null && mConnection.binder() == binder)) {
+                            return;
+                        }
+                        clearConnection();
+                        mRejectedScene = null;
+                        mHandler.removeCallbacks(mRetryReset);
+                        mResetAttempts = 0;
+                        mReevaluate.run();
+                    });
+                }
+            });
+        } catch (RemoteException | RuntimeException e) {
+            Slog.w(TAG, "Cannot watch FrameMaster service registration", e);
+        }
+    }
+
+    private IBinder getVerifiedService() throws RemoteException {
+        final IBinder binder = ServiceManager.checkService(SERVICE);
+        if (mConnection != null && mConnection.binder() == binder && binder.isBinderAlive()) {
+            return binder;
+        }
+        clearConnection();
+        if (binder == null || !binder.isBinderAlive() || !matchesStock(binder)) return null;
+        final IBinder.DeathRecipient deathRecipient = () -> mHandler.post(() -> {
+            if (mConnection != null && mConnection.binder() == binder) {
+                clearConnection();
+                mHandler.removeCallbacks(mRetryReset);
+                mResetAttempts = 0;
+                mReevaluate.run();
+            }
+        });
+        binder.linkToDeath(deathRecipient, 0);
+        mConnection = new Connection(binder, deathRecipient);
+        return binder;
+    }
+
+    private void clearConnection() {
+        releaseNativeGameMode();
+        if (mConnection != null) {
+            mConnection.binder().unlinkToDeath(mConnection.deathRecipient(), 0);
+            mConnection = null;
+        }
+        mHandler.removeCallbacks(mFinishReset);
+        mResetPending = false;
+        mResetSwitching = false;
+        // A lost service may have applied the scene or died before applying its reset.
+        if (mActive != null) mResetRequired = true;
+    }
+
+    private final class FrameMasterCallback extends Binder implements IBinder.DeathRecipient {
+        private final IBinder mService;
+
+        FrameMasterCallback(IBinder service) {
+            mService = service;
+            attachInterface(null, CALLBACK_DESCRIPTOR);
+            markVintfStability();
+        }
+
+        @Override
+        public void binderDied() {
+            mHandler.post(() -> {
+                if (mCallback != this) return;
+                mCallback = null;
+                if (mConnection == null || mConnection.binder() != mService) {
+                    mHandler.removeCallbacks(mRetryReset);
+                    mResetAttempts = 0;
+                    mReevaluate.run();
+                }
+            });
+        }
+
+        @Override
+        protected boolean onTransact(int code, Parcel data, Parcel reply, int flags)
+                throws RemoteException {
+            if (code == IBinder.FIRST_CALL_TRANSACTION) {
+                if ((flags & IBinder.FLAG_ONEWAY) == 0) return false;
+                data.enforceInterface(CALLBACK_DESCRIPTOR);
+                final int event = data.readInt();
+                if (event != PHYSICAL_MODE_REQUEST && event != BACKEND_FAILURE
+                        && event != COMMAND_DEFERRED && event != COMMAND_REJECTED && event != SWITCHING
+                        && event != MEMC_STATUS && event != LDSR_STATUS) {
+                    return true;
+                }
+                final int status = data.readInt();
+                final int parameter = data.readInt();
+                if ((event != PHYSICAL_MODE_REQUEST && event != MEMC_STATUS && event != LDSR_STATUS
+                        && parameter != CLOUD_GAME
+                        && parameter != VIDEO && parameter != NATIVE_GAME)
+                        || data.dataAvail() > 1024) return true;
+                final String command = data.readString();
+                data.enforceNoDataAvail();
+                mHandler.post(() -> onCallback(this, event, status, parameter, command));
+                return true;
+            }
+            if (code == IBinder.LAST_CALL_TRANSACTION || code == IBinder.LAST_CALL_TRANSACTION - 1) {
+                if (reply == null) return false;
+                data.enforceInterface(CALLBACK_DESCRIPTOR);
+                data.enforceNoDataAvail();
+                reply.writeNoException();
+                if (code == IBinder.LAST_CALL_TRANSACTION) reply.writeInt(1);
+                else reply.writeString(HASH);
+                return true;
+            }
+            return super.onTransact(code, data, reply, flags);
+        }
+    }
+
+    private boolean ensureCallback(IBinder service) throws RemoteException {
+        if (mCallback != null && mCallback.mService.isBinderAlive()) {
+            return mCallback.mService == service;
+        }
+        final FrameMasterCallback callback = new FrameMasterCallback(service);
+        service.linkToDeath(callback, 0);
+        final Parcel data = Parcel.obtain(service);
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            data.writeStrongBinder(callback);
+            if (!service.transact(REGISTER_CALLBACK, data, null, IBinder.FLAG_ONEWAY)) return false;
+            // ODM stores callbacks in a fixed table with no unregister transaction.
+            mCallback = callback;
+            return true;
+        } finally {
+            data.recycle();
+            if (mCallback != callback) service.unlinkToDeath(callback, 0);
+        }
+    }
+
+    static boolean matchesFailure(int event, int status, int scene, String command, int expectedScene,
+            boolean enabled, String profile) {
+        return (event == BACKEND_FAILURE || event == COMMAND_REJECTED)
+                && status == (enabled ? 1 : 0) && scene == expectedScene
+                && quoteProfile(profile).equals(command);
+    }
+
+    static boolean matchesNativeDeferral(int event, int status, int scene, String command,
+            boolean enabled, String profile) {
+        return event == COMMAND_DEFERRED && status == (enabled ? 1 : 0) && scene == NATIVE_GAME
+                && quoteProfile(profile).equals(command);
+    }
+
+    private void onCallback(FrameMasterCallback callback, int event, int status, int scene,
+            String command) {
+        if (mCallback != callback || mConnection == null
+                || mConnection.binder() != callback.mService || mActive == null) return;
+        if (event == COMMAND_DEFERRED && mActive.kind() == NATIVE_GAME) {
+            if (mResetPending && matchesNativeDeferral(event, status, scene, command, false, RESET)) {
+                mResetPending = false;
+                mResetSwitching = false;
+                mHandler.removeCallbacks(mFinishReset);
+                scheduleResetRetry();
+            } else if (!mResetRequired && matchesNativeDeferral(event, status, scene, command,
+                    true, mActive.profile())) {
+                // cmdCheck deferred this exact request before the physical-mode or ASIC call.
+                final Scene deferred = mActive;
+                releaseNativeGameMode();
+                mActive = null;
+                deferNativeScene(deferred);
+            }
+            return;
+        }
+        if (event == PHYSICAL_MODE_REQUEST) {
+            // Event 0 has no scene ID. It can confirm only our pre-armed case 3 request.
+            if (mActive.kind() != NATIVE_GAME || !MODE_REQUEST_SOURCE.equals(command)) return;
+            if (status == MODE_HOLD && scene == mActive.refreshRate() && !mResetRequired
+                    && mHeldNativeGameModeId != 0 && isNativeGameModeStillCurrent()
+                    && mHandler.hasCallbacks(mExpireNativeGameModeRequest)) {
+                mHandler.removeCallbacks(mExpireNativeGameModeRequest);
+                Slog.d(TAG, "FrameMaster requested native game physical rate=" + scene);
+            } else if (status == MODE_RELEASE && scene == 0 && mResetRequired) {
+                releaseNativeGameMode();
+            }
+            return;
+        }
+        if (event == MEMC_STATUS || event == LDSR_STATUS) {
+            logNativeGameAcceptance(event, status, scene, command);
+            return;
+        }
+        if (event == SWITCHING && status == 0 && scene == NATIVE_GAME && mActive.kind() == scene
+                && mHeldNativeGameModeId != 0 && !mResetRequired
+                && !mHandler.hasCallbacks(mExpireNativeGameModeRequest)
+                && quoteProfile(mActive.profile()).equals(command)) {
+            if (mActive.vectorGeneration() != 0 && !mEmvSession.arm(mActive.vectorGeneration())) {
+                resetActiveScene();
+                return;
+            }
+            // An unchanged backend MEMC state need not generate another effect edge.
+            mHandler.removeCallbacks(mExpireImageMemcSwitch);
+            mLastDeferredScene = null;
+            // The backend sends any effect-state edge immediately after this matching transition.
+            mNativeGameAcceptanceUntil = SystemClock.uptimeMillis() + SWITCH_DELAY_MS;
+        }
+        if (event == SWITCHING && mResetPending && scene == mActive.kind()
+                && quoteProfile(RESET).equals(command)) {
+            if (status == 1 && !mResetSwitching) {
+                mResetSwitching = true;
+                mHandler.removeCallbacks(mFinishReset);
+                mHandler.postDelayed(mFinishReset, RESET_RETRY_MS);
+            } else if (status == 0 && mResetSwitching) {
+                mResetSwitching = false;
+                mResetTransitionEnded = true;
+                // A backend failure can arrive immediately after the switching-end event.
+                mHandler.removeCallbacks(mFinishReset);
+                mHandler.postDelayed(mFinishReset, SWITCH_DELAY_MS);
+            }
+            return;
+        }
+        if (mResetPending && matchesFailure(event, status, scene, command, mActive.kind(),
+                false, RESET)) {
+            mResetPending = false;
+            mResetSwitching = false;
+            mHandler.removeCallbacks(mFinishReset);
+            logFrameMasterFailure(event, scene, false);
+            scheduleResetRetry();
+        } else if (!mResetRequired && matchesFailure(event, status, scene, command, mActive.kind(),
+                true, mActive.profile())) {
+            logFrameMasterFailure(event, scene, true);
+            rejectActiveScene();
+        }
+    }
+
+    private void logNativeGameAcceptance(int event, int status, int parameter, String source) {
+        if (mActive.kind() != NATIVE_GAME || mHeldNativeGameModeId == 0 || mResetRequired
+                || mNativeGameAcceptanceUntil == 0
+                || SystemClock.uptimeMillis() > mNativeGameAcceptanceUntil || status != 1
+                || !NATIVE_GAME_STATUS_SOURCE.equals(source)) {
+            return;
+        }
+        final boolean memc = event == MEMC_STATUS
+                && parameter == (mActive.vectorGeneration() != 0 ? 1 : 0);
+        final boolean ldsr = event == LDSR_STATUS && parameter == NATIVE_GAME;
+        if (mActive.usesImageMemc() && (ldsr || (event == MEMC_STATUS && parameter == 1))) {
+            Slog.w(TAG, "FrameMaster reported LDSR or external MV during image-based MEMC");
+            rejectActiveScene();
+            return;
+        }
+        final int effect = memc ? 1 : ldsr ? 2 : 0;
+        if ((mActive.nativeGameMode() != 4 && mActive.nativeGameMode() != effect)
+                || effect == 0 || (mAcceptedNativeGameEffects & effect) != 0) return;
+        mAcceptedNativeGameEffects |= effect;
+        Slog.i(TAG, "FrameMaster reported native game " + (memc ? "MEMC" : "LDSR") + " on");
+    }
+
+    private static void logFrameMasterFailure(int event, int scene, boolean enable) {
+        final String failure = event == BACKEND_FAILURE ? "backend failure" : "command rejected";
+        Slog.w(TAG, "FrameMaster " + failure + " event=" + event + " scene=" + scene
+                + " enabled=" + enable);
+    }
+
+    private static String quoteProfile(String profile) {
+        return "\"" + profile + "\"";
+    }
+
+    private boolean send(int kind, boolean enabled, int refreshRate, String profile) {
+        try {
+            final IBinder service = getVerifiedService();
+            if (kind == NATIVE_GAME && enabled && mHeldNativeGameModeId == 0) return false;
+            if (service == null || !ensureCallback(service)) return false;
+            final Parcel data = Parcel.obtain(service);
+            try {
+                data.writeInterfaceToken(DESCRIPTOR);
+                data.writeInt(kind);
+                data.writeInt(enabled ? 1 : 0);
+                data.writeInt(refreshRate);
+                data.writeString(quoteProfile(profile));
+                data.writeString("null");
+                final boolean sent = service.transact(IBinder.FIRST_CALL_TRANSACTION, data, null,
+                        IBinder.FLAG_ONEWAY);
+                if (sent && kind == NATIVE_GAME) mLastNativeGameCommand = SystemClock.uptimeMillis();
+                Slog.i(TAG, "FrameMaster request scene=" + kind + " enabled=" + enabled
+                        + " refreshRateHz=" + refreshRate + " sent=" + sent);
+                return sent;
+            } finally {
+                data.recycle();
+            }
+        } catch (RemoteException | RuntimeException e) {
+            if (mConnection != null && !mConnection.binder().isBinderAlive()) clearConnection();
+            Slog.w(TAG, "Cannot submit the stock display enhancement request", e);
+            return false;
+        }
+    }
+
+    private static boolean matchesStock(IBinder service) throws RemoteException {
+        final Parcel data = Parcel.obtain(service);
+        final Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken(DESCRIPTOR);
+            if (!service.transact(IBinder.LAST_CALL_TRANSACTION, data, reply, 0)) return false;
+            reply.readException();
+            if (reply.readInt() != 1) return false;
+
+            reply.setDataSize(0);
+            reply.setDataPosition(0);
+            if (!service.transact(IBinder.LAST_CALL_TRANSACTION - 1, data, reply, 0)) return false;
+            reply.readException();
+            return HASH.equals(reply.readString());
+        } finally {
+            data.recycle();
+            reply.recycle();
+        }
+    }
+
+    private static void readProfiles(String config, Pattern pattern, Map<String, String> profiles)
+            throws JSONException {
+        final JSONArray entries = new JSONObject(config).getJSONArray("mWhitePackageList");
+        for (int index = 0; index < entries.length(); index++) {
+            final String[] entry = entries.getString(index).split("#", -1);
+            // Stock excludes Youku playback at 120 fps. Infinity has no equivalent FPS callback.
+            if (entry.length == 2 && !entry[0].startsWith("com.youku.phone/")
+                    && pattern.matcher(entry[1]).matches()) {
+                profiles.putIfAbsent(entry[0], entry[1]);
+            }
+        }
+    }
+}
