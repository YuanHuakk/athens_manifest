+    @Test
+    public void requiresEnabledTargetWithItsOwnSignatureReceiverPermission() throws Exception {
+        Context context = mock(Context.class);
+        PackageManager pm = mock(PackageManager.class);
+        ApplicationInfo app = new ApplicationInfo();
+        app.uid = TARGET_UID;
+        app.enabled = true;
+        final String permission = TARGET + ".permission.MIPUSH_RECEIVE";
+        PermissionInfo info = new PermissionInfo();
+        info.packageName = TARGET;
+        info.protectionLevel = PermissionInfo.PROTECTION_SIGNATURE;
+        when(pm.getApplicationInfoAsUser(TARGET, 0, 0)).thenReturn(app);
+        when(pm.getPermissionInfo(permission, 0)).thenReturn(info);
+        when(context.checkPermission(permission, -1, TARGET_UID))
+                .thenReturn(PackageManager.PERMISSION_GRANTED);
+
+        assertThat(MiPushNotificationBridge.getTarget(context, pm, TARGET, 0)).isSameInstanceAs(app);
+        info.packageName = XMSF;
+        assertThat(MiPushNotificationBridge.getTarget(context, pm, TARGET, 0)).isNull();
+        info.packageName = TARGET;
+        app.flags = ApplicationInfo.FLAG_STOPPED;
+        assertThat(MiPushNotificationBridge.getTarget(context, pm, TARGET, 0)).isSameInstanceAs(app);
+    }
