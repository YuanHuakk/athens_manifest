+        }
+
+        mHandler.removeCallbacks(mUpdate);
+        mHandler.removeCallbacks(mEnable);
+        mPendingPackage = null;
+        if (mActivePackage != null && !reset()) {
+            if (mResetRetries++ < MAX_RESET_RETRIES) {
+                mHandler.postDelayed(mUpdate, RESET_RETRY_MS);
+            }
+            return;
+        }
+
+        if (packageName != null) {
+            mPendingPackage = packageName;
+            mHandler.postDelayed(mEnable, TRANSITION_DELAY_MS);
+        }
+    }
+
+    private void enableIfCurrent() {
+        final String packageName = mPendingPackage;
+        mPendingPackage = null;
+        final Display display = mDisplayManager.getDisplay(DEFAULT_DISPLAY);
+        if (packageName == null || mActivePackage != null || display == null
+                || !packageName.equals(getEligiblePackage(display))) {
+            return;
+        }
+        final int refreshRate = getTransitionRefreshRate();
+        final Display.Mode mode = display.getMode();
+        if (mode.isSynthetic() || Math.round(mode.getRefreshRate()) != refreshRate) {
+            return;
+        }
+        final String profile = mProfiles.get(packageName);
+        if (setParameter(true, refreshRate, profile)) {
