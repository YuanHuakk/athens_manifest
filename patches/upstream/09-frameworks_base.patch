diff --git a/services/core/java/com/android/server/notification/MiPushNotificationBridge.java b/services/core/java/com/android/server/notification/MiPushNotificationBridge.java
new file mode 100644
index 0000000000000000000000000000000000000000..d408b62f95644e444c30118f18587c1d465f903a
--- /dev/null
+++ b/services/core/java/com/android/server/notification/MiPushNotificationBridge.java
@@ -0,0 +1,127 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.notification;
+
+import android.annotation.Nullable;
+import android.app.Notification;
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.PermissionInfo;
+import android.graphics.drawable.Icon;
+import android.os.Binder;
+import android.os.UserHandle;
+import android.service.notification.StatusBarNotification;
+
+import com.android.internal.R;
+
+import java.util.HexFormat;
+
+/** Recognizes the notification format used by the stock Xiaomi push broker on AOSP. */
+final class MiPushNotificationBridge {
+    static final String BROKER = "com.xiaomi.xmsf";
+    static final String FEATURE = "org.infinityx.feature.MIPUSH_NOTIFICATION_FORWARDING";
+    // Stock XMSF uses an untagged notification ID. Keep these IDs separate from the app's own.
+    static final String FORWARDED_TAG = "com.android.server.notification.MiPushForwarded";
+
+    private static final byte[] STOCK_CERT = HexFormat.of().parseHex(
+            "c9009d01ebf9f5d0302bc71b2fe9aa9a47a432bba17308a3111b75d7b2149025");
+
+    private MiPushNotificationBridge() {}
+
+    static boolean isBrokerCaller(PackageManager pm, int uid, int userId) {
+        if (!UserHandle.isApp(uid) || UserHandle.getUserId(uid) != userId
+                || !pm.hasSystemFeature(FEATURE)) {
+            return false;
+        }
+        return Binder.withCleanCallingIdentity(() -> {
+            try {
+                ApplicationInfo broker = pm.getApplicationInfoAsUser(BROKER, 0, userId);
+                if (broker.uid != uid || !broker.isSystemApp()) {
+                    return false;
+                }
+                String[] packages = pm.getPackagesForUid(uid);
+                return packages != null && packages.length == 1 && BROKER.equals(packages[0])
+                        && pm.hasSigningCertificate(BROKER, STOCK_CERT,
+                                PackageManager.CERT_INPUT_SHA256);
+            } catch (PackageManager.NameNotFoundException e) {
+                return false;
+            }
+        });
+    }
+
+    @Nullable
+    static String getRequestedTarget(Notification notification) {
+        if (notification.extras == null) {
+            return null;
+        }
+        String target = notification.extras.getString("target_package");
+        if (target == null || target.isEmpty() || BROKER.equals(target)) {
+            return null;
+        }
+        return isChannelForTarget(notification.getChannelId(), target) ? target : null;
+    }
+
+    private static boolean isChannelForTarget(@Nullable String channelId, String target) {
+        String channelPrefix = "mipush_" + target + "_";
+        return channelId != null && channelId.startsWith(channelPrefix)
+                && channelId.length() > channelPrefix.length();
+    }
+
+    /** The target must own and hold the same signature permission XMSF uses for delivery. */
+    @Nullable
+    static ApplicationInfo getTarget(Context context, PackageManager pm, String target, int userId) {
+        return Binder.withCleanCallingIdentity(() -> {
+            try {
+                ApplicationInfo app = pm.getApplicationInfoAsUser(target, 0, userId);
+                if (!UserHandle.isApp(app.uid) || UserHandle.getUserId(app.uid) != userId
+                        || !app.enabled || app.isInstantApp()) {
+                    return null;
+                }
+                String permission = target + ".permission.MIPUSH_RECEIVE";
+                PermissionInfo info = pm.getPermissionInfo(permission, 0);
+                return target.equals(info.packageName)
+                        && info.getProtection() == PermissionInfo.PROTECTION_SIGNATURE
+                        && context.checkPermission(permission, -1, app.uid)
+                                == PackageManager.PERMISSION_GRANTED ? app : null;
+            } catch (PackageManager.NameNotFoundException e) {
+                return null;
+            }
+        });
+    }
+
+    static boolean canPostForTarget(ApplicationInfo target, Notification notification) {
+        // These intents can run without the user opening the notification.
+        return (target.flags & ApplicationInfo.FLAG_STOPPED) == 0
+                || (notification.fullScreenIntent == null
+                        && notification.getBubbleMetadata() == null
+                        && notification.deleteIntent == null);
+    }
+
+    static boolean isForwarded(String pkg, String opPkg, @Nullable String tag) {
+        return FORWARDED_TAG.equals(tag) && BROKER.equals(opPkg) && !BROKER.equals(pkg);
+    }
+
+    /** Keeps the target app's icon on system-generated summaries for delegated pushes. */
+    static Icon getAutoGroupSummaryIcon(StatusBarNotification source, Icon summaryIcon) {
+        String target = source.getPackageName();
+        Notification notification = source.getNotification();
+        if (!BROKER.equals(source.getOpPkg()) || BROKER.equals(target)
+                || !isChannelForTarget(notification.getChannelId(), target)
+                || notification.extras == null
+                || summaryIcon == null || summaryIcon.getType() != Icon.TYPE_RESOURCE
+                || !"android".equals(summaryIcon.getResPackage())
+                || summaryIcon.getResId() != R.drawable.ic_notification_summary_auto) {
+            return summaryIcon;
+        }
+        ApplicationInfo app = notification.extras.getParcelable(
+                Notification.EXTRA_BUILDER_APPLICATION_INFO, ApplicationInfo.class);
+        if (app == null || !target.equals(app.packageName)) {
+            return summaryIcon;
+        }
+        int icon = app.icon != 0 ? app.icon : app.logo;
+        return icon != 0 ? Icon.createWithResource(target, icon) : summaryIcon;
+    }
+}
