+    @Test
+    public void stoppedTargetAllowsUserTapAndRejectsOtherIntentTriggers() {
+        Context context = InstrumentationRegistry.getInstrumentation().getTargetContext();
+        PendingIntent tap = PendingIntent.getActivity(context, 0,
+                new Intent(Intent.ACTION_MAIN).setPackage(context.getPackageName()),
+                PendingIntent.FLAG_IMMUTABLE);
+        ApplicationInfo app = new ApplicationInfo();
+        app.flags = ApplicationInfo.FLAG_STOPPED;
+        Notification notification = new Notification();
+        notification.contentIntent = tap;
+        assertThat(MiPushNotificationBridge.canPostForTarget(app, notification)).isTrue();
+
+        notification.fullScreenIntent = tap;
+        assertThat(MiPushNotificationBridge.canPostForTarget(app, notification)).isFalse();
+        notification.fullScreenIntent = null;
+
+        notification.deleteIntent = tap;
+        assertThat(MiPushNotificationBridge.canPostForTarget(app, notification)).isFalse();
+        notification.deleteIntent = null;
+
+        notification.setBubbleMetadata(new Notification.BubbleMetadata.Builder("mipush-test")
+                .setAutoExpandBubble(true).build());
+        assertThat(MiPushNotificationBridge.canPostForTarget(app, notification)).isFalse();
+
+        app.flags = 0;
+        assertThat(MiPushNotificationBridge.canPostForTarget(app, notification)).isTrue();
+        tap.cancel();
+    }
+
+    private static String requestedTarget(String target, String channelId) {
+        Context context = InstrumentationRegistry.getInstrumentation().getTargetContext();
+        Notification.Builder builder = new Notification.Builder(context, channelId);
+        builder.getExtras().putString("target_package", target);
+        return MiPushNotificationBridge.getRequestedTarget(builder.build());
+    }
