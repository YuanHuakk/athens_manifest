+    static AthensFrameEnhancementController create(Context context, Handler handler,
+            Function<Display, ActivityTaskManager.RootTaskInfo> eligibleTask,
+            BooleanSupplier gameHdrBusy, Runnable reevaluate) {
+        final Map<String, String> cloud = new ArrayMap<>();
+        final Map<String, String> video = new ArrayMap<>();
+        try (FileInputStream stream = new FileInputStream(CONFIG)) {
+            XmlPullParser parser = Xml.newPullParser();
+            parser.setInput(stream, "UTF-8");
+            while (parser.next() != XmlPullParser.END_DOCUMENT) {
+                if (parser.getEventType() != XmlPullParser.START_TAG
+                        || !"cloud-data-item".equals(parser.getName())) {
+                    continue;
+                }
+                final String module = parser.getAttributeValue(null, "moduleName");
+                if ("cloudgame".equals(module)) {
+                    readProfiles(parser.getAttributeValue(null, "moduleString"), CLOUD_PROFILE,
+                            cloud);
+                } else if ("dualdpu".equals(module)) {
+                    readProfiles(parser.getAttributeValue(null, "moduleString"), VIDEO_PROFILE,
+                            video);
+                }
+            }
+        } catch (IOException | XmlPullParserException | JSONException | RuntimeException e) {
+            Slog.w(TAG, "Cannot load stock display enhancement profiles", e);
+            cloud.clear();
+            video.clear();
+        }
+        final AthensFrameEnhancementController controller = new AthensFrameEnhancementController(
+                context, handler, eligibleTask, gameHdrBusy, reevaluate, cloud, video);
+        if (cloud.isEmpty() && video.isEmpty() && !controller.mNativeGameSession.hasProfiles()) {
+            return null;
+        }
+        controller.watchService();
+        return controller;
+    }
+
+    private AthensFrameEnhancementController(Context context, Handler handler,
+            Function<Display, ActivityTaskManager.RootTaskInfo> eligibleTask,
+            BooleanSupplier gameHdrBusy, Runnable reevaluate, Map<String, String> cloud,
+            Map<String, String> video) {
+        mContext = context;
+        mHandler = handler;
+        mDisplayManager = context.getSystemService(DisplayManager.class);
+        mDisplayManagerInternal = LocalServices.getService(DisplayManagerInternal.class);
+        mEligibleTask = eligibleTask;
+        mGameHdrBusy = gameHdrBusy;
+        mReevaluate = reevaluate;
+        mNativeGameSession = new AthensJoyoseGameSession(context, handler, reevaluate);
+        mEmvSession = AthensEmvSession.create(context, handler, reevaluate,
+                mNativeGameSession.getMiVkProfile());
+        mCloudProfiles = cloud;
+        mVideoProfiles = video;
+        if (mNativeGameSession.hasProfiles()) {
+            final ContentObserver refreshRateObserver = new ContentObserver(handler) {
+                @Override
+                public void onChange(boolean selfChange) {
+                    mReevaluate.run();
+                }
+            };
+            context.getContentResolver().registerContentObserver(Settings.System.getUriFor(
+                    Settings.System.MIN_REFRESH_RATE), false, refreshRateObserver,
+                    UserHandle.USER_ALL);
+            context.getContentResolver().registerContentObserver(Settings.System.getUriFor(
+                    Settings.System.PEAK_REFRESH_RATE), false, refreshRateObserver,
+                    UserHandle.USER_ALL);
+        }
+    }
+
+    boolean isBusy() {
+        return mActive != null;
+    }
