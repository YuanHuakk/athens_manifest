+        ApplicationInfo broker = new ApplicationInfo();
+        broker.flags = ApplicationInfo.FLAG_SYSTEM;
+        broker.uid = XMSF_UID;
+        when(pm.hasSystemFeature(MiPushNotificationBridge.FEATURE)).thenReturn(true);
+        when(pm.getApplicationInfoAsUser(XMSF, 0, 0)).thenReturn(broker);
+        when(pm.getPackagesForUid(XMSF_UID)).thenReturn(new String[] {XMSF});
+        when(pm.hasSigningCertificate(eq(XMSF), any(byte[].class),
+                eq(PackageManager.CERT_INPUT_SHA256))).thenReturn(true);
+
+        assertThat(MiPushNotificationBridge.isBrokerCaller(pm, XMSF_UID, 0)).isTrue();
+        assertThat(MiPushNotificationBridge.isBrokerCaller(pm, XMSF_UID, 10)).isFalse();
+        assertThat(MiPushNotificationBridge.isBrokerCaller(pm, TARGET_UID, 0)).isFalse();
+
+        when(pm.getPackagesForUid(XMSF_UID)).thenReturn(new String[] {XMSF, TARGET});
+        assertThat(MiPushNotificationBridge.isBrokerCaller(pm, XMSF_UID, 0)).isFalse();
+        when(pm.getPackagesForUid(XMSF_UID)).thenReturn(new String[] {XMSF});
+        broker.flags = 0;
+        assertThat(MiPushNotificationBridge.isBrokerCaller(pm, XMSF_UID, 0)).isFalse();
+        broker.flags = ApplicationInfo.FLAG_SYSTEM;
+        when(pm.hasSigningCertificate(eq(XMSF), any(byte[].class),
+                eq(PackageManager.CERT_INPUT_SHA256))).thenReturn(false);
+        assertThat(MiPushNotificationBridge.isBrokerCaller(pm, XMSF_UID, 0)).isFalse();
+
+        when(pm.hasSigningCertificate(eq(XMSF), any(byte[].class),
+                eq(PackageManager.CERT_INPUT_SHA256))).thenReturn(true);
+        when(pm.hasSystemFeature(MiPushNotificationBridge.FEATURE)).thenReturn(false);
+        assertThat(MiPushNotificationBridge.isBrokerCaller(pm, XMSF_UID, 0)).isFalse();
