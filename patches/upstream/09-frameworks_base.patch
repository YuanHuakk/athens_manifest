+    private void updateGameHdr() {
+        final String packageName = getEligiblePackage(mDisplayManager.getDisplay(DEFAULT_DISPLAY));
+        if (packageName != null && (packageName.equals(mActivePackage)
+                || packageName.equals(mPendingPackage))) {
